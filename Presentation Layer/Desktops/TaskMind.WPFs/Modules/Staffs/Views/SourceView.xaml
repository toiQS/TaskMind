<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.SourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1400"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <util:InverseBooleanConverter x:Key="InverseBool"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <util:SourceEnvironmentToTextConverter x:Key="EnvText"/>
        <util:IssueSeverityToTextConverter x:Key="SeverityText"/>
        <util:IssueSeverityToBrushConverter x:Key="SeverityBrush"/>
        <util:IssueStatusToTextConverter x:Key="IssueStatusText"/>
        <util:IssueStatusToBrushConverter x:Key="IssueStatusBrush"/>
        <util:IsFolderToIconConverter x:Key="FolderIcon"/>

        <ObjectDataProvider x:Key="IssueSeverityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:IssueSeverity"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Thẻ chọn môi trường (Dev/Test/Production), cùng phong cách ScopeTabButtonStyle ở TodoView -->
        <Style x:Key="EnvTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Dòng node trong cây kiến trúc: nổi bật khi được chọn -->
        <Style x:Key="TreeNodeRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Card báo lỗi mã nguồn -->
        <Style x:Key="IssueCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#282D33"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="500"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="24,24,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Mã nguồn" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                    <Run Text="Xem, chỉnh sửa mã nguồn dự án theo từng môi trường và báo lỗi cần khắc phục"/>
                </TextBlock>
            </StackPanel>

            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary"
                       Command="{Binding RefreshCommand}" ToolTip="Làm mới"/>
        </Grid>

        <!-- ===== Chọn dự án ===== -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Dự án" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox Height="42"
                          ItemsSource="{Binding ProjectOptions}"
                          SelectedItem="{Binding SelectedProject}"
                          DisplayMemberPath="ProjectName"/>
            </StackPanel>
        </Grid>

        <!-- ===== Thẻ môi trường Dev/Test/Production ===== -->
        <Border Grid.Row="2" Background="#20242A" CornerRadius="10" Padding="4"
                HorizontalAlignment="Left" Margin="24,0,24,20"
                Visibility="{Binding HasSelectedProject, Converter={StaticResource B2V}}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Command="{Binding SetEnvironmentCommand}" CommandParameter="{x:Static models:SourceEnvironment.Development}">
                    <ui:Button.Content>
                        <TextBlock Text="{Binding Source={x:Static models:SourceEnvironment.Development}, Converter={StaticResource EnvText}}"/>
                    </ui:Button.Content>
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource EnvTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentEnvironment}" Value="{x:Static models:SourceEnvironment.Development}">
                                    <Setter Property="Background" Value="#4C9AFF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ui:Button Margin="4,0,0,0" Command="{Binding SetEnvironmentCommand}" CommandParameter="{x:Static models:SourceEnvironment.Testing}">
                    <ui:Button.Content>
                        <TextBlock Text="{Binding Source={x:Static models:SourceEnvironment.Testing}, Converter={StaticResource EnvText}}"/>
                    </ui:Button.Content>
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource EnvTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentEnvironment}" Value="{x:Static models:SourceEnvironment.Testing}">
                                    <Setter Property="Background" Value="#4C9AFF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ui:Button Margin="4,0,0,0" Command="{Binding SetEnvironmentCommand}" CommandParameter="{x:Static models:SourceEnvironment.Production}">
                    <ui:Button.Content>
                        <TextBlock Text="{Binding Source={x:Static models:SourceEnvironment.Production}, Converter={StaticResource EnvText}}"/>
                    </ui:Button.Content>
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource EnvTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentEnvironment}" Value="{x:Static models:SourceEnvironment.Production}">
                                    <Setter Property="Background" Value="#4C9AFF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- ===== Nội dung chính ===== -->
        <Grid Grid.Row="3" Margin="24,0,24,24">

            <!-- Trạng thái rỗng: chưa chọn dự án -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasSelectedProject, Converter={StaticResource InverseB2V}}">
                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="46" Foreground="#3A4149" HorizontalAlignment="Center"/>
                <TextBlock Text="Chọn một dự án để xem mã nguồn" Foreground="#8A93A0" FontSize="14" Margin="0,14,0,0"/>
            </StackPanel>

            <Grid Visibility="{Binding HasSelectedProject, Converter={StaticResource B2V}}">

                <!-- ===== Panel: chưa cấu hình nơi lưu mã nguồn cục bộ cho môi trường này ===== -->
                <Border Background="#20242A" CornerRadius="10" Padding="32" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasLocalPath, Converter={StaticResource InverseB2V}}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="34" Foreground="#4C9AFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chưa cấu hình nơi lưu mã nguồn cục bộ" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,6"/>
                        <TextBlock Foreground="#8A93A0" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20">
                            <Run Text="Môi trường "/><Run Text="{Binding CurrentEnvironment, Converter={StaticResource EnvText}}"/>
                            <Run Text=" của dự án này chưa được clone/cấu hình về máy. Vui lòng chọn hoặc nhập thư mục lưu mã nguồn."/>
                        </TextBlock>

                        <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding LocalPathError, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding LocalPathError}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" Icon="{ui:SymbolIcon Folder24}"
                                        PlaceholderText="VD: C:\Sources\erp-noibo\dev"
                                        Text="{Binding LocalPathInput, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>

                            <ui:Button Grid.Column="2" Content="Duyệt..." Appearance="Secondary" Height="42"
                                       Command="{Binding BrowseLocalPathCommand}"/>
                        </Grid>

                        <ui:Button Content="Xác nhận nơi lưu mã nguồn" Icon="{ui:SymbolIcon Checkmark24}"
                                   Appearance="Primary" Height="42" FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Command="{Binding ConfirmLocalPathCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ===== Panel: cây kiến trúc (trái) + mã nguồn (giữa) + báo lỗi (phải) ===== -->
                <Grid Visibility="{Binding HasLocalPath, Converter={StaticResource B2V}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="340" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== Cây kiến trúc dự án (Component tree) ===== -->
                    <Border Grid.Column="0" Background="#20242A" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Cây kiến trúc dự án" Foreground="White" FontSize="14"
                                       FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TreeView Background="Transparent" BorderThickness="0"
                                          ItemsSource="{Binding CurrentFileTree}"
                                          SelectedItemChanged="FileTree_SelectedItemChanged">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type models:SourceFileNode}" ItemsSource="{Binding Children}">
                                            <StackPanel Style="{StaticResource TreeNodeRowStyle}">
                                                <ui:SymbolIcon Symbol="{Binding IsFolder, Converter={StaticResource FolderIcon}}"
                                                               FontSize="15" Foreground="#8A93A0" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#DBDBDB" FontSize="13"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ===== Trình xem/chỉnh sửa mã nguồn ===== -->
                    <Border Grid.Column="2" Background="#20242A" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Thanh công cụ -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="{Binding SelectedFile.FullPath, TargetNullValue='Chưa chọn file'}"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            Visibility="{Binding HasSelectedFile, Converter={StaticResource B2V}}">

                                    <ui:Button Content="Báo lỗi" Icon="{ui:SymbolIcon Bug24}" Appearance="Secondary" Height="34" Margin="0,0,8,0"
                                               Command="{Binding OpenReportIssueCommand}"/>

                                    <ui:Button Content="Chỉnh sửa" Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" Height="34"
                                               Visibility="{Binding IsEditingCode, Converter={StaticResource InverseB2V}}"
                                               Command="{Binding EditCodeCommand}"/>

                                    <ui:Button Content="Huỷ" Appearance="Transparent" Height="34" Margin="0,0,8,0"
                                                Visibility="{Binding IsEditingCode, Converter={StaticResource B2V}}"
                                                Command="{Binding CancelEditCodeCommand}"/>
                                    <ui:Button Content="Lưu" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Height="34"
                                               Visibility="{Binding IsEditingCode, Converter={StaticResource B2V}}"
                                               Command="{Binding SaveCodeCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Nội dung mã nguồn -->
                            <Border Grid.Row="1" Background="#181B20" CornerRadius="8"
                                    Visibility="{Binding HasSelectedFile, Converter={StaticResource B2V}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding CodeContent, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditingCode, Converter={StaticResource InverseBool}}"
                                             FontFamily="Consolas" FontSize="13.5" Foreground="#DBDBDB"
                                             Background="Transparent" BorderThickness="0"
                                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                             Padding="14"/>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasSelectedFile, Converter={StaticResource InverseB2V}}">
                                <ui:SymbolIcon Symbol="Document24" FontSize="38" Foreground="#3A4149" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chọn một file trong cây kiến trúc để xem mã nguồn" Foreground="#8A93A0"
                                           FontSize="13" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== Báo lỗi mã nguồn (issues) ===== -->
                    <Border Grid.Column="4" Background="#20242A" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10">
                                <Run Text="Báo lỗi cần khắc phục ("/><Run Text="{Binding CurrentIssues.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>

                            <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0"
                                        Visibility="{Binding CurrentIssues.Count, Converter={StaticResource ZeroCountVisible}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="32" Foreground="#3A4149" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chưa có báo lỗi nào" Foreground="#8A93A0" FontSize="12.5" Margin="0,10,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CurrentIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SourceIssueModel}">
                                            <Border Style="{StaticResource IssueCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding LocationDisplay}" Foreground="#4C9AFF" FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="8" Padding="7,2" Margin="0,0,8,0"
                                                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                                            <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityText}}"
                                                                       Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border CornerRadius="8" Padding="7,2"
                                                                Background="{Binding Status, Converter={StaticResource IssueStatusBrush}}">
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource IssueStatusText}}"
                                                                       Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Foreground="#5C6370" FontSize="11" Margin="0,8,0,0">
                                                        <Run Text="{Binding CreatedBy}"/><Run Text=" · "/><Run Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Overlay: loading ===== -->
        <Border Grid.RowSpan="4" Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: tạo báo lỗi mã nguồn ===== -->
        <Border Grid.RowSpan="4" Background="#B0181B20"
                Visibility="{Binding IsReportingIssue, Converter={StaticResource B2V}}">
            <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="1" CornerRadius="12"
                    Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="28,24,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Bug24" FontSize="20" Foreground="#4C9AFF" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Báo lỗi mã nguồn" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedFile.FullPath}" Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                   Command="{Binding CancelReportIssueCommand}"/>
                    </Grid>

                    <!-- Form -->
                    <StackPanel Grid.Row="1" Margin="28,0,28,8">

                        <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding IssueError, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding IssueError}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Tiêu đề lỗi *" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:TextBox Icon="{ui:SymbolIcon Bug24}"
                                    PlaceholderText="VD: Chưa xử lý check-in trùng trong ngày"
                                    Text="{Binding IssueTitle, UpdateSourceTrigger=PropertyChanged}"
                                    Height="42" Margin="0,0,0,16"/>

                        <TextBlock Text="Mô tả chi tiết" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                    PlaceholderText="Mô tả nguyên nhân, cách tái hiện lỗi..."
                                    Text="{Binding IssueDescription, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mức độ nghiêm trọng" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Height="42"
                                          ItemsSource="{Binding Source={StaticResource IssueSeverityValues}}"
                                          SelectedItem="{Binding IssueSeverityInput}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SeverityText}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dòng lỗi (không bắt buộc)" Style="{StaticResource FieldLabelStyle}"/>
                                <ui:TextBox PlaceholderText="VD: 8"
                                            Text="{Binding IssueLineNumber, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                            Height="42"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="28,16,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="Huỷ" Appearance="Transparent" Height="42"
                                   Command="{Binding CancelReportIssueCommand}"/>

                        <ui:Button Grid.Column="2" Content="Gửi báo lỗi" Icon="{ui:SymbolIcon Send24}"
                                   Appearance="Primary" Height="42" Width="160" FontWeight="SemiBold"
                                   Command="{Binding SaveIssueCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
