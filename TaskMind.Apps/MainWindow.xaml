<Window x:Class="TaskMind.Apps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskMind.Apps.ViewModels"
        xmlns:local="clr-namespace:TaskMind.Apps.Utilities"
        Title="TaskMind" Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#080D16"
        Foreground="#EAF1FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:MainViewModel+ProjectItem}">
            <Border Background="#111A2A" BorderBrush="#202D43" BorderThickness="1"
                    CornerRadius="12" Padding="18" Margin="0,0,12,12" Width="320">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Status}" Foreground="#4D9FFF"
                                   FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Right" />
                        <TextBlock Text="{Binding SourceType}" Foreground="#8B9CB5" FontSize="11" />
                    </DockPanel>
                    <TextBlock Text="{Binding Title}" Foreground="#EAF1FA" FontSize="17"
                               FontWeight="SemiBold" Margin="0,12,0,7" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" Foreground="#9AAAC2" FontSize="12"
                               TextWrapping="Wrap" MaxHeight="48" />
                    <TextBlock Text="{Binding ActiveMemberCount, StringFormat={}{0} thành viên}"
                               Foreground="#8B9CB5" FontSize="11" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainViewModel+SkillItem}">
            <Border Background="#111A2A" BorderBrush="#202D43" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="0,0,10,10" MinWidth="190">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="#EAF1FA" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Category}" Foreground="#4D9FFF" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0B1220" Padding="64">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" Background="#4D9FFF" CornerRadius="12">
                            <TextBlock Text="T" Foreground="#06111F" FontSize="24"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="TaskMind" FontSize="22" FontWeight="Bold"
                                   Foreground="#EAF1FA" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="Tập trung vào điều&#10;quan trọng." Foreground="#EAF1FA"
                                   FontSize="48" FontWeight="SemiBold" LineHeight="58" />
                        <TextBlock Text="Không gian làm việc để quản lý dự án, phát triển kỹ năng và kết nối đội ngũ."
                                   Foreground="#9AAAC2" FontSize="16" TextWrapping="Wrap"
                                   LineHeight="25" Margin="0,22,30,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                            <Border Background="#12243C" CornerRadius="20" Padding="12,8" Margin="0,0,10,0">
                                <TextBlock Text="DỰ ÁN" Foreground="#4D9FFF" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <Border Background="#12243C" CornerRadius="20" Padding="12,8" Margin="0,0,10,0">
                                <TextBlock Text="KỸ NĂNG" Foreground="#4D9FFF" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <Border Background="#12243C" CornerRadius="20" Padding="12,8">
                                <TextBlock Text="CỘNG ĐỒNG" Foreground="#4D9FFF" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="TASKMIND  /  WORKSPACE" Foreground="#61728B"
                               FontSize="10" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="70,0,70,0" VerticalAlignment="Center" MaxWidth="430">
                <StackPanel>
                    <TextBlock Text="Chào mừng trở lại" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Đăng nhập để tiếp tục tới không gian làm việc của bạn."
                               Foreground="#9AAAC2" FontSize="14" Margin="0,8,0,30" />

                    <StackPanel Visibility="{Binding IsCredentialEntryStep, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="EMAIL" Foreground="#9AAAC2" FontSize="10"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Margin="0,0,0,18" />

                        <TextBlock Text="MẬT KHẨU" Foreground="#9AAAC2" FontSize="10"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <PasswordBox local:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PasswordInput}" Margin="0,0,0,22" />

                        <Button Content="Tiếp tục" Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRoleSelectionStep, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="#10213A" BorderBrush="#1D3D62" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="Thông tin đăng nhập đã được xác nhận"
                                           Foreground="#EAF1FA" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding Email}" Foreground="#9AAAC2"
                                           FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Chọn vai trò bạn muốn sử dụng"
                                   Foreground="#9AAAC2" FontSize="10" FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}"
                                  Style="{StaticResource RoleComboBox}" Margin="0,0,0,20" />
                        <Button Content="Đăng nhập với vai trò này" Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                        <Button Content="←  Quay lại" Command="{Binding BackToLoginCommand}"
                                Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Center" Padding="12" Margin="0,10,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#9AAAC2"
                               TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0B1220" BorderBrush="#1B2A41" BorderThickness="0,0,1,0">
                <DockPanel Margin="18">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="5,8,0,38">
                            <Border Width="36" Height="36" Background="#4D9FFF" CornerRadius="10">
                                <TextBlock Text="T" Foreground="#06111F" FontSize="21"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="TaskMind" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="WORKSPACE" FontSize="9" Foreground="#72829A" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="MENU CHÍNH" Foreground="#61728B" FontSize="10"
                                   FontWeight="SemiBold" Margin="12,0,0,12" />
                        <Button Style="{StaticResource OverviewNavButton}" Command="{Binding NavigateCommand}"
                                CommandParameter="Overview" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" Foreground="#4D9FFF" Width="28" />
                                <TextBlock Text="Tổng quan" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ProjectsNavButton}" Command="{Binding NavigateCommand}"
                                CommandParameter="Projects" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" Foreground="#4D9FFF" Width="28" />
                                <TextBlock Text="Dự án" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SkillsNavButton}" Command="{Binding NavigateCommand}"
                                CommandParameter="Skills" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◇" Foreground="#4D9FFF" Width="28" />
                                <TextBlock Text="Danh mục kỹ năng" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ProfileNavButton}" Command="{Binding NavigateCommand}"
                                CommandParameter="Profile" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◎" Foreground="#4D9FFF" Width="28" />
                                <TextBlock Text="Hồ sơ của tôi" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#111A2A" CornerRadius="12" Padding="12" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" Background="#193756" CornerRadius="16">
                                <TextBlock Text="{Binding DisplayInitial}"
                                           Foreground="#4D9FFF" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Foreground="#EAF1FA"
                                           FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AccountRole}" Foreground="#8B9CB5" FontSize="10" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="↪" Command="{Binding LogoutCommand}"
                                    Style="{StaticResource IconButton}" ToolTip="Đăng xuất" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="34,24,34,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding SectionTitle}" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Không gian làm việc TaskMind" Foreground="#8B9CB5"
                                   FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#111A2A" CornerRadius="8" Padding="12,9" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#4D9FFF" Margin="0,0,8,0" />
                                <TextBlock Text="Đã kết nối" Foreground="#B0BED2" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Button Content="Làm mới" Command="{Binding RefreshCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,9" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#10213A" BorderBrush="#1D3D62" BorderThickness="1"
                                    CornerRadius="16" Padding="28" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="WORKSPACE / TỔNG QUAN" Foreground="#4D9FFF"
                                                   FontSize="10" FontWeight="Bold" />
                                        <TextBlock Text="Chào mừng trở lại,"
                                                   Foreground="#AAB8CC" FontSize="14" Margin="0,10,0,2" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#EAF1FA" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="Theo dõi dự án và khám phá kỹ năng trong hệ sinh thái TaskMind."
                                                   Foreground="#AAB8CC" FontSize="13" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="78" Height="78" Background="#19395D"
                                            CornerRadius="22" VerticalAlignment="Center">
                                        <TextBlock Text="✦" Foreground="#4D9FFF" FontSize="39"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <Border Background="#111A2A" BorderBrush="#202D43" BorderThickness="1"
                                        CornerRadius="12" Padding="20" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="DỰ ÁN CÓ THỂ XEM" Foreground="#8B9CB5" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ProjectCount}" Foreground="#EAF1FA" FontSize="30"
                                                   FontWeight="SemiBold" Margin="0,8,0,2" />
                                        <TextBlock Text="Cập nhật từ API" Foreground="#4D9FFF" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#111A2A" BorderBrush="#202D43" BorderThickness="1"
                                        CornerRadius="12" Padding="20" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="KỸ NĂNG ĐÃ DUYỆT" Foreground="#8B9CB5" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SkillCount}" Foreground="#EAF1FA" FontSize="30"
                                                   FontWeight="SemiBold" Margin="0,8,0,2" />
                                        <TextBlock Text="Danh mục toàn hệ thống" Foreground="#4D9FFF" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#111A2A" BorderBrush="#202D43" BorderThickness="1"
                                        CornerRadius="12" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="TÀI KHOẢN" Foreground="#8B9CB5" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AccountRole}" Foreground="#EAF1FA" FontSize="21"
                                                   FontWeight="SemiBold" Margin="0,12,0,7" />
                                        <TextBlock Text="Đang hoạt động" Foreground="#4D9FFF" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <DockPanel Margin="0,6,0,14">
                                <TextBlock Text="Dự án mới nhất" FontSize="18" FontWeight="SemiBold" />
                                <Button Content="Tất cả dự án  →" Command="{Binding NavigateCommand}"
                                        CommandParameter="Projects" Style="{StaticResource LinkButton}"
                                        DockPanel.Dock="Right" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsProjectsSelected, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Khám phá dự án" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Dự án công ty, cơ sở đào tạo và mã nguồn mở."
                                               Foreground="#8B9CB5" FontSize="12" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBox Width="250" Text="{Binding ProjectSearch, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                             ToolTip="Tìm theo tên hoặc mô tả" />
                                    <Button Content="Tìm" Command="{Binding SearchProjectsCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="15,10" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSkillsSelected, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Danh mục kỹ năng" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Các kỹ năng đã được duyệt trên TaskMind."
                                               Foreground="#8B9CB5" FontSize="12" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBox Width="250" Text="{Binding SkillSearch, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                             ToolTip="Tìm kỹ năng" />
                                    <Button Content="Tìm" Command="{Binding SearchSkillsCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="15,10" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <Border Visibility="{Binding IsProfileSelected, Converter={StaticResource BoolToVisibility}}"
                                Background="#111A2A" BorderBrush="#202D43" BorderThickness="1"
                                CornerRadius="14" Padding="26" MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Hồ sơ tài khoản" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Thông tin cơ bản được đọc trực tiếp từ tài khoản hiện tại."
                                           Foreground="#8B9CB5" FontSize="12" Margin="0,5,0,22" />
                                <TextBlock Text="HỌ VÀ TÊN" Foreground="#8B9CB5" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProfileName}" FontSize="15" Margin="0,5,0,18" />
                                <TextBlock Text="EMAIL" Foreground="#8B9CB5" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProfileEmail}" FontSize="15" Margin="0,5,0,18" />
                                <TextBlock Text="VAI TRÒ" Foreground="#8B9CB5" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AccountRole}" FontSize="15" Margin="0,5,0,18" />
                                <TextBlock Text="GIỚI THIỆU" Foreground="#8B9CB5" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProfileBio, TargetNullValue=Chưa có nội dung giới thiệu}"
                                           Foreground="#AAB8CC" TextWrapping="Wrap" FontSize="14" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <DockPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="TASKMIND  ·  API WORKSPACE" Foreground="#61728B"
                               FontSize="9" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#8B9CB5"
                               FontSize="10" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
