<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.DetailSkillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Admins.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Admins.Models"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:SkillCategoryToTextConverter x:Key="CategoryText"/>
        <util:SkillLevelToTextConverter x:Key="LevelText"/>
        <util:SkillLevelToBrushConverter x:Key="LevelBrush"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="SkillChip" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="LevelDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Fill" Value="{Binding Level, Converter={StaticResource LevelBrush}}"/>
        </Style>

        <Style x:Key="UserRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SourceRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="RevenueProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#3A4149"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#4C9AFF"/>
        </Style>

        <Style x:Key="TimelineDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#4C9AFF"/>
            <Setter Property="Margin" Value="0,4,12,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header: Back + tên kỹ năng + badge + hành động ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowLeft24}"
                               Width="40" Height="40"
                               Margin="0,0,14,0"
                               Command="{Binding BackCommand}"/>

                    <Border Grid.Column="1" Width="52" Height="52" CornerRadius="12"
                            Background="#3A4149" Margin="0,0,14,0">
                        <Ellipse Width="14" Height="14"
                                 Fill="{Binding Detail.Skill.Level, Converter={StaticResource LevelBrush}}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Detail.Skill.Name}" Foreground="White" FontSize="22" FontWeight="Bold"/>

                            <Border Style="{StaticResource StatusBadge}" Margin="12,0,0,0" Background="#3A4149">
                                <TextBlock Text="{Binding Detail.Skill.Category, Converter={StaticResource CategoryText}}"
                                           Foreground="#DBDBDB" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <Border Style="{StaticResource StatusBadge}" Margin="8,0,0,0"
                                    Background="{Binding Detail.Skill.Level, Converter={StaticResource LevelBrush}}">
                                <TextBlock Text="{Binding Detail.Skill.Level, Converter={StaticResource LevelText}}"
                                           Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <Border Style="{StaticResource StatusBadge}" Margin="8,0,0,0" Background="#F5A623"
                                    Visibility="{Binding IsPending, Converter={StaticResource B2V}}">
                                <TextBlock Text="Chờ duyệt" Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0"
                                   Visibility="{Binding IsPending, Converter={StaticResource B2V}}">
                            <Run Text="Đề xuất bởi "/>
                            <Run Text="{Binding Detail.Skill.SuggestedBy, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Hành động cho đề xuất chờ duyệt -->
                    <ui:Button Grid.Column="3" Content="Duyệt" Appearance="Primary" Height="38" Width="100" Margin="0,0,10,0"
                               Visibility="{Binding IsPending, Converter={StaticResource B2V}}"
                               Command="{Binding ApproveCommand}"/>
                    <ui:Button Grid.Column="4" Content="Từ chối" Appearance="Danger" Height="38" Width="100" Margin="0,0,12,0"
                               Visibility="{Binding IsPending, Converter={StaticResource B2V}}"
                               Command="{Binding RejectCommand}"/>

                    <ui:Button Grid.Column="5"
                               Content="Làm mới"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshCommand}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Stat cards ===== -->
                <ItemsControl Grid.Row="1" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>

                        <Border Style="{StaticResource StatCard}" Width="200">
                            <StackPanel>
                                <TextBlock Text="Người dùng sở hữu" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.Skill.UsageCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="200">
                            <StackPanel>
                                <TextBlock Text="Dự án yêu cầu" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.TotalProjectsRequiring}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="200">
                            <StackPanel>
                                <TextBlock Text="Lượt xác nhận (endorsement)" Style="{StaticResource StatLabel}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail.TotalEndorsements}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="200">
                            <StackPanel>
                                <TextBlock Text="Kỹ năng liên quan" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.RelatedSkills.Count}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                    </ItemsControl.Items>
                </ItemsControl>

                <!-- ===== Biểu đồ tăng trưởng + Tỉ trọng nguồn sử dụng ===== -->
                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Tăng trưởng người dùng sở hữu kỹ năng" Style="{StaticResource SectionTitle}"/>
                            <Viewbox Grid.Row="1" Stretch="Fill" Height="120">
                                <Canvas Width="560" Height="140">
                                    <Path Data="{Binding ChartGeometry}"
                                          Stroke="#4C9AFF" StrokeThickness="3"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Tỉ trọng theo nguồn" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Detail.UsageBySource}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SkillUsageBySourceItem}">
                                        <Border Style="{StaticResource SourceRow}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SourceLabel}" Foreground="#DBDBDB" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat='{}{0:0.#}%'}"
                                                               Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource RevenueProgressBar}" Value="{Binding Percentage, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Người dùng tiêu biểu + Kỹ năng liên quan ===== -->
                <Grid Grid.Row="3" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Người dùng tiêu biểu" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Detail.TopUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SkillUserItem}">
                                        <Border Style="{StaticResource UserRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Style="{StaticResource LevelDot}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding UserName}" Foreground="#DBDBDB" FontSize="13"/>
                                                <TextBlock Grid.Column="2" Text="{Binding EndorsementCount, StringFormat='{}{0} xác nhận'}"
                                                           Foreground="#8A93A0" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Kỹ năng liên quan" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Detail.RelatedSkills}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SkillModel}">
                                        <Border Style="{StaticResource SkillChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource LevelDot}"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#DBDBDB" FontSize="13"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Lịch sử duyệt/đề xuất ===== -->
                <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Lịch sử duyệt / đề xuất" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Detail.ApprovalHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AuditLogEntryModel}">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Style="{StaticResource TimelineDot}"/>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Action}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#8A93A0" FontSize="11"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Foreground="#8A93A0" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Overlay loading -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>