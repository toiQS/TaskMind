<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <util:SupportStatusToTextConverter x:Key="StatusText"/>
        <util:SupportStatusToBrushConverter x:Key="StatusBrush"/>
        <util:SupportCategoryToTextConverter x:Key="CategoryText"/>
        <util:SupportCategoryToSymbolConverter x:Key="CategorySymbol"/>
        <util:TodoPriorityToTextConverter x:Key="PriorityText"/>
        <util:TodoPriorityToBrushConverter x:Key="PriorityBrush"/>

        <Style x:Key="StatCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <!-- Card yêu cầu: viền theo màu trạng thái khi đang mở -->
        <Style x:Key="SupportCardStyle" TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SupportStatus.Closed}">
                    <Setter Property="Opacity" Value="0.75"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bong bóng tin nhắn: xanh khi từ nhân sự, tối hơn khi từ Admin -->
        <Style x:Key="MessageBubbleStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="#282D33"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFromStaff}" Value="True">
                    <Setter Property="Background" Value="#1E2A3A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="480"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hỗ trợ" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Yêu cầu hỗ trợ cá nhân gửi đến Admin công ty"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,10,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Secondary"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Làm mới"/>
                        <ui:Button Content="Tạo yêu cầu mới"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding CreateRequestCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Thẻ thống kê nhanh ===== -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Tổng cộng" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding TotalCount, Mode=OneWay}" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Chờ xử lý" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding PendingCount, Mode=OneWay}" Foreground="#FFC14C" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Đang xử lý" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding InProgressCount, Mode=OneWay}" Foreground="#4C9AFF" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Đã giải quyết" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding ResolvedCount, Mode=OneWay}" Foreground="#3FD07A" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                </WrapPanel>

                <!-- ===== Tìm kiếm + bộ lọc trạng thái ===== -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBox Grid.Row="0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm theo tiêu đề yêu cầu..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Width="340" HorizontalAlignment="Left"
                                Height="40" Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                                   Command="{Binding SetStatusFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Chờ xử lý"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:SupportStatus.Pending}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đang xử lý"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:SupportStatus.InProgress}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đã giải quyết"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:SupportStatus.Resolved}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đã đóng"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:SupportStatus.Closed}"/>
                        <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="34"
                                   Command="{Binding ClearFilterCommand}"/>
                    </WrapPanel>
                </Grid>

                <!-- ===== Master-detail: danh sách yêu cầu (trái) + chi tiết trao đổi (phải) ===== -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="320"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- Danh sách yêu cầu -->
                    <Grid Grid.Column="0">
                        <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding FilteredRequests.Count, Converter={StaticResource ZeroCountVisible}}">
                            <ui:SymbolIcon Symbol="ChatHelp24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                            <TextBlock Text="Không có yêu cầu hỗ trợ phù hợp" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SupportRequestModel}">
                                        <ui:Card Style="{StaticResource SupportCardStyle}">
                                            <ui:Card.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenDetailCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </ui:Card.InputBindings>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Category, Converter={StaticResource CategorySymbol}}"
                                                               FontSize="20" Foreground="#4C9AFF" Margin="0,2,12,0" VerticalAlignment="Top"/>

                                                <StackPanel Grid.Column="1">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                                                   FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0"
                                                                Background="{Binding Priority, Converter={StaticResource PriorityBrush}}">
                                                            <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                                                       Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Category, Converter={StaticResource CategoryText}}"
                                                               Foreground="#8A93A0" FontSize="12" Margin="0,0,0,8"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" HorizontalAlignment="Left" CornerRadius="8" Padding="7,2"
                                                                Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                                       Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Comment24" FontSize="12" Foreground="#8A93A0" Margin="0,0,4,0"
                                                                           Visibility="{Binding ReplyCount, Converter={StaticResource CountVisible}}"/>
                                                            <TextBlock Text="{Binding ReplyCount, Mode=OneWay}" Foreground="#8A93A0" FontSize="11.5"
                                                                       Visibility="{Binding ReplyCount, Converter={StaticResource CountVisible}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Chi tiết + luồng trao đổi -->
                    <Border Grid.Column="2" Background="#20242A" CornerRadius="10" Padding="24"
                            Visibility="{Binding HasSelectedRequest, Converter={StaticResource B2V}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedRequest}">

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Height="32" Width="32"
                                               Command="{Binding DataContext.CloseDetailCommand,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                                    <Border CornerRadius="10" Padding="9,4" Margin="0,0,8,0"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border CornerRadius="10" Padding="9,4" Margin="0,0,8,0"
                                            Background="{Binding Priority, Converter={StaticResource PriorityBrush}}">
                                        <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border CornerRadius="10" Padding="9,4" Background="#3A4149">
                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryText}}"
                                                   Foreground="#C7CDD6" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Mô tả" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="14"
                                           TextWrapping="Wrap" Margin="0,0,0,22"/>

                                <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,0,0,10">
                                    <Run Text="Gửi lúc: "/><Run Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy HH:mm'}"/>
                                    <Run Text=" · Admin thụ lý: "/><Run Text="{Binding AdminName, TargetNullValue='Chưa có'}"/>
                                </TextBlock>

                                <ui:Button Content="Đóng yêu cầu" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Success"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                           Height="42" FontWeight="SemiBold" Margin="0,0,0,26"
                                           Visibility="{Binding CanClose, Converter={StaticResource B2V}}"
                                           Command="{Binding DataContext.CloseRequestCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"/>

                                <!-- Luồng trao đổi -->
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12">
                                    <Run Text="Trao đổi ("/><Run Text="{Binding ReplyCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Replies}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SupportReplyModel}">
                                            <Border Style="{StaticResource MessageBubbleStyle}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Author}" Foreground="#4C9AFF"
                                                                   FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CreatedDate, StringFormat='dd/MM HH:mm'}"
                                                                   Foreground="#8A93A0" FontSize="11"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Content}" Foreground="#DBDBDB" FontSize="13"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Chưa có trao đổi nào" Foreground="#8A93A0" FontSize="12.5" Margin="0,0,0,16"
                                           Visibility="{Binding ReplyCount, Converter={StaticResource ZeroCountVisible}}"/>

                                <!-- Ô nhập tin nhắn bổ sung -->
                                <Grid Visibility="{Binding IsOpen, Converter={StaticResource B2V}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0"
                                                PlaceholderText="Bổ sung thông tin cho Admin..."
                                                Text="{Binding DataContext.MessageInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                Height="44"/>

                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                               Height="44" Width="50"
                                               Command="{Binding DataContext.AddMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedRequest, Converter={StaticResource InverseB2V}}">
                        <ui:SymbolIcon Symbol="ChatHelp24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một yêu cầu để xem chi tiết" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: tạo yêu cầu mới ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding IsCreating, Converter={StaticResource B2V}}">
            <local:AddSupportView DataContext="{Binding CreateSupportVM}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>