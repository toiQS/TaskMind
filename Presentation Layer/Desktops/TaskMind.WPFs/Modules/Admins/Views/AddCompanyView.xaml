<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.AddCompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="620"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7CDD6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="EditableField" TargetType="ui:TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

    </UserControl.Resources>

    <Border Background="#2B3036" CornerRadius="12" Padding="26" Width="600">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="24" ShadowDepth="6"/>
        </Border.Effect>

        <StackPanel>

            <!-- Header -->
            <TextBlock Text="Thêm công ty mới" Foreground="White" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Thông tin sẽ được Admin kiểm duyệt trước khi công ty hoạt động chính thức."
                       Foreground="#8A93A0" FontSize="12" Margin="0,4,0,20" TextWrapping="Wrap"/>

            <!-- 2 cột: thông tin cơ bản -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tên công ty *" Style="{StaticResource FieldLabel}"/>
                    <ui:TextBox Style="{StaticResource EditableField}"
                                Icon="{ui:SymbolIcon Building24}"
                                PlaceholderText="VD: FPT Software"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Mã số thuế *" Style="{StaticResource FieldLabel}"/>
                    <ui:TextBox Style="{StaticResource EditableField}"
                                Icon="{ui:SymbolIcon DocumentText24}"
                                PlaceholderText="10-13 chữ số"
                                Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Lĩnh vực hoạt động *" Style="{StaticResource FieldLabel}"/>
                    <ui:TextBox Style="{StaticResource EditableField}"
                                Icon="{ui:SymbolIcon Apps24}"
                                PlaceholderText="VD: Phát triển phần mềm"
                                Text="{Binding Field, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Email *" Style="{StaticResource FieldLabel}"/>
                    <ui:TextBox Style="{StaticResource EditableField}"
                                Icon="{ui:SymbolIcon Mail24}"
                                PlaceholderText="contact@congty.com"
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabel}"/>
                    <ui:TextBox Style="{StaticResource EditableField}"
                                Icon="{ui:SymbolIcon Call24}"
                                PlaceholderText="09xxxxxxxx"
                                Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Gói dịch vụ *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Height="42" Margin="0,0,0,16"
                              ItemsSource="{Binding PackageOptions}"
                              SelectedItem="{Binding Package}"/>
                </StackPanel>
            </Grid>

            <!-- Địa chỉ: full width -->
            <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabel}"/>
            <ui:TextBox Height="42" Margin="0,0,0,8"
                        Icon="{ui:SymbolIcon Location24}"
                        PlaceholderText="Số nhà, đường, quận/huyện, tỉnh/thành..."
                        Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Thông báo lỗi -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#E5484D" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource B2V}}"/>

            <!-- Hành động -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True"
                                 Width="24" Height="24"
                                 HorizontalAlignment="Left"
                                 Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>

                <ui:Button Grid.Column="1" Content="Huỷ" Appearance="Secondary"
                           Height="42" Width="120" Margin="0,0,10,0"
                           Command="{Binding CancelCommand}"/>

                <ui:Button Grid.Column="2" Content="Tạo công ty" Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}"
                           Height="42" Width="160"
                           Command="{Binding SaveCommand}"/>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
