<UserControl x:Class="TaskMind.WPFs.Modules.Auths.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Auths.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    
    <Grid>
        

        <!-- Cột phải: Form đăng nhập -->
        <Grid Grid.Column="1" Margin="60,0">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Đăng nhập" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Chào mừng bạn quay lại!" Foreground="#8A93A0" FontSize="14" Margin="0,4,0,32"/>

                <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="Email" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                <ui:TextBox Icon="{ui:SymbolIcon Mail24}"
                            PlaceholderText="you@example.com"
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            Height="44" Margin="0,0,0,18"/>

                <TextBlock Text="Mật khẩu" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                <ui:PasswordBox Icon="{ui:SymbolIcon LockClosed24}"
                                PlaceholderText="Nhập mật khẩu"
                                Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                Height="44" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Content="Ghi nhớ đăng nhập"
                              Foreground="#C7CDD6"
                              IsChecked="{Binding RememberMe}"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="Quên mật khẩu?"
                               Foreground="#4C9AFF" Cursor="Hand"
                               VerticalAlignment="Center">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.ForgotPasswordCommand,
                                                    RelativeSource={RelativeSource AncestorType=Page}}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </Grid>

                <ui:Button Content="Đăng nhập"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           Height="46"
                           FontSize="15" FontWeight="SemiBold"
                           Command="{Binding LoginCommand}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <TextBlock Text="Chưa có tài khoản? " Foreground="#8A93A0"/>
                    <TextBlock Text="Đăng ký ngay" Foreground="#4C9AFF" Cursor="Hand" FontWeight="SemiBold">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.RegisterCommand,
                                                    RelativeSource={RelativeSource AncestorType=Page}}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Grid>
        <Border Grid.ColumnSpan="2" Background="#902B3036"
        Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>