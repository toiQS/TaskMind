<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>

        <util:TodoStatusToTextConverter x:Key="StatusText"/>
        <util:TodoStatusToBrushConverter x:Key="StatusBrush"/>
        <util:TodoPriorityToTextConverter x:Key="PriorityText"/>
        <util:TodoPriorityToBrushConverter x:Key="PriorityBrush"/>
        <util:OverdueToBrushConverter x:Key="OverdueBrush"/>
        <util:CompletedToTextDecorationConverter x:Key="CompletedStrike"/>
        <util:CompletedToOpacityConverter x:Key="CompletedOpacity"/>
        <util:TodoFilterActiveConverter x:Key="FilterActive"/>
        <util:TodoZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>
        <util:NotCompletedToVisibilityConverter x:Key="NotCompletedVisible"/>

        <ObjectDataProvider x:Key="PriorityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TodoPriority"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="StatCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Card công việc: viền xanh khi đang chọn, mờ + gạch ngang khi đã hoàn thành -->
        <Style x:Key="TodoCardStyle" TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Opacity" Value="{Binding Status, Converter={StaticResource CompletedOpacity}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#4C9AFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Công việc của tôi" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Theo dõi, cập nhật tiến độ và trao đổi quanh các công việc được giao trong dự án"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,10,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Secondary"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Làm mới"/>
                        <ui:Button Content="Thêm công việc"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding OpenCreateCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Thẻ thống kê ===== -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="180">
                        <StackPanel>
                            <TextBlock Text="Tổng công việc" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding TotalCount, Mode=OneWay}" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="180">
                        <StackPanel>
                            <TextBlock Text="Chưa bắt đầu" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding NotStartedCount, Mode=OneWay}" Foreground="#8A93A0" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="180">
                        <StackPanel>
                            <TextBlock Text="Đang thực hiện" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding InProgressCount, Mode=OneWay}" Foreground="#4C9AFF" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="180">
                        <StackPanel>
                            <TextBlock Text="Hoàn thành" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding CompletedCount, Mode=OneWay}" Foreground="#3FD07A" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="180" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Quá hạn" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding OverdueCount, Mode=OneWay}" Foreground="#FF6B6B" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                </WrapPanel>

                <!-- ===== Tìm kiếm + bộ lọc ===== -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBox Grid.Row="0" Width="320" HorizontalAlignment="Left"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm theo tên việc, dự án hoặc người thực hiện..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Height="40" Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả trạng thái"
                                   Command="{Binding SetStatusFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Chưa bắt đầu"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:TodoStatus.NotStarted}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đang thực hiện"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:TodoStatus.InProgress}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Hoàn thành"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:TodoStatus.Completed}"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="2" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả mức ưu tiên"
                                   Command="{Binding SetPriorityFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Thấp"
                                   Command="{Binding SetPriorityFilterCommand}" CommandParameter="{x:Static models:TodoPriority.Low}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Trung bình"
                                   Command="{Binding SetPriorityFilterCommand}" CommandParameter="{x:Static models:TodoPriority.Medium}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Cao"
                                   Command="{Binding SetPriorityFilterCommand}" CommandParameter="{x:Static models:TodoPriority.High}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Khẩn cấp"
                                   Command="{Binding SetPriorityFilterCommand}" CommandParameter="{x:Static models:TodoPriority.Urgent}"/>
                        <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="34"
                                   Command="{Binding ClearFilterCommand}"/>
                    </WrapPanel>
                </Grid>

                <!-- ===== Danh sách công việc ===== -->
                <StackPanel Grid.Row="3">

                    <!-- Trạng thái rỗng -->
                    <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding FilteredTodos.Count, Converter={StaticResource ZeroCountVisible}}">
                        <ui:SymbolIcon Symbol="Board24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                        <TextBlock Text="Không có công việc phù hợp" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding FilteredTodos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TodoItemModel}">
                                <ui:Card Style="{StaticResource TodoCardStyle}">
                                    <ui:Card.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenDetailCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </ui:Card.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Nút hoàn thành nhanh -->
                                        <ui:Button Grid.Column="0" Width="30" Height="30" Margin="0,0,14,0"
                                                   Appearance="Transparent" VerticalAlignment="Top"
                                                   Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                   ToolTip="Đánh dấu hoàn thành"
                                                   Visibility="{Binding Status, Converter={StaticResource NotCompletedVisible}}"
                                                   Command="{Binding DataContext.CompleteCommand,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"/>

                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                                           FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           TextDecorations="{Binding Status, Converter={StaticResource CompletedStrike}}"/>
                                                <Border Grid.Column="1" CornerRadius="10" Padding="8,3" Margin="8,0,0,0"
                                                        Background="{Binding Priority, Converter={StaticResource PriorityBrush}}">
                                                    <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                                               Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Foreground="#8A93A0" FontSize="12.5" Margin="0,0,0,10">
                                                <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                                <Run Text=" · Giao cho "/>
                                                <Run Text="{Binding AssigneeName, Mode=OneWay}" Foreground="#4C9AFF"/>
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="10" Padding="8,3" Margin="0,0,10,0"
                                                        Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                               Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <ui:SymbolIcon Symbol="Clock24" FontSize="13" Margin="0,0,4,0"
                                                               Foreground="{Binding IsOverdue, Converter={StaticResource OverdueBrush}}"/>
                                                <TextBlock Foreground="{Binding IsOverdue, Converter={StaticResource OverdueBrush}}"
                                                           FontSize="12" Margin="0,0,14,0">
                                                    <Run Text="{Binding DueDate, StringFormat='dd/MM/yyyy', TargetNullValue='Không hạn'}"/>
                                                </TextBlock>

                                                <ui:SymbolIcon Symbol="Comment24" FontSize="13" Foreground="#8A93A0" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CommentCount, Mode=OneWay}" Foreground="#8A93A0" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Trạng thái quá hạn -->
                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,4" VerticalAlignment="Top"
                                                Background="#3A2020"
                                                Visibility="{Binding IsOverdue, Converter={StaticResource B2V}}">
                                            <TextBlock Text="Quá hạn" Foreground="#FF8A8A" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: chi tiết công việc ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding HasSelectedTodo, Converter={StaticResource B2V}}">
            <Border Width="460" HorizontalAlignment="Right" Background="#282D33"
                    BorderBrush="#3A4149" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
                    <StackPanel DataContext="{Binding SelectedTodo}">

                        <!-- Header: tiêu đề (tĩnh hoặc chỉnh sửa) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                            <ui:TextBox Grid.Column="0" FontSize="16" Height="40"
                                        Text="{Binding DataContext.EditTitle, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>

                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}"
                                       Appearance="Transparent" VerticalAlignment="Top"
                                       Command="{Binding DataContext.CloseDetailCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                            <Border CornerRadius="10" Padding="9,4" Margin="0,0,8,0"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border CornerRadius="10" Padding="9,4"
                                    Background="{Binding Priority, Converter={StaticResource PriorityBrush}}">
                                <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                           Foreground="White" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <!-- Mô tả -->
                        <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,0,0,22"
                                   Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                        <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="80" Margin="0,0,0,22"
                                    Text="{Binding DataContext.EditDescription, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>

                        <!-- Dự án & người thực hiện -->
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dự án" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding ProjectName}" Foreground="#DBDBDB" FontSize="13.5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Người thực hiện" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding AssigneeName}" Foreground="#4C9AFF" FontSize="13.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hạn chót -->
                        <TextBlock Text="Hạn chót" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22"
                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}">
                            <TextBlock Foreground="{Binding IsOverdue, Converter={StaticResource OverdueBrush}}" FontSize="13.5">
                                <Run Text="{Binding DueDate, StringFormat='dd/MM/yyyy', TargetNullValue='Không có hạn'}"/>
                            </TextBlock>
                            <TextBlock Text=" · Quá hạn" Foreground="#FF6B6B" FontSize="13.5" FontWeight="SemiBold"
                                       Visibility="{Binding IsOverdue, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                        <DatePicker Height="40" Margin="0,0,0,22"
                                    SelectedDate="{Binding DataContext.EditDueDate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>

                        <!-- Mức ưu tiên khi chỉnh sửa -->
                        <StackPanel Margin="0,0,0,22"
                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                            <TextBlock Text="Mức ưu tiên" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Height="40"
                                      ItemsSource="{Binding Source={StaticResource PriorityValues}}"
                                      SelectedItem="{Binding DataContext.EditPriority, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PriorityText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Hành động: chỉnh sửa / trạng thái / xoá -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,26">

                            <!-- Chế độ xem -->
                            <ui:Button Content="Sửa" Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" Height="40" Margin="0,0,8,10"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"
                                       Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                            <ui:Button Content="Bắt đầu" Appearance="Primary" Height="40" Margin="0,0,8,10"
                                       Visibility="{Binding Status, Converter={StaticResource FilterActive}, ConverterParameter=NotStarted}"
                                       Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>
                            <ui:Button Content="Đánh dấu hoàn thành" Appearance="Success" Height="40" Margin="0,0,8,10"
                                       Visibility="{Binding Status, Converter={StaticResource FilterActive}, ConverterParameter=InProgress}"
                                       Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>
                            <ui:Button Content="Mở lại công việc" Appearance="Secondary" Height="40" Margin="0,0,8,10"
                                       Visibility="{Binding Status, Converter={StaticResource FilterActive}, ConverterParameter=Completed}"
                                       Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>
                            <ui:Button Content="Xoá" Appearance="Danger" Height="40" Margin="0,0,0,10"
                                       Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>

                            <!-- Chế độ chỉnh sửa -->
                            <ui:Button Content="Lưu thay đổi" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Height="40" Margin="0,0,8,10"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                       Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <ui:Button Content="Huỷ" Appearance="Secondary" Height="40" Margin="0,0,0,10"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                       Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </WrapPanel>

                        <!-- Nhật ký thay đổi -->
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12">
                            <Run Text="Nhật ký ("/><Run Text="{Binding Logs.Count, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Logs}" Margin="0,0,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TodoLogModel}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#4C9AFF"
                                                 Margin="0,6,10,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Foreground="#DBDBDB" FontSize="12.5" TextWrapping="Wrap">
                                                <Run Text="{Binding ActorName}" FontWeight="SemiBold"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Action}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Time, StringFormat='dd/MM/yyyy HH:mm'}"
                                                       Foreground="#5C6370" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bình luận -->
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12">
                            <Run Text="Bình luận ("/><Run Text="{Binding CommentCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Comments}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TodoCommentModel}">
                                    <Border Background="#20242A" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding AuthorName}" Foreground="#4C9AFF"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SentDate, StringFormat='dd/MM HH:mm'}"
                                                           Foreground="#8A93A0" FontSize="11"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Content}" Foreground="#DBDBDB" FontSize="13"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Ô nhập bình luận -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        PlaceholderText="Nhập bình luận..."
                                        Text="{Binding DataContext.CommentInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                        Height="44"/>

                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                       Height="44" Width="50"
                                       Command="{Binding DataContext.AddCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- ===== Overlay: tạo công việc mới ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding IsCreating, Converter={StaticResource B2V}}">
            <Border Width="440" HorizontalAlignment="Right" Background="#282D33"
                    BorderBrush="#3A4149" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
                    <StackPanel>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Thêm công việc mới" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                       Command="{Binding CancelCreateCommand}"/>
                        </Grid>

                        <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding CreateError, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding CreateError}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Tên công việc" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="VD: Viết API chấm công nhân sự"
                                    Height="42" Margin="0,0,0,16"/>

                        <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True" TextWrapping="Wrap" Height="80" Margin="0,0,0,16"/>

                        <TextBlock Text="Thuộc dự án" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Height="42" Margin="0,0,0,16"
                                  ItemsSource="{Binding ProjectOptions}"
                                  SelectedItem="{Binding NewProjectName}"/>

                        <TextBlock Text="Gán cho thành viên" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Height="42" Margin="0,0,0,16"
                                  ItemsSource="{Binding MemberOptions}"
                                  SelectedItem="{Binding NewAssigneeName}"/>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hạn chót" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker Height="42" SelectedDate="{Binding NewDueDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mức ưu tiên" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Height="42"
                                          ItemsSource="{Binding Source={StaticResource PriorityValues}}"
                                          SelectedItem="{Binding NewPriority}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PriorityText}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <ui:Button Content="Tạo công việc" Appearance="Primary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Height="46" FontSize="15" FontWeight="SemiBold"
                                   Command="{Binding SaveCreateCommand}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
