<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.SourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1500"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <util:SourceEnvironmentToTextConverter x:Key="EnvText"/>
        <util:SourceEnvironmentToBrushConverter x:Key="EnvBrush"/>
        <util:EnvironmentToReleaseLabelConverter x:Key="ReleaseLabel"/>
        <util:SourceNodeToSymbolConverter x:Key="NodeSymbol"/>
        <util:IssueSeverityToTextConverter x:Key="SeverityText"/>
        <util:IssueSeverityToBrushConverter x:Key="SeverityBrush"/>
        <util:IssueStatusToTextConverter x:Key="IssueStatusText"/>
        <util:IssueStatusToBrushConverter x:Key="IssueStatusBrush"/>
        <util:CanReleaseVisibilityConverter x:Key="CanReleaseVisible"/>
        <util:IssueOpenToVisibilityConverter x:Key="IssueOpenVisible"/>
        <util:EnvironmentEqualsConverter x:Key="EnvEquals"/>
        <util:EnvironmentEqualsConverter x:Key="TabEquals"/>

        <util:DiffLineTypeToBackgroundConverter x:Key="DiffBg"/>
        <util:DiffLineTypePrefixConverter x:Key="DiffPrefix"/>
        <util:DiffLineTypeToForegroundConverter x:Key="DiffFg"/>
        <util:DiffChangeKindToTextConverter x:Key="ChangeKindText"/>
        <util:SourceCommitKindToIconConverter x:Key="CommitIcon"/>
        <util:SourceCommitKindToBrushConverter x:Key="CommitBrush"/>
        <util:TimeAgoConverter x:Key="TimeAgo"/>

        <ObjectDataProvider x:Key="IssueSeverityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:CodeIssueSeverity"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Pill tab chọn môi trường Dev/Test/Product -->
        <Style x:Key="EnvTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Pill tab sidebar: Duyệt / Thay đổi / Lịch sử / Lỗi -->
        <Style x:Key="SideTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <!-- Dòng trong cây kiến trúc: tô sáng khi được chọn -->
        <Style x:Key="NodeRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1E2A3A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dòng file đang sửa (tab Thay đổi) -->
        <Style x:Key="ChangedFileRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="#282D33"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Dòng commit trong Lịch sử: tô sáng khi được chọn -->
        <Style x:Key="CommitRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1E2A3A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dòng file trong danh sách "changed files" của khung diff -->
        <Style x:Key="DiffFileRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Card thông báo lỗi: mờ hơn khi đã sửa xong -->
        <Style x:Key="IssueCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#282D33"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CodeIssueStatus.Resolved}">
                    <Setter Property="Opacity" Value="0.65"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="640"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Mã nguồn" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Duyệt cây kiến trúc, chỉnh sửa nhiều file song song, commit theo lô và xem lại lịch sử dạng diff — release Dev → Test → Product"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- ===== Chọn dự án ===== -->
                <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dự án" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Height="42"
                                      ItemsSource="{Binding ProjectOptions}"
                                      SelectedItem="{Binding SelectedProject}"
                                      DisplayMemberPath="ProjectName"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom"
                                    Visibility="{Binding HasSelectedProject, Converter={StaticResource B2V}}">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="10" Padding="9,4" Margin="0,0,10,0" Background="#3A4149">
                                    <TextBlock Foreground="#C7CDD6" FontSize="12">
                                        <Run Text="Vai trò của bạn: "/><Run Text="{Binding SelectedProject.MyRole, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="10" Padding="9,4" Background="#1E3A2A"
                                        Visibility="{Binding SelectedProject.CanRelease, Converter={StaticResource B2V}}">
                                    <TextBlock Text="Có quyền release" Foreground="#3FD07A" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Chọn nơi lưu mã nguồn cục bộ (chỉ hiện nếu chưa clone) ===== -->
                <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}"
                        Visibility="{Binding NeedsLocalPath, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="Chưa có mã nguồn cục bộ" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#8A93A0" FontSize="12.5" Margin="0,0,0,16" TextWrapping="Wrap">
                            <Run Text="Dự án này chưa được clone về máy của bạn. Chọn một thư mục trống để lưu mã nguồn cục bộ trước khi xem/chỉnh sửa."/>
                        </TextBlock>

                        <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" Icon="{ui:SymbolIcon Folder24}"
                                        PlaceholderText="Đường dẫn thư mục lưu mã nguồn..."
                                        Text="{Binding LocalPathInput, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42" IsReadOnly="True"/>

                            <ui:Button Grid.Column="2" Content="Chọn thư mục..." Icon="{ui:SymbolIcon FolderOpen24}"
                                       Appearance="Secondary" Height="42"
                                       Command="{Binding BrowseLocalPathCommand}"/>

                            <ui:Button Grid.Column="4" Content="Xác nhận" Icon="{ui:SymbolIcon Checkmark24}"
                                       Appearance="Primary" Height="42" Width="140" FontWeight="SemiBold"
                                       Command="{Binding ConfirmCloneCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Khu vực làm việc: pill môi trường + sidebar (4 tab) + nội dung chính ===== -->
                <Grid Grid.Row="3" Visibility="{Binding CanShowWorkspace, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Pill tab môi trường -->
                    <Border Grid.Row="0" Background="#20242A" CornerRadius="10" Padding="4"
                            HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon Beaker24}"
                                       Command="{Binding SetEnvironmentCommand}"
                                       CommandParameter="{x:Static models:SourceEnvironment.Dev}">
                                <ui:Button.Content>
                                    <TextBlock>
                                        <Run Text="Development"/>
                                        <Run Text=" ("/><Run Text="{Binding DevWorkspace.OpenIssueCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </ui:Button.Content>
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource EnvTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentEnvironment}" Value="{x:Static models:SourceEnvironment.Dev}">
                                                <Setter Property="Background" Value="#4C9AFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button Icon="{ui:SymbolIcon Bug24}"
                                       Command="{Binding SetEnvironmentCommand}"
                                       CommandParameter="{x:Static models:SourceEnvironment.Test}">
                                <ui:Button.Content>
                                    <TextBlock>
                                        <Run Text="Testing"/>
                                        <Run Text=" ("/><Run Text="{Binding TestWorkspace.OpenIssueCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </ui:Button.Content>
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource EnvTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentEnvironment}" Value="{x:Static models:SourceEnvironment.Test}">
                                                <Setter Property="Background" Value="#FFC14C"/>
                                                <Setter Property="Foreground" Value="#20242A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button Icon="{ui:SymbolIcon Rocket24}"
                                       Command="{Binding SetEnvironmentCommand}"
                                       CommandParameter="{x:Static models:SourceEnvironment.Product}">
                                <ui:Button.Content>
                                    <TextBlock>
                                        <Run Text="Production"/>
                                        <Run Text=" ("/><Run Text="{Binding ProductWorkspace.OpenIssueCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </ui:Button.Content>
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource EnvTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentEnvironment}" Value="{x:Static models:SourceEnvironment.Product}">
                                                <Setter Property="Background" Value="#3FD07A"/>
                                                <Setter Property="Foreground" Value="#20242A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Toolbar môi trường hiện tại -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border CornerRadius="10" Padding="9,4" Margin="0,0,10,0"
                                    Background="{Binding CurrentEnvironment, Converter={StaticResource EnvBrush}}">
                                <TextBlock Text="{Binding CurrentEnvironment, Converter={StaticResource EnvText}}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Foreground="#8A93A0" FontSize="12" VerticalAlignment="Center"
                                       Visibility="{Binding CurrentWorkspace.LatestRelease, Converter={StaticResource B2V}}">
                                <Run Text="Release gần nhất: "/>
                                <Run Text="{Binding CurrentWorkspace.LatestRelease.ReleasedDate, StringFormat='dd/MM/yyyy HH:mm'}"/>
                                <Run Text=" bởi "/>
                                <Run Text="{Binding CurrentWorkspace.LatestRelease.ReleasedBy}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Thêm thông báo lỗi" Icon="{ui:SymbolIcon ErrorCircle24}"
                                       Appearance="Secondary" Height="38" Margin="0,0,10,0"
                                       Command="{Binding OpenAddIssueCommand}"/>

                            <ui:Button Content="{Binding CurrentEnvironment, Converter={StaticResource ReleaseLabel}}"
                                       Icon="{ui:SymbolIcon ArrowUpload24}"
                                       Appearance="Primary" Height="38" FontWeight="SemiBold"
                                       Command="{Binding ReleaseCommand}">
                                <ui:Button.Visibility>
                                    <MultiBinding Converter="{StaticResource CanReleaseVisible}">
                                        <Binding Path="SelectedProject.CanRelease"/>
                                        <Binding Path="CurrentEnvironment"/>
                                    </MultiBinding>
                                </ui:Button.Visibility>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Sidebar (4 tab, kiểu GitHub Desktop) | Nội dung chính ===== -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" MinWidth="320"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*" MinWidth="420"/>
                        </Grid.ColumnDefinitions>

                        <!-- ===== Cột trái: Sidebar 4 tab ===== -->
                        <Border Grid.Column="0" Background="#20242A" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Pill tab sidebar -->
                                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="Duyệt"
                                               Command="{Binding SetLeftTabCommand}" CommandParameter="{x:Static models:SourceLeftTab.Browse}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource SideTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentLeftTab}" Value="{x:Static models:SourceLeftTab.Browse}">
                                                        <Setter Property="Background" Value="#4C9AFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Icon="{ui:SymbolIcon DocumentEdit24}"
                                               Command="{Binding SetLeftTabCommand}" CommandParameter="{x:Static models:SourceLeftTab.Changes}">
                                        <ui:Button.Content>
                                            <TextBlock>
                                                <Run Text="Thay đổi"/>
                                                <Run Text=" ("/><Run Text="{Binding CurrentWorkspace.DirtyFiles.Count, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </ui:Button.Content>
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource SideTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentLeftTab}" Value="{x:Static models:SourceLeftTab.Changes}">
                                                        <Setter Property="Background" Value="#4C9AFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <ui:Button.ToolTip>
                                            <TextBlock>
                                                <Run Text="Số file đang sửa: "/><Run Text="{Binding CurrentWorkspace.DirtyFiles.Count, Mode=OneWay}"/>
                                            </TextBlock>
                                        </ui:Button.ToolTip>
                                    </ui:Button>

                                    <ui:Button Icon="{ui:SymbolIcon History24}"
                                               Command="{Binding SetLeftTabCommand}" CommandParameter="{x:Static models:SourceLeftTab.History}">
                                        <ui:Button.Content>
                                            <TextBlock>
                                                <Run Text="Lịch sử"/>
                                                <Run Text=" ("/><Run Text="{Binding CurrentWorkspace.Commits.Count, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </ui:Button.Content>
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource SideTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentLeftTab}" Value="{x:Static models:SourceLeftTab.History}">
                                                        <Setter Property="Background" Value="#4C9AFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Icon="{ui:SymbolIcon ErrorCircle24}"
                                               Command="{Binding SetLeftTabCommand}" CommandParameter="{x:Static models:SourceLeftTab.Issues}">
                                        <ui:Button.Content>
                                            <TextBlock>
                                                <Run Text="Lỗi"/>
                                                <Run Text=" ("/><Run Text="{Binding CurrentWorkspace.OpenIssueCount, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </ui:Button.Content>
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource SideTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentLeftTab}" Value="{x:Static models:SourceLeftTab.Issues}">
                                                        <Setter Property="Background" Value="#4C9AFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </WrapPanel>

                                <!-- ===== Nội dung tab "Duyệt": cây kiến trúc ===== -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding CurrentLeftTab, Converter={StaticResource TabEquals}, ConverterParameter=Browse}">
                                    <TreeView ItemsSource="{Binding CurrentWorkspace.RootNodes}"
                                              Background="Transparent" BorderThickness="0">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="0,1"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.Resources>
                                            <HierarchicalDataTemplate DataType="{x:Type models:SourceNodeModel}"
                                                                      ItemsSource="{Binding Children}">
                                                <Border Style="{StaticResource NodeRowStyle}">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectNodeCommand,
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Converter={StaticResource NodeSymbol}}"
                                                                       FontSize="15" Margin="0,0,6,0">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Foreground" Value="#8A93A0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFC14C"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#DBDBDB" FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Width="7" Height="7" CornerRadius="4" Background="#FFC14C"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsDirty, Converter={StaticResource B2V}}"
                                                                ToolTip="File đang có thay đổi chưa commit"/>
                                                    </Grid>
                                                </Border>
                                            </HierarchicalDataTemplate>
                                        </TreeView.Resources>
                                    </TreeView>
                                </ScrollViewer>

                                <!-- ===== Nội dung tab "Thay đổi" ===== -->
                                <Grid Grid.Row="1"
                                      Visibility="{Binding CurrentLeftTab, Converter={StaticResource TabEquals}, ConverterParameter=Changes}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Không có thay đổi nào chưa commit" Foreground="#8A93A0" FontSize="12.5"
                                                       TextWrapping="Wrap" Margin="0,20,0,0"
                                                       Visibility="{Binding CurrentWorkspace.DirtyFiles.Count, Converter={StaticResource ZeroCountVisible}}"/>

                                            <ItemsControl ItemsSource="{Binding CurrentWorkspace.DirtyFiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:SourceNodeModel}">
                                                        <Border Style="{StaticResource ChangedFileRowStyle}">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SelectNodeCommand,
                                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Converter={StaticResource NodeSymbol}}"
                                                                               FontSize="14" Foreground="#FFC14C" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding RelativePath}" Foreground="#DBDBDB"
                                                                           FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Transparent"
                                                                           Height="24" Width="24" ToolTip="Huỷ thay đổi file này"
                                                                           Command="{Binding DataContext.DiscardDraftCommand,
                                                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Form commit -->
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <Border Background="#3A2020" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                                                Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="12" TextWrapping="Wrap"/>
                                        </Border>

                                        <ui:TextBox PlaceholderText="Tóm tắt thay đổi (VD: Sửa lỗi hiển thị Skills)..."
                                                    Text="{Binding CommitMessageInput, UpdateSourceTrigger=PropertyChanged}"
                                                    Height="40" Margin="0,0,0,8"/>
                                        <ui:TextBox PlaceholderText="Mô tả chi tiết (không bắt buộc)..."
                                                    AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                                    Text="{Binding CommitDescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                                    Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="Commit thay đổi" Icon="{ui:SymbolIcon Checkmark24}"
                                                       Appearance="Primary" Height="40" FontWeight="SemiBold"
                                                       Command="{Binding CommitChangesCommand}"/>
                                            <ui:Button Grid.Column="2" Content="Huỷ tất cả" Appearance="Transparent" Height="40"
                                                       Command="{Binding DiscardAllCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- ===== Nội dung tab "Lịch sử" ===== -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding CurrentLeftTab, Converter={StaticResource TabEquals}, ConverterParameter=History}">
                                    <StackPanel>
                                        <TextBlock Text="Chưa có commit nào" Foreground="#8A93A0" FontSize="12.5" Margin="0,20,0,0"
                                                   Visibility="{Binding CurrentWorkspace.Commits.Count, Converter={StaticResource ZeroCountVisible}}"/>

                                        <ItemsControl ItemsSource="{Binding CurrentWorkspace.Commits}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:SourceCommitModel}">
                                                    <Border Style="{StaticResource CommitRowStyle}">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.SelectCommitCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                                    Background="{Binding Kind, Converter={StaticResource CommitBrush}}"
                                                                    Margin="0,2,10,0" VerticalAlignment="Top">
                                                                <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource CommitIcon}}"
                                                                               FontSize="13" Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Message}" Foreground="White" FontSize="13"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Foreground="#8A93A0" FontSize="11" Margin="0,4,0,0">
                                                                    <Run Text="{Binding AuthorName, Mode=OneWay}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding CommittedDate, Converter={StaticResource TimeAgo}}"/>
                                                                </TextBlock>
                                                                <TextBlock FontSize="10.5" FontFamily="Consolas" Margin="0,4,0,0"
                                                                           Visibility="{Binding HasChangedFiles, Converter={StaticResource B2V}}">
                                                                    <Run Text="{Binding TotalAdded, Mode=OneWay, StringFormat='+{0}'}" Foreground="#3FD07A"/>
                                                                    <Run Text=" "/>
                                                                    <Run Text="{Binding TotalRemoved, Mode=OneWay, StringFormat='-{0}'}" Foreground="#FF6B6B"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ===== Nội dung tab "Lỗi" ===== -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding CurrentLeftTab, Converter={StaticResource TabEquals}, ConverterParameter=Issues}">
                                    <StackPanel>
                                        <TextBlock Text="Chưa có thông báo lỗi nào ở môi trường này" Foreground="#8A93A0"
                                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,20,0,0"
                                                   Visibility="{Binding CurrentWorkspace.Issues.Count, Converter={StaticResource ZeroCountVisible}}"/>

                                        <ItemsControl ItemsSource="{Binding CurrentWorkspace.Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:CodeIssueModel}">
                                                    <Border Style="{StaticResource IssueCardStyle}">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <Border Grid.Column="1" CornerRadius="7" Padding="6,2" Margin="8,0,0,0"
                                                                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityText}}"
                                                                               Foreground="White" FontSize="9.5" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Text="{Binding Description}" Foreground="#8A93A0" FontSize="11.5"
                                                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                                                       Visibility="{Binding Description, Converter={StaticResource B2V}}"/>

                                                            <TextBlock Text="{Binding LocationDisplay}" Foreground="#4C9AFF" FontSize="11"
                                                                       Margin="0,0,0,8"/>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" HorizontalAlignment="Left" CornerRadius="7" Padding="6,2"
                                                                        Background="{Binding Status, Converter={StaticResource IssueStatusBrush}}">
                                                                    <TextBlock Text="{Binding Status, Converter={StaticResource IssueStatusText}}"
                                                                               Foreground="White" FontSize="9.5" FontWeight="SemiBold"/>
                                                                </Border>

                                                                <ui:Button Grid.Column="1" Content="Đánh dấu đã sửa" Appearance="Transparent"
                                                                           Height="24" FontSize="10.5"
                                                                           Visibility="{Binding Status, Converter={StaticResource IssueOpenVisible}}"
                                                                           Command="{Binding DataContext.ResolveIssueCommand,
                                                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ===== Cột phải: Nội dung chính — editor HOẶC diff detail ===== -->
                        <Border Grid.Column="2" Background="#20242A" CornerRadius="10" Padding="18">
                            <Grid>

                                <!-- ===== Chế độ: xem chi tiết commit (diff, kiểu GitHub Desktop) =====
                                     LƯU Ý: Visibility và DataContext KHÔNG được đặt trên cùng 1 Grid — khi cùng
                                     1 phần tử vừa đổi DataContext (sang SelectedCommit) vừa tự bind Visibility bằng
                                     implicit source, WPF sẽ resolve Visibility theo DataContext MỚI (SelectedCommit)
                                     thay vì DataContext của trang, gây lỗi "CurrentWorkspace property not found on
                                     object of type SourceCommitModel". Tách thành Grid ngoài (chỉ giữ Visibility,
                                     dùng DataContext kế thừa từ trang) bọc Grid trong (mới đổi DataContext). -->
                                <Grid Visibility="{Binding CurrentWorkspace.HasSelectedCommit, Converter={StaticResource B2V}}">
                                <Grid DataContext="{Binding CurrentWorkspace.SelectedCommit}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: message + nút đóng/revert -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Message}" Foreground="White" FontSize="18"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Description}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,4,0,0" FontStyle="Italic"
                                                       Visibility="{Binding IsRevert, Converter={StaticResource B2V}}">
                                                <Run Text="This reverts commit "/><Run Text="{Binding RevertedCommitId}" FontFamily="Consolas"/><Run Text="."/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}" Content="Revert" Appearance="Secondary" Height="32"
                                                       Margin="0,0,6,0" FontSize="12"
                                                       Visibility="{Binding HasChangedFiles, Converter={StaticResource B2V}}"
                                                       Command="{Binding DataContext.RevertCommitCommand,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Height="32" Width="32"
                                                       Command="{Binding DataContext.CloseCommitDetailCommand,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Author + hash + stats -->
                                    <Grid Grid.Row="1" Margin="0,12,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#3E434A" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding AuthorInitial}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AuthorName}" Foreground="#C7CDD6" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                            <Border CornerRadius="6" Padding="6,1" Background="#282D33" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Id}" Foreground="#4C9AFF" FontFamily="Consolas" FontSize="11.5"/>
                                            </Border>
                                            <TextBlock FontSize="12" FontFamily="Consolas"
                                                       Visibility="{Binding HasChangedFiles, Converter={StaticResource B2V}}">
                                                <Run Text="{Binding TotalAdded, Mode=OneWay, StringFormat='+{0}'}" Foreground="#3FD07A"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding TotalRemoved, Mode=OneWay, StringFormat='-{0}'}" Foreground="#FF6B6B"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2" Height="1" Background="#3A4149" Margin="0,10,0,10"/>

                                    <!-- Trạng thái không có file thay đổi (commit Release) -->
                                    <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding HasChangedFiles, Converter={StaticResource InverseB2V}}">
                                        <ui:SymbolIcon Symbol="Rocket24" FontSize="38" Foreground="#3A4149" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Đây là mốc release, không có thay đổi mã nguồn kèm theo" Foreground="#8A93A0"
                                                   FontSize="13" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <!-- Danh sách file đổi (trái) + nội dung diff (phải) -->
                                    <Grid Grid.Row="3" Visibility="{Binding HasChangedFiles, Converter={StaticResource B2V}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" MinWidth="180"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*" MinWidth="320"/>
                                        </Grid.ColumnDefinitions>

                                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ChangedFiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:DiffFileModel}">
                                                        <Border Style="{StaticResource DiffFileRowStyle}">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SelectDiffFileCommand,
                                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding FileName}" Foreground="#DBDBDB" FontSize="12.5"
                                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock FontSize="10.5" FontFamily="Consolas" Margin="0,3,0,0">
                                                                    <Run Text="{Binding AddedCount, Mode=OneWay, StringFormat='+{0}'}" Foreground="#3FD07A"/>
                                                                    <Run Text=" "/>
                                                                    <Run Text="{Binding RemovedCount, Mode=OneWay, StringFormat='-{0}'}" Foreground="#FF6B6B"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Border Grid.Column="2" Background="#181B20" CornerRadius="8"
                                                DataContext="{Binding SelectedFile}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="{Binding RelativePath}" Foreground="White"
                                                           FontFamily="Consolas" FontSize="12.5" Padding="14,10"/>

                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:DiffLineModel}">
                                                                <Border Background="{Binding Type, Converter={StaticResource DiffBg}}"
                                                                        Padding="12,1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="36"/>
                                                                            <ColumnDefinition Width="36"/>
                                                                            <ColumnDefinition Width="16"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0" Text="{Binding OldLineNumber}" Foreground="#5C6370"
                                                                                   FontFamily="Consolas" FontSize="11.5" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding NewLineNumber}" Foreground="#5C6370"
                                                                                   FontFamily="Consolas" FontSize="11.5" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Type, Converter={StaticResource DiffPrefix}}"
                                                                                   Foreground="{Binding Type, Converter={StaticResource DiffFg}}"
                                                                                   FontFamily="Consolas" FontSize="12.5" FontWeight="Bold"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding Content}"
                                                                                   Foreground="{Binding Type, Converter={StaticResource DiffFg}}"
                                                                                   FontFamily="Consolas" FontSize="12.5" TextWrapping="NoWrap"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                                </Grid>

                                <!-- ===== Chế độ: sửa file (khi không xem commit) ===== -->
                                <Grid Visibility="{Binding CurrentWorkspace.HasSelectedCommit, Converter={StaticResource InverseB2V}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Toolbar file -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14"
                                          Visibility="{Binding CurrentWorkspace.HasSelectedFile, Converter={StaticResource B2V}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding CurrentWorkspace.SelectedFile, Converter={StaticResource NodeSymbol}}"
                                                           FontSize="16" Foreground="#4C9AFF" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding CurrentWorkspace.SelectedFile.RelativePath}"
                                                       Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border CornerRadius="8" Padding="7,2" Margin="10,0,0,0" Background="#3A2020"
                                                    Visibility="{Binding CurrentWorkspace.SelectedFile.IsDirty, Converter={StaticResource B2V}}">
                                                <TextBlock Text="Chưa commit" Foreground="#FF8A8A" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <ui:Button Grid.Column="1" Content="Huỷ thay đổi file này" Appearance="Transparent" Height="34"
                                                   Visibility="{Binding CurrentWorkspace.SelectedFile.IsDirty, Converter={StaticResource B2V}}"
                                                   Command="{Binding DiscardDraftCommand}"
                                                   CommandParameter="{Binding CurrentWorkspace.SelectedFile}"/>
                                    </Grid>

                                    <!-- Nội dung mã nguồn (mỗi file giữ bản nháp riêng qua DraftContent) -->
                                    <Border Grid.Row="1" Background="#181B20" CornerRadius="8"
                                            Visibility="{Binding CurrentWorkspace.HasSelectedFile, Converter={StaticResource B2V}}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding CurrentWorkspace.SelectedFile.DraftContent, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0" Foreground="#DBDBDB"
                                                     FontFamily="Consolas" FontSize="13.5" Padding="14"
                                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"/>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Trạng thái rỗng: chưa chọn file -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding CurrentWorkspace.HasSelectedFile, Converter={StaticResource InverseB2V}}">
                                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Chọn một file trong tab Duyệt để xem/chỉnh sửa, hoặc xem tab Lịch sử để duyệt lại các commit trước đó"
                                                   Foreground="#8A93A0" FontSize="13.5" Margin="0,12,0,0" TextWrapping="Wrap"
                                                   TextAlignment="Center" MaxWidth="360"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: thêm thông báo lỗi ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding IsAddingIssue, Converter={StaticResource B2V}}">
            <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="1" CornerRadius="12"
                    Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,22,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="20" Foreground="#FF6B6B" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Thêm thông báo lỗi" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Foreground="#8A93A0" FontSize="11.5" Margin="0,2,0,0">
                                    <Run Text="Gắn vào file: "/>
                                    <Run Text="{Binding CurrentWorkspace.SelectedFile.Name, TargetNullValue='(chưa chọn file)'}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                   Command="{Binding CancelAddIssueCommand}"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="24,0,24,4">
                        <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Tiêu đề *" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:TextBox Icon="{ui:SymbolIcon TextBulletListSquare24}"
                                    PlaceholderText="VD: NullReferenceException khi tải hồ sơ"
                                    Text="{Binding IssueTitleInput, UpdateSourceTrigger=PropertyChanged}"
                                    Height="42" Margin="0,0,0,16"/>

                        <TextBlock Text="Mô tả chi tiết" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                    PlaceholderText="Mô tả lỗi, bước tái hiện, vị trí trong mã nguồn cần sửa..."
                                    Text="{Binding IssueDescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,16"/>

                        <TextBlock Text="Mức độ" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Height="42"
                                  ItemsSource="{Binding Source={StaticResource IssueSeverityValues}}"
                                  SelectedItem="{Binding IssueSeverityInput}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SeverityText}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="24,20,24,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="Huỷ" Appearance="Transparent" Height="42"
                                   Command="{Binding CancelAddIssueCommand}"/>

                        <ui:Button Grid.Column="2" Content="Thêm thông báo" Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary" Height="42" Width="170" FontWeight="SemiBold"
                                   Command="{Binding AddIssueCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>