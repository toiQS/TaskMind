<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.DashbroadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Width" Value="196"/>
        </Style>

        <Style x:Key="StatAccentDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#4C9AFF"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="StatDelta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3FD07A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Thẻ Todo: có thanh màu ưu tiên bên trái -->
        <Style x:Key="PriorityBar" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#3FD07A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PriorityLevel}" Value="1">
                    <Setter Property="Background" Value="#E5484D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PriorityLevel}" Value="2">
                    <Setter Property="Background" Value="#F5A623"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PriorityLevel}" Value="3">
                    <Setter Property="Background" Value="#3FD07A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TodoItemCard" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="360"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dashboard" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Tổng quan hệ thống" Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Content="Làm mới"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource B2V}, ConverterParameter=Invert}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Stat cards -->
                <ItemsControl Grid.Row="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}"/>
                                    <TextBlock Text="Người dùng" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Statistic.CountAllUsers}" Style="{StaticResource StatValue}"/>
                                <TextBlock Style="{StaticResource StatDelta}">
                                    <Run Text="+"/><Run Text="{Binding Statistic.CountNewUsers, Mode=OneWay}"/><Run Text=" mới"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}" Fill="#3FD07A"/>
                                    <TextBlock Text="Dự án" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Statistic.CountAllProject}" Style="{StaticResource StatValue}"/>
                                <TextBlock Style="{StaticResource StatDelta}">
                                    <Run Text="+"/><Run Text="{Binding Statistic.CountNewProjects, Mode=OneWay}"/><Run Text=" mới"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}" Fill="#F5A623"/>
                                    <TextBlock Text="Công ty" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Statistic.CountAllCompanies}" Style="{StaticResource StatValue}"/>
                                <TextBlock Style="{StaticResource StatDelta}">
                                    <Run Text="+"/><Run Text="{Binding Statistic.CountNewCompanies, Mode=OneWay}"/><Run Text=" mới"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}" Fill="#B892FF"/>
                                    <TextBlock Text="Cơ sở đào tạo" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Statistic.CountAllSchools}" Style="{StaticResource StatValue}"/>
                                <TextBlock Style="{StaticResource StatDelta}">
                                    <Run Text="+"/><Run Text="{Binding Statistic.CountNewSchools, Mode=OneWay}"/><Run Text=" mới"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}" Fill="#4CC9F0"/>
                                    <TextBlock Text="Giảng viên" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Statistic.CountAllTeachers}" Style="{StaticResource StatValue}"/>
                                <TextBlock Style="{StaticResource StatDelta}">
                                    <Run Text="+"/><Run Text="{Binding Statistic.CountNewTeacher, Mode=OneWay}"/><Run Text=" mới"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}" Fill="#E5484D"/>
                                    <TextBlock Text="Nhân viên" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Statistic.CountAllStaff}" Style="{StaticResource StatValue}"/>
                                <TextBlock Style="{StaticResource StatDelta}">
                                    <Run Text="+"/><Run Text="{Binding Statistic.CountNewStaff, Mode=OneWay}"/><Run Text=" mới"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </ItemsControl.Items>
                </ItemsControl>

                <!-- Chart + Todo -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Line chart tự vẽ (không cần thư viện ngoài) -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Tăng trưởng theo tháng" Style="{StaticResource SectionTitle}"/>

                            <Viewbox Grid.Row="1" Stretch="Fill">
                                <Canvas Width="600" Height="160">
                                    <Path Data="{Binding ChartGeometry}"
                                          Stroke="#4C9AFF"
                                          StrokeThickness="3"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding RevenueChart}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="#8A93A0"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Todo list -->
                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Việc cần xử lý" Style="{StaticResource SectionTitle}"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TodoList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TodoItemCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Style="{StaticResource PriorityBar}"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="#DBDBDB"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Foreground="#8A93A0" FontSize="11" Margin="0,4,0,0">
                                                            <Run Text="Ưu tiên: "/><Run Text="{Binding PriorityLevel}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Overlay loading khi refresh -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>