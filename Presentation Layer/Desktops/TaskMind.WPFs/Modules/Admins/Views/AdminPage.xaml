<Page x:Class="TaskMind.WPFs.Modules.Admins.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
      xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Admins.Utilities"
      mc:Ignorable="d" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="AdminPage"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>

        <util:StringEqualsToBoolConverter x:Key="StringEqualsToBoolConverter"/>

        <!--
            Style cho từng mục menu bên sidebar.
            Content của mỗi RadioButton là 1 StackPanel gồm SymbolIcon + TextBlock,
            không set Foreground cụ thể trên icon/text để chúng tự kế thừa màu chữ (Foreground)
            từ chính RadioButton khi được chọn (IsChecked).
        -->
        <Style x:Key="NavMenuItemStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="AdminMenu"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                CornerRadius="6"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho 2 nút cuối sidebar: Đăng xuất / Thoát -->
        <Style x:Key="NavFooterButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,3"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== THANH MENU (SIDEBAR) ===================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Logo + tên hệ thống -->
                <Grid DockPanel.Dock="Top" Height="76" Margin="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Images/logo.png" Width="36" Height="36"/>
                        <TextBlock Text="TaskMind" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- Khu vực đăng xuất / thoát: luôn ghim ở dưới cùng -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12">
                    <Separator Margin="12,4,12,8"/>

                    <ui:Button Style="{StaticResource NavFooterButtonStyle}"
                               Command="{Binding LogoutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="SignOut24" FontSize="18" Margin="0,0,12,0"/>
                            <TextBlock Text="Đăng xuất" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Style="{StaticResource NavFooterButtonStyle}"
                               Command="{Binding ExitCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowExit20" FontSize="18" Margin="0,0,12,0"/>
                            <TextBlock Text="Thoát ứng dụng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!-- Danh sách menu chính, cuộn được khi màn hình nhỏ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding DashbroadCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Dashbroad, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Tổng quan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding UserCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=User, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Người dùng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding ProfileCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Profile, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Person24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Hồ sơ cá nhân" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding SkillCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Skill, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Certificate24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Kỹ năng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding CompanyCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Company, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Building24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Công ty" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding SchoolCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=School, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Library24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Cơ sở đào tạo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding ProfitCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Profit, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Money24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Lợi nhuận" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding ReportCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Report, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Báo cáo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding ChatCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Chat, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Trò chuyện" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavMenuItemStyle}"
                                     Command="{Binding HandlerCommand}"
                                     IsChecked="{Binding ActiveKey, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Handler, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Xử lý / Kiểm duyệt" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ===================== NỘI DUNG TRANG ===================== -->
        <ContentControl Grid.Column="1"
                         Content="{Binding AdminCurrentView}"
                         x:Name="AdminPages"/>

    </Grid>
</Page>
