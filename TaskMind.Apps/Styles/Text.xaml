<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="#111A2A" />
        <Setter Property="Foreground" Value="#EAF1FA" />
        <Setter Property="BorderBrush" Value="#293A52" />
        <Setter Property="CaretBrush" Value="#4D9FFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#4D9FFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PasswordInput" TargetType="PasswordBox">
        <Setter Property="Background" Value="#111A2A" />
        <Setter Property="Foreground" Value="#EAF1FA" />
        <Setter Property="BorderBrush" Value="#293A52" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="RoleComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#111A2A" />
        <Setter Property="Foreground" Value="#EAF1FA" />
        <Setter Property="BorderBrush" Value="#293A52" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="#111A2A" />
                    <Setter Property="Foreground" Value="#EAF1FA" />
                    <Setter Property="Padding" Value="10,8" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#18263B" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#142743" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
