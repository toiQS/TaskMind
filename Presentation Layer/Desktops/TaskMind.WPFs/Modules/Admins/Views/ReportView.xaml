<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Admins.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Admins.Models"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:FilterAppearanceConverter x:Key="FilterAppearance"/>
        <util:RevenueSourceToTextConverter x:Key="SourceText"/>
        <util:RevenueSourceToBrushConverter x:Key="SourceBrush"/>
        <util:DeltaPercentToTextConverter x:Key="DeltaText"/>
        <util:DeltaPercentToBrushConverter x:Key="DeltaBrush"/>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Width" Value="234"/>
        </Style>

        <Style x:Key="StatAccentDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#4C9AFF"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="StatDelta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FilterChip" TargetType="ui:Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Hàng breakdown theo nguồn thu -->
        <Style x:Key="SourceRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SourceDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Fill" Value="{Binding Source, Converter={StaticResource SourceBrush}}"/>
        </Style>

        <Style x:Key="RevenueProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#3A4149"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding Source, Converter={StaticResource SourceBrush}}"/>
        </Style>

        <!-- Hàng giao dịch gần đây -->
        <Style x:Key="TransactionRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SourceBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#3A4149"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="360"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Báo cáo doanh thu" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Thống kê lợi nhuận từ phí giao dịch và phí thành viên" Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Content="Xuất báo cáo"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Command="{Binding ExportCommand}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <ui:Button Grid.Column="2"
                               Content="Làm mới"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshCommand}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Filter theo kỳ báo cáo -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
                    <ui:Button Style="{StaticResource FilterChip}" Content="Tuần"
                               Command="{Binding FilterPeriodCommand}" CommandParameter="Week"
                               Appearance="{Binding PeriodFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Week}"/>
                    <ui:Button Style="{StaticResource FilterChip}" Content="Tháng"
                               Command="{Binding FilterPeriodCommand}" CommandParameter="Month"
                               Appearance="{Binding PeriodFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Month}"/>
                    <ui:Button Style="{StaticResource FilterChip}" Content="Quý"
                               Command="{Binding FilterPeriodCommand}" CommandParameter="Quarter"
                               Appearance="{Binding PeriodFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Quarter}"/>
                    <ui:Button Style="{StaticResource FilterChip}" Content="Năm"
                               Command="{Binding FilterPeriodCommand}" CommandParameter="Year"
                               Appearance="{Binding PeriodFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Year}"/>
                </StackPanel>

                <!-- Stat cards -->
                <ItemsControl Grid.Row="2" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}"/>
                                    <TextBlock Text="Tổng doanh thu" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary.TotalRevenue, StringFormat='{}{0:N0} ₫'}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="{Binding Summary.RevenueDeltaPercent, Converter={StaticResource DeltaText}}"
                                           Foreground="{Binding Summary.RevenueDeltaPercent, Converter={StaticResource DeltaBrush}}"
                                           Style="{StaticResource StatDelta}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}" Fill="#4C9AFF"/>
                                    <TextBlock Text="Phí giao dịch" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary.TransactionFeeRevenue, StringFormat='{}{0:N0} ₫'}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Khấu trừ từ dự án trao đổi" Foreground="#8A93A0" Style="{StaticResource StatDelta}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}" Fill="#F5A623"/>
                                    <TextBlock Text="Phí thành viên" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary.SubscriptionRevenue, StringFormat='{}{0:N0} ₫'}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Công ty + Cơ sở đào tạo" Foreground="#8A93A0" Style="{StaticResource StatDelta}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatAccentDot}" Fill="#3FD07A"/>
                                    <TextBlock Text="Số giao dịch" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary.TotalTransactions}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Trong kỳ đang chọn" Foreground="#8A93A0" Style="{StaticResource StatDelta}"/>
                            </StackPanel>
                        </Border>

                    </ItemsControl.Items>
                </ItemsControl>

                <!-- Chart + Breakdown theo nguồn thu -->
                <Grid Grid.Row="3" Margin="0,4,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Line chart xu hướng doanh thu -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Xu hướng doanh thu" Style="{StaticResource SectionTitle}"/>

                            <Viewbox Grid.Row="1" Stretch="Fill">
                                <Canvas Width="600" Height="160">
                                    <Path Data="{Binding ChartGeometry}"
                                          Stroke="#4C9AFF"
                                          StrokeThickness="3"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding RevenueTrend}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="#8A93A0"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Breakdown theo nguồn thu -->
                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Theo nguồn thu" Style="{StaticResource SectionTitle}"/>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RevenueBySource}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RevenueBySourceItem}">
                                        <Border Style="{StaticResource SourceRow}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource SourceDot}"/>
                                                        <TextBlock Text="{Binding Source, Converter={StaticResource SourceText}}"
                                                                   Foreground="#DBDBDB" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat='{}{0:0.#}%'}"
                                                               Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>

                                                <ProgressBar Style="{StaticResource RevenueProgressBar}" Value="{Binding Percentage, Mode=OneWay}"/>

                                                <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} ₫'}"
                                                           Foreground="#8A93A0" FontSize="11" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                </Grid>

                <!-- Giao dịch gần đây -->
                <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Giao dịch gần đây" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding RecentTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TransactionRecord}">
                                    <Border Style="{StaticResource TransactionRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                       Foreground="#8A93A0" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <TextBlock Grid.Column="1" Text="{Binding PartnerName}"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                            <Border Grid.Column="2" Style="{StaticResource SourceBadge}" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Source, Converter={StaticResource SourceText}}"
                                                           Foreground="#DBDBDB" FontSize="11"/>
                                            </Border>

                                            <TextBlock Grid.Column="3" Text="{Binding Date, StringFormat='dd/MM/yyyy'}"
                                                       Foreground="#8A93A0" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat='{}+{0:N0} ₫'}"
                                                       Foreground="#3FD07A" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Overlay loading khi refresh -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>
