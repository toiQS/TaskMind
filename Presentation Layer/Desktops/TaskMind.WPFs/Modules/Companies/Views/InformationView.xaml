<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.InformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <util:VerificationStatusToTextConverter x:Key="VerifyText"/>
        <util:VerificationStatusToBrushConverter x:Key="VerifyBrush"/>
        <util:ExpiringSoonToBrushConverter x:Key="ExpiringBrush"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBDBDB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,20">
            <Grid DataContext="{Binding CompanyInfo}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32"
                        Background="#3E434A" Margin="0,0,20,0">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                               FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompanyName}" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border CornerRadius="10" Padding="9,4" Margin="0,0,10,0"
                                Background="{Binding VerificationStatus, Converter={StaticResource VerifyBrush}}">
                            <TextBlock Text="{Binding VerificationStatus, Converter={StaticResource VerifyText}}"
                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Industry}" Foreground="#8A93A0" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nút điều khiển chế độ xem/sửa -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Chỉnh sửa" Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" Height="38"
                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"
                               Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <ui:Button Content="Huỷ" Appearance="Secondary" Height="38" Margin="0,0,10,0"
                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                               Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <ui:Button Content="Lưu thay đổi" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Height="38"
                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                               Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Nội dung: form (trái) + sidebar (phải) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Cột trái: form thông tin ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding CompanyInfo}">

                    <!-- Thông báo lỗi khi lưu -->
                    <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                            Visibility="{Binding DataContext.ErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding DataContext.ErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- ===== Thông tin cơ bản ===== -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Thông tin cơ bản" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tên công ty" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding CompanyName}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mã số thuế" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding TaxCode}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Lĩnh vực hoạt động" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding Industry}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding Industry, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Quy mô nhân sự" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding CompanySize}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding CompanySize, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Ngày thành lập" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding FoundedDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <DatePicker SelectedDate="{Binding FoundedDate}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Website" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Website}" Foreground="#4C9AFF" FontSize="14"
                                           Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                <ui:TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                            Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Giới thiệu công ty" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource FieldValueStyle}"
                                           Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                            Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== Thông tin liên hệ & người đại diện ===== -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Thông tin liên hệ &amp; người đại diện" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Address}" Style="{StaticResource FieldValueStyle}"
                                           Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                <ui:TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                            Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding Phone}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding Email}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Người đại diện pháp luật" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding LegalRepresentativeName}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding LegalRepresentativeName, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Chức danh" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding LegalRepresentativePosition}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding LegalRepresentativePosition, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Cột phải: sidebar ===== -->
            <StackPanel Grid.Column="2">

                <!-- ===== Trạng thái xác thực ===== -->
                <Border Style="{StaticResource SectionCardStyle}" DataContext="{Binding CompanyInfo}">
                    <StackPanel>
                        <TextBlock Text="Trạng thái xác thực" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Border CornerRadius="10" Padding="10,6" HorizontalAlignment="Left"
                                Background="{Binding VerificationStatus, Converter={StaticResource VerifyBrush}}" Margin="0,0,0,16">
                            <TextBlock Text="{Binding VerificationStatus, Converter={StaticResource VerifyText}}"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="Ngày nộp hồ sơ" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="{Binding SubmittedDate, StringFormat='dd/MM/yyyy'}"
                                   Style="{StaticResource FieldValueStyle}" Margin="0,0,0,14"/>

                        <StackPanel Visibility="{Binding VerifiedDate, Converter={StaticResource B2V}}" Margin="0,0,0,14">
                            <TextBlock Text="Ngày xác thực" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding VerifiedDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding VerificationNote, Converter={StaticResource B2V}}">
                            <TextBlock Text="Ghi chú từ Admin hệ thống" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding VerificationNote}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Gói tham gia hệ thống ===== -->
                <Border Style="{StaticResource SectionCardStyle}" DataContext="{Binding Membership}">
                    <StackPanel>
                        <TextBlock Text="Gói tham gia hệ thống" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding PlanName}" Foreground="#4C9AFF" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PriceDisplay}" Foreground="#8A93A0" FontSize="13" Margin="0,0,0,18"/>

                        <TextBlock Text="Ngày hết hạn" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="{Binding ExpiryDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource FieldValueStyle}" Margin="0,0,0,6"/>

                        <TextBlock Foreground="{Binding IsExpiringSoon, Converter={StaticResource ExpiringBrush}}"
                                   FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,20">
                            <Run Text="Còn "/><Run Text="{Binding DaysRemaining, Mode=OneWay}"/><Run Text=" ngày"/>
                        </TextBlock>

                        <ui:Button Content="Gia hạn ngay" Icon="{ui:SymbolIcon ArrowRenew24}" Appearance="Primary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Height="42" FontWeight="SemiBold"
                                   Command="{Binding DataContext.RenewMembershipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== Overlay: loading ===== -->
        <Border Grid.RowSpan="2" Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>