<Page x:Class="TaskMind.WPFs.Modules.Admins.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
      mc:Ignorable="d" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        
        <!--thanh menu-->
        <StackPanel Grid.Column="0" CanHorizontallyScroll="True">
            <!--Dashbroad-->
            <!--School
            Company
            Staff
            Teacher
            User
            Skill
            Setting
            Profile-->
        </StackPanel>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="20*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="70">
                
                <!--chứa nút thoát hệ thống (close)-->
            </Grid>
            <ContentControl Grid.Row="1" Content="{Binding AdminCurrentView}" x:Name="AdminPages"/>
        </Grid>
    </Grid>
</Page>
