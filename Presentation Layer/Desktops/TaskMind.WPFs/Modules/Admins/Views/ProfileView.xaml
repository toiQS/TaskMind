<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7CDD6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ReadonlyValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBDBDB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="EditableField" TargetType="ui:TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StatBlock" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Cột trái: Avatar + thống kê ===== -->
                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource SectionCard}" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center">

                            <Border Width="96" Height="96" CornerRadius="48"
                                    Background="#3A4149" Margin="0,0,0,14">
                                <TextBlock Text="{Binding Profile.FullName[0]}"
                                           Foreground="White" FontSize="34" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="{Binding Profile.FullName}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Profile.Role}"
                                       Foreground="#8A93A0" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,2,0,18"/>

                            <ui:Button Content="Đổi ảnh đại diện"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Image24}"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"/>

                            <Separator Margin="0,18" Background="#3A4149"/>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Style="{StaticResource StatBlock}">
                                    <TextBlock Text="{Binding Profile.ManagedCompanies}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Công ty" Foreground="#8A93A0" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Style="{StaticResource StatBlock}">
                                    <TextBlock Text="{Binding Profile.ManagedSchools}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Cơ sở ĐT" Foreground="#8A93A0" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource StatBlock}">
                                    <TextBlock Text="{Binding Profile.PendingApprovals}" Foreground="#F5A623" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Chờ duyệt" Foreground="#8A93A0" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Quyền riêng tư -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Quyền riêng tư" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Công khai hồ sơ" Foreground="#DBDBDB" FontSize="13" VerticalAlignment="Center"/>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Profile.IsProfilePublic}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ===== Cột phải: Thông tin + Bảo mật ===== -->
                <StackPanel Grid.Column="2">

                    <!-- Thông tin cá nhân -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thông tin cá nhân" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <ui:Button Grid.Column="1"
                                           Content="{Binding IsEditing, Converter={StaticResource B2V}, FallbackValue=Chỉnh sửa}"
                                           Appearance="Secondary" Height="34"
                                           Icon="{ui:SymbolIcon Edit24}"
                                           Command="{Binding ToggleEditCommand}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Họ và tên" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Style="{StaticResource EditableField}"
                                                Text="{Binding Profile.FullName, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsEditing}"/>

                                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Style="{StaticResource EditableField}"
                                                Icon="{ui:SymbolIcon Mail24}"
                                                Text="{Binding Profile.Email, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsEditing}"/>

                                    <TextBlock Text="GitHub" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Style="{StaticResource EditableField}"
                                                Text="{Binding Profile.GithubUrl, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsEditing}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Style="{StaticResource EditableField}"
                                                Text="{Binding Profile.Phone, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsEditing}"/>

                                    <TextBlock Text="Ngày sinh" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Height="42" Margin="0,0,0,16"
                                                SelectedDate="{Binding Profile.DateOfBirth}"
                                                IsEnabled="{Binding IsEditing}"/>

                                    <TextBlock Text="LinkedIn" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Style="{StaticResource EditableField}"
                                                Text="{Binding Profile.LinkedinUrl, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsEditing}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Giới thiệu bản thân" Style="{StaticResource FieldLabel}"/>
                            <ui:TextBox Text="{Binding Profile.Bio, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsEditing}"
                                        AcceptsReturn="True" TextWrapping="Wrap"
                                        Height="80" Margin="0,0,0,16"/>

                            <ui:Button Content="Lưu thay đổi"
                                       Appearance="Primary"
                                       HorizontalAlignment="Right"
                                       Width="160" Height="40"
                                       Command="{Binding SaveCommand}"
                                       Visibility="{Binding IsEditing, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Bảo mật -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Bảo mật" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}"/>
                            <ui:PasswordBox Height="42" Margin="0,0,0,16"
                                            Icon="{ui:SymbolIcon LockClosed24}"
                                            Password="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mật khẩu mới" Style="{StaticResource FieldLabel}"/>
                                    <ui:PasswordBox Height="42" Margin="0,0,0,10"
                                                    Icon="{ui:SymbolIcon LockClosed24}"
                                                    Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Xác nhận mật khẩu mới" Style="{StaticResource FieldLabel}"/>
                                    <ui:PasswordBox Height="42" Margin="0,0,0,10"
                                                    Icon="{ui:SymbolIcon LockClosed24}"
                                                    Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding PasswordMessage}"
                                           Foreground="#4C9AFF" FontSize="12" VerticalAlignment="Center"/>

                                <ui:Button Grid.Column="1"
                                           Content="Đổi mật khẩu"
                                           Appearance="Primary"
                                           Width="160" Height="40"
                                           Command="{Binding ChangePasswordCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Overlay loading -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>