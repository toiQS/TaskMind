<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.AddStaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Companies.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="640">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Tái sử dụng converter đã có ở StaffConverters.cs -->
        <util:StaffFilterActiveConverter x:Key="ModeActive"/>
        <util:HiredCandidateToSummaryTextConverter x:Key="CandidateSummary"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SkillChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E2A3A"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <!-- Tab chuyển nguồn: Từ ứng viên / Nhập thủ công, cùng phong cách với StoreView Scope tabs -->
        <Style x:Key="SourceTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <!-- Card ứng viên: viền xanh khi đang được chọn -->
        <Style x:Key="CandidateChoiceCardStyle" TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#4C9AFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="1" CornerRadius="12"
            Width="640" MaxHeight="780">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="28,24,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PersonAdd24" FontSize="20" Foreground="#4C9AFF" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Thêm nhân sự mới" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Kế thừa từ ứng viên đã tuyển hoặc nhập thủ công (mục 4.5)"
                                   Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                           Command="{Binding CancelCommand}"/>
            </Grid>

            <!-- ===== Form (cuộn được) ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,8">
                <StackPanel>

                    <!-- Thông báo lỗi -->
                    <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- ===== Tab chọn nguồn ===== -->
                    <Border Background="#20242A" CornerRadius="10" Padding="4"
                            HorizontalAlignment="Left" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon PeopleStar24}" Content="Từ ứng viên đã tuyển"
                                       Command="{Binding SelectSourceModeCommand}"
                                       CommandParameter="{x:Static models:AddStaffSourceMode.FromCandidate}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource SourceTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SourceMode}" Value="{x:Static models:AddStaffSourceMode.FromCandidate}">
                                                <Setter Property="Background" Value="#4C9AFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button Icon="{ui:SymbolIcon Person24}" Content="Nhập thủ công" Margin="4,0,0,0"
                                       Command="{Binding SelectSourceModeCommand}"
                                       CommandParameter="{x:Static models:AddStaffSourceMode.Manual}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource SourceTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SourceMode}" Value="{x:Static models:AddStaffSourceMode.Manual}">
                                                <Setter Property="Background" Value="#4C9AFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- ===== Chế độ: Từ ứng viên đã tuyển ===== -->
                    <StackPanel Visibility="{Binding SourceMode, Converter={StaticResource ModeActive}, ConverterParameter=FromCandidate}">

                        <TextBlock Text="Chọn ứng viên" Style="{StaticResource FieldLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding HiredCandidates}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:HiredCandidateOption}">
                                    <ui:Card Style="{StaticResource CandidateChoiceCardStyle}">
                                        <ui:Card.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectCandidateCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </ui:Card.InputBindings>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                    Background="#3E434A" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding AppliedJobTitle}" Foreground="#8A93A0" FontSize="12" Margin="0,2,0,4"/>
                                                <TextBlock Text="{Binding SkillsDisplay}" Foreground="#4C9AFF" FontSize="11.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding SelectedCandidate, Converter={StaticResource CandidateSummary}}"
                                   Foreground="#8A93A0" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>
                    </StackPanel>

                    <!-- ===== Họ tên / Email: chỉnh sửa được ở cả 2 chế độ (chế độ ứng viên đã prefill) ===== -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Họ và tên *" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox Icon="{ui:SymbolIcon Person24}"
                                        PlaceholderText="Nguyễn Văn A"
                                        Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email *" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox PlaceholderText="you@taskmind.vn"
                                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox PlaceholderText="09xx xxx xxx"
                                Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                Height="42" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chức danh *" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox PlaceholderText="VD: Backend Developer"
                                        Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phòng ban *" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox PlaceholderText="VD: Phòng Kỹ thuật"
                                        Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Ngày gia nhập" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding JoinDate}" Height="42" Margin="0,0,0,18"/>

                    <!-- ===== Kỹ năng (tag input, prefill nếu chọn ứng viên) ===== -->
                    <TextBlock Text="Kỹ năng" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Icon="{ui:SymbolIcon Tag24}"
                                    PlaceholderText="Nhập kỹ năng rồi nhấn Enter"
                                    Text="{Binding SkillInput, UpdateSourceTrigger=PropertyChanged}"
                                    Height="42">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddSkillCommand}"/>
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>

                        <ui:Button Grid.Column="2" Content="Thêm" Appearance="Secondary" Height="42"
                                   Command="{Binding AddSkillCommand}"/>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <ItemsControl ItemsSource="{Binding Skills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <Border Style="{StaticResource SkillChipStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Foreground="#4C9AFF" FontSize="12.5" VerticalAlignment="Center"/>
                                            <ui:Button Content="✕" Appearance="Transparent" Height="18" Width="18"
                                                       Padding="0" FontSize="10" Margin="8,0,0,0"
                                                       Foreground="#8A93A0"
                                                       Command="{Binding DataContext.RemoveSkillCommand,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                PlaceholderText="Ghi chú nội bộ (không bắt buộc)..."
                                Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== Footer ===== -->
            <Grid Grid.Row="2" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Huỷ" Appearance="Transparent" Height="42"
                           Command="{Binding CancelCommand}"/>

                <ui:Button Grid.Column="2" Content="Thêm nhân sự" Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary" Height="42" Width="160" FontWeight="SemiBold"
                           Command="{Binding SaveCommand}"/>
            </Grid>

            <!-- ===== Overlay: đang lưu ===== -->
            <Border Grid.RowSpan="3" Background="#902B3036" CornerRadius="12"
                    Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                <ui:ProgressRing IsIndeterminate="True" Width="38" Height="38"/>
            </Border>
        </Grid>
    </Border>
</UserControl>