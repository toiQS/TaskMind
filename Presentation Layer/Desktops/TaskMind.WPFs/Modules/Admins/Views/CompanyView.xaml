<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.CompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:FilterAppearanceConverter x:Key="FilterAppearance"/>
        <util:CompanyStatusToBrushConverter x:Key="StatusBrush"/>
        <util:CompanyStatusToTextConverter x:Key="StatusText"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="FilterChip" TargetType="ui:Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CompanyRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="AvatarCircle" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="Background" Value="#3A4149"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusBrush}}"/>
        </Style>

        <!-- Nút hành động: chỉ hiện đúng theo Status -->
        <Style x:Key="ApproveBtnStyle" TargetType="ui:Button">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleSuspendBtnStyle" TargetType="ui:Button">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Suspended">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút xem chi tiết: hiện cho mọi trạng thái, điều hướng sang trang độc lập -->
        <Style x:Key="DetailBtnStyle" TargetType="ui:Button">
            <Setter Property="Content" Value="Xem chi tiết"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quản lý công ty" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Kiểm duyệt và theo dõi công ty trong hệ thống" Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <ui:TextBox Grid.Column="1"
                            Width="260"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Tìm công ty..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"/>

                <ui:Button Grid.Column="2"
                           Content="Thêm công ty"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding OpenAddCompanyCommand}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <ui:Button Grid.Column="3"
                           Content="Làm mới"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshCommand}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Filter chips -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button Style="{StaticResource FilterChip}" Content="Tất cả"
                           Command="{Binding FilterCommand}" CommandParameter="All"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=All}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Chờ duyệt"
                           Command="{Binding FilterCommand}" CommandParameter="Pending"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Pending}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Hoạt động"
                           Command="{Binding FilterCommand}" CommandParameter="Active"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Active}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Tạm ngưng"
                           Command="{Binding FilterCommand}" CommandParameter="Suspended"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Suspended}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Từ chối"
                           Command="{Binding FilterCommand}" CommandParameter="Rejected"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Rejected}"/>
            </StackPanel>

            <!-- Danh sách công ty -->
            <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Companies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CompanyRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar chữ cái đầu -->
                                        <Border Grid.Column="0" Style="{StaticResource AvatarCircle}">
                                            <TextBlock Text="{Binding Name[0]}"
                                                       Foreground="White" FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Thông tin -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0">
                                                <Run Text="{Binding Field, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Email, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Thống kê nhanh -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StaffCount}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Nhân sự" Foreground="#8A93A0" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectCount}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Dự án" Foreground="#8A93A0" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Badge trạng thái -->
                                        <Border Grid.Column="3" Style="{StaticResource StatusBadge}" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                       Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Hành động -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Style="{StaticResource DetailBtnStyle}" Height="32" Margin="0,0,8,0"
                                                       Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Style="{StaticResource ApproveBtnStyle}"
                                                       Content="Duyệt" Appearance="Success" Height="32" Margin="0,0,8,0"
                                                       Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Style="{StaticResource ApproveBtnStyle}"
                                                       Content="Từ chối" Appearance="Danger" Height="32" Margin="0,0,8,0"
                                                       Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Style="{StaticResource ToggleSuspendBtnStyle}"
                                                       Content="{Binding Status, Converter={StaticResource StatusText}}"
                                                       Appearance="Secondary" Height="32"
                                                       Command="{Binding DataContext.ToggleSuspendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Overlay loading khi refresh -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- Overlay modal: form Thêm công ty mới (vẫn giữ dạng modal vì là form nhập liệu ngắn) -->
        <Border Background="#B3181B1F"
                Visibility="{Binding IsAddPanelOpen, Converter={StaticResource B2V}}">
            <local:AddCompanyView DataContext="{Binding AddCompanyVM}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>