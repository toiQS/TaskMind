<UserControl x:Class="TaskMind.WPFs.Modules.Auths.Views.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Auths.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Auths.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:EnumToVisibilityConverter x:Key="StepVisible"/>
    </UserControl.Resources>

    <Grid>
        
        <!-- Cột phải: Wizard 3 bước -->
        <Grid Grid.Column="1" Margin="60,0">
            <StackPanel VerticalAlignment="Center">

                <!-- Thông báo lỗi dùng chung cho cả 3 bước -->
                <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- ===== Bước 1: Nhập email ===== -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=EnterEmail}">
                    <TextBlock Text="Quên mật khẩu?" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Nhập email đã đăng ký để nhận mã xác thực" Foreground="#8A93A0" FontSize="14" Margin="0,4,0,28"/>

                    <TextBlock Text="Email" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                    <ui:TextBox Icon="{ui:SymbolIcon Mail24}"
                                PlaceholderText="you@example.com"
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                Height="44" Margin="0,0,0,26"/>

                    <ui:Button Content="Gửi mã xác thực"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Height="46" FontSize="15" FontWeight="SemiBold"
                               Command="{Binding SendOtpCommand}"/>
                </StackPanel>

                <!-- ===== Bước 2: Nhập OTP ===== -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=EnterOtp}">
                    <TextBlock Text="Nhập mã xác thực" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,28" TextWrapping="Wrap">
                        <Run Text="Mã gồm 6 số vừa được gửi tới " Foreground="#8A93A0" FontSize="14"/>
                        <Run Text="{Binding Email, Mode=OneWay}" Foreground="#DBDBDB" FontSize="14" FontWeight="SemiBold"/>
                    </TextBlock>

                    <TextBlock Text="Mã xác thực" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                    <ui:TextBox Icon="{ui:SymbolIcon LockClosed24}"
                                PlaceholderText="000000"
                                MaxLength="6"
                                FontSize="20" CharacterCasing="Upper"
                                HorizontalContentAlignment="Center"
                                Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}"
                                Height="52" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                        <TextBlock Text="Không nhận được mã? " Foreground="#8A93A0" FontSize="13"/>
                        <TextBlock Foreground="#4C9AFF" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                   Visibility="{Binding CanResend, Converter={StaticResource B2V}}">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ResendOtpCommand}"/>
                            </TextBlock.InputBindings>
                            <Run Text="Gửi lại"/>
                        </TextBlock>
                        <TextBlock Foreground="#8A93A0" FontSize="13"
                                   Visibility="{Binding CanResend, Converter={StaticResource B2V}, ConverterParameter=Invert}">
                            <Run Text="Gửi lại sau "/><Run Text="{Binding ResendCooldownSeconds, Mode=OneWay}"/><Run Text="s"/>
                        </TextBlock>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="Quay lại" Appearance="Secondary" Height="46" Width="110"
                                   Command="{Binding BackCommand}"/>

                        <ui:Button Grid.Column="2" Content="Xác nhận"
                                   Appearance="Primary"
                                   HorizontalContentAlignment="Center"
                                   Height="46" FontSize="15" FontWeight="SemiBold"
                                   Command="{Binding VerifyOtpCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- ===== Bước 3: Đặt mật khẩu mới ===== -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=ResetPassword}">
                    <TextBlock Text="Đặt mật khẩu mới" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Chọn mật khẩu mới cho tài khoản của bạn" Foreground="#8A93A0" FontSize="14" Margin="0,4,0,28"/>

                    <TextBlock Text="Mật khẩu mới" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                    <ui:PasswordBox Icon="{ui:SymbolIcon LockClosed24}"
                                    PlaceholderText="Tối thiểu 8 ký tự"
                                    Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                    Height="44" Margin="0,0,0,16"/>

                    <TextBlock Text="Xác nhận mật khẩu mới" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                    <ui:PasswordBox Icon="{ui:SymbolIcon LockClosed24}"
                                    PlaceholderText="Nhập lại mật khẩu mới"
                                    Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                    Height="44" Margin="0,0,0,26"/>

                    <ui:Button Content="Đặt lại mật khẩu"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Height="46" FontSize="15" FontWeight="SemiBold"
                               Command="{Binding ResetPasswordCommand}"/>
                </StackPanel>

                <!-- ===== Bước 4: Hoàn tất ===== -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=Done}"
                            HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#1E3A2A" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="32" Foreground="#3FD07A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Đổi mật khẩu thành công" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Bạn có thể đăng nhập lại bằng mật khẩu mới." Foreground="#8A93A0" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,6,0,26"/>

                    <ui:Button Content="Về trang đăng nhập"
                               Appearance="Primary"
                               Width="220" Height="46" FontSize="15" FontWeight="SemiBold"
                               Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- Overlay loading -->
        <Border Grid.ColumnSpan="2" Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>