<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             xmlns:sharedUtil="clr-namespace:TaskMind.WPFs.Utilities"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <util:StaffStatusToTextConverter x:Key="StatusText"/>
        <util:StaffStatusToBrushConverter x:Key="StatusBrush"/>
        <util:SkillLevelToTextConverter x:Key="LevelText"/>
        <util:SkillLevelToBrushConverter x:Key="LevelBrush"/>
        <util:SkillLevelToProgressConverter x:Key="LevelProgress"/>
        <util:ProfileVisibilityToTextConverter x:Key="VisibilityText"/>
        <util:SocialPlatformToTextConverter x:Key="PlatformText"/>
        <util:EndorsementCountToTextConverter x:Key="EndorsementText"/>
        <util:ProjectCompletedToTextConverter x:Key="CompletedText"/>
        <util:ProjectCompletedToBrushConverter x:Key="CompletedBrush"/>

        <!-- Dùng lại converter so khớp enum hiện có của dự án để hiện/ẩn theo StaffStatus -->
        <sharedUtil:EnumToVisibilityConverter x:Key="StatusEquals"/>

        <ObjectDataProvider x:Key="SkillLevelValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SkillLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="SocialPlatformValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SocialPlatform"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="ProfileVisibilityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ProfileVisibility"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBDBDB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Chip kỹ năng / công nghệ dạng "xoá được" -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E2A3A"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24" DataContext="{Binding Profile}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===================== HEADER ===================== -->
                <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                                Background="#3E434A" Margin="0,0,20,0">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                       FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border CornerRadius="10" Padding="9,4" Margin="0,0,10,0"
                                        Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                               Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Foreground="#8A93A0" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="{Binding Position, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Department, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding CompanyName, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Nút điều khiển chế độ xem/sửa -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="Chỉnh sửa hồ sơ" Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" Height="38"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"
                                       Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                            <ui:Button Content="Huỷ" Appearance="Secondary" Height="38" Margin="0,0,10,0"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                       Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <ui:Button Content="Lưu thay đổi" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Height="38"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                       Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===================== NỘI DUNG: form (trái) + sidebar (phải) ===================== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===================== CỘT TRÁI ===================== -->
                    <StackPanel Grid.Column="0">

                        <!-- Thông báo lỗi khi lưu -->
                        <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding DataContext.ErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding DataContext.ErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <!-- ===== Thông tin cá nhân ===== -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Thông tin cá nhân" Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Họ và tên" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource FieldValueStyle}"
                                                   Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                        <ui:TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ngày sinh" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Style="{StaticResource FieldValueStyle}"
                                                   Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}">
                                            <Run Text="{Binding DateOfBirth, StringFormat='dd/MM/yyyy'}"/>
                                            <Run Text=" ("/><Run Text="{Binding Age, Mode=OneWay}"/><Run Text=" tuổi)"/>
                                        </TextBlock>
                                        <DatePicker SelectedDate="{Binding DateOfBirth}" Height="40"
                                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Email liên hệ" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource FieldValueStyle}"
                                                   Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                        <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Text="{Binding Phone}" Style="{StaticResource FieldValueStyle}"
                                                   Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                        <ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="Giới thiệu bản thân" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding Bio}" Style="{StaticResource FieldValueStyle}"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                    <ui:TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== Liên kết mạng xã hội / portfolio ===== -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Liên kết mạng xã hội &amp; portfolio" Style="{StaticResource SectionTitleStyle}"/>

                                <ItemsControl ItemsSource="{Binding DataContext.SocialLinks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SocialLinkModel}">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ui:SymbolIcon Grid.Column="0" Symbol="Link24" FontSize="16"
                                                               Foreground="#4C9AFF" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Platform, Converter={StaticResource PlatformText}}"
                                                               Foreground="#8A93A0" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding Url}" Foreground="#4C9AFF" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                           Height="28" Width="28"
                                                           Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                                           Command="{Binding DataContext.RemoveSocialLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Chưa có liên kết nào" Foreground="#8A93A0" FontSize="12.5" Margin="0,0,0,10"
                                           Visibility="{Binding DataContext.SocialLinks.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ZeroCountVisible}}"/>

                                <!-- Thêm liên kết mới (chỉ hiện khi đang chỉnh sửa) -->
                                <Grid Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" Height="40"
                                              ItemsSource="{Binding Source={StaticResource SocialPlatformValues}}"
                                              SelectedItem="{Binding DataContext.SocialPlatformInput, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource PlatformText}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ui:TextBox Grid.Column="2" Icon="{ui:SymbolIcon Link24}"
                                                PlaceholderText="https://..."
                                                Text="{Binding DataContext.SocialUrlInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                Height="40"/>

                                    <ui:Button Grid.Column="4" Content="Thêm" Appearance="Secondary" Height="40"
                                               Command="{Binding DataContext.AddSocialLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== Học vấn ===== -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Học vấn" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    <ui:Button Grid.Column="1" Content="Thêm" Icon="{ui:SymbolIcon Add24}" Appearance="Secondary" Height="32"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                               Command="{Binding DataContext.AddEducationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DataContext.EducationHistory, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:EducationHistoryModel}">
                                            <Border Background="#282D33" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Chế độ xem -->
                                                    <StackPanel Grid.Column="0"
                                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}">
                                                        <TextBlock Text="{Binding SchoolName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Major}" Foreground="#8A93A0" FontSize="12.5" Margin="0,2,0,4"/>
                                                        <TextBlock Text="{Binding DurationDisplay}" Foreground="#4C9AFF" FontSize="12"/>
                                                    </StackPanel>

                                                    <!-- Chế độ sửa -->
                                                    <Grid Grid.Column="0"
                                                          Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <ui:TextBox Grid.Row="0" PlaceholderText="Tên trường"
                                                                    Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}"
                                                                    Height="36" Margin="0,0,0,8"/>
                                                        <ui:TextBox Grid.Row="1" PlaceholderText="Chuyên ngành"
                                                                    Text="{Binding Major, UpdateSourceTrigger=PropertyChanged}"
                                                                    Height="36" Margin="0,0,0,8"/>
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ui:TextBox Grid.Column="0" PlaceholderText="Năm bắt đầu"
                                                                        Text="{Binding StartYear, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                                            <ui:TextBox Grid.Column="2" PlaceholderText="Năm kết thúc (để trống nếu đang học)"
                                                                        Text="{Binding EndYear, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                                        </Grid>
                                                    </Grid>

                                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                               Height="28" Width="28" VerticalAlignment="Top"
                                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                                               Command="{Binding DataContext.RemoveEducationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Chưa cập nhật học vấn" Foreground="#8A93A0" FontSize="12.5"
                                           Visibility="{Binding DataContext.EducationHistory.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ZeroCountVisible}}"/>
                            </StackPanel>
                        </Border>

                        <!-- ===== Kinh nghiệm làm việc ===== -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kinh nghiệm làm việc trước đó" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    <ui:Button Grid.Column="1" Content="Thêm" Icon="{ui:SymbolIcon Add24}" Appearance="Secondary" Height="32"
                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                               Command="{Binding DataContext.AddWorkExperienceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DataContext.WorkHistory, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:WorkExperienceModel}">
                                            <Border Background="#282D33" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Chế độ xem -->
                                                    <StackPanel Grid.Column="0"
                                                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}">
                                                        <TextBlock Text="{Binding Position}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding CompanyName}" Foreground="#8A93A0" FontSize="12.5" Margin="0,2,0,4"/>
                                                        <TextBlock Text="{Binding DurationDisplay}" Foreground="#4C9AFF" FontSize="12" Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="#C7CDD6" FontSize="12.5" TextWrapping="Wrap"
                                                                   Visibility="{Binding Description, Converter={StaticResource B2V}}"/>
                                                    </StackPanel>

                                                    <!-- Chế độ sửa -->
                                                    <Grid Grid.Column="0"
                                                          Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <ui:TextBox Grid.Row="0" PlaceholderText="Vị trí"
                                                                    Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,8"/>
                                                        <ui:TextBox Grid.Row="1" PlaceholderText="Tên công ty"
                                                                    Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,8"/>
                                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <DatePicker Grid.Column="0" SelectedDate="{Binding StartDate}" Height="36"/>
                                                            <DatePicker Grid.Column="2" SelectedDate="{Binding EndDate}" Height="36"/>
                                                        </Grid>
                                                        <ui:TextBox Grid.Row="3" PlaceholderText="Mô tả công việc (không bắt buộc)"
                                                                    AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                                                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>

                                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                               Height="28" Width="28" VerticalAlignment="Top"
                                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                                               Command="{Binding DataContext.RemoveWorkExperienceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Chưa cập nhật kinh nghiệm làm việc" Foreground="#8A93A0" FontSize="12.5"
                                           Visibility="{Binding DataContext.WorkHistory.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ZeroCountVisible}}"/>
                            </StackPanel>
                        </Border>

                        <!-- ===== Kỹ năng cá nhân ===== -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Kỹ năng cá nhân" Style="{StaticResource SectionTitleStyle}"/>

                                <ItemsControl ItemsSource="{Binding DataContext.Skills, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SkillItemModel}">
                                            <Border Background="#282D33" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                                                                       FontSize="14" FontWeight="SemiBold"/>
                                                            <Border Grid.Column="1" CornerRadius="10" Padding="8,3"
                                                                    Background="{Binding Level, Converter={StaticResource LevelBrush}}">
                                                                <TextBlock Text="{Binding Level, Converter={StaticResource LevelText}}"
                                                                           Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>

                                                        <ProgressBar Value="{Binding Level, Converter={StaticResource LevelProgress}, Mode=OneWay}"
                                                                     Minimum="0" Maximum="100" Height="6" Margin="0,0,0,8"
                                                                     Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>

                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="#3FD07A" Margin="0,0,4,0"
                                                                           Visibility="{Binding HasEndorsement, Converter={StaticResource B2V}}"/>
                                                            <TextBlock Text="{Binding EndorsementCount, Converter={StaticResource EndorsementText}}"
                                                                       Foreground="#8A93A0" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                               Height="28" Width="28" VerticalAlignment="Top"
                                                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"
                                                               Command="{Binding DataContext.RemoveSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Chưa khai báo kỹ năng" Foreground="#8A93A0" FontSize="12.5" Margin="0,0,0,10"
                                           Visibility="{Binding DataContext.Skills.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ZeroCountVisible}}"/>

                                <!-- Thêm kỹ năng mới -->
                                <Grid Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0" Icon="{ui:SymbolIcon Tag24}"
                                                PlaceholderText="Tên kỹ năng, VD: ASP.NET Core"
                                                Text="{Binding DataContext.SkillInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                Height="40">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding DataContext.AddSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>

                                    <ComboBox Grid.Column="2" Height="40"
                                              ItemsSource="{Binding Source={StaticResource SkillLevelValues}}"
                                              SelectedItem="{Binding DataContext.SkillLevelInput, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource LevelText}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ui:Button Grid.Column="4" Content="Thêm" Appearance="Secondary" Height="40"
                                               Command="{Binding DataContext.AddSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== CỘT PHẢI: sidebar ===================== -->
                    <StackPanel Grid.Column="2">

                        <!-- ===== Thông tin công việc (chỉ đọc, đồng bộ từ StaffModel bên Companies) ===== -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Thông tin công việc" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Công ty" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding CompanyName}" Style="{StaticResource FieldValueStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="Chức danh" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Position}" Style="{StaticResource FieldValueStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="Phòng ban" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Department}" Style="{StaticResource FieldValueStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="Ngày gia nhập" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding JoinDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource FieldValueStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="Thâm niên" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding TenureDisplay}" Style="{StaticResource FieldValueStyle}" Margin="0,0,0,14"/>

                                <!-- Chỉ hiện khi đã nghỉ việc -->
                                <StackPanel Visibility="{Binding Status, Converter={StaticResource StatusEquals}, ConverterParameter=Resigned}">
                                    <TextBlock Text="Ngày rời công ty" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding LeftDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource FieldValueStyle}"/>
                                </StackPanel>

                                <TextBlock Foreground="#5C6370" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <Run Text="Các thông tin trên do Admin công ty quản lý (mục 4.5), không thể tự chỉnh sửa tại đây."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- ===== Lịch sử tham gia dự án (tự động tổng hợp, chỉ đọc) ===== -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Lịch sử tham gia dự án" Style="{StaticResource SectionTitleStyle}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border CornerRadius="10" Padding="9,4" Margin="0,0,10,0" Background="#1E3A2A">
                                        <TextBlock Foreground="#3FD07A" FontSize="12" FontWeight="SemiBold">
                                            <Run Text="{Binding CompletedProjectCount, Mode=OneWay}"/><Run Text=" hoàn thành"/>
                                        </TextBlock>
                                    </Border>
                                    <Border CornerRadius="10" Padding="9,4" Background="#1E2A3A">
                                        <TextBlock Foreground="#4C9AFF" FontSize="12" FontWeight="SemiBold">
                                            <Run Text="{Binding OngoingProjectCount, Mode=OneWay}"/><Run Text=" đang tham gia"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding DataContext.ProjectHistory, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectHistorySummary}">
                                            <Border Background="#282D33" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ProjectName}" Foreground="White"
                                                                   FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0"
                                                                Background="{Binding IsCompleted, Converter={StaticResource CompletedBrush}}">
                                                            <TextBlock Text="{Binding IsCompleted, Converter={StaticResource CompletedText}}"
                                                                       Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding RoleName}" Foreground="#8A93A0" FontSize="12" Margin="0,2,0,4"/>
                                                    <TextBlock Text="{Binding DurationDisplay}" Foreground="#4C9AFF" FontSize="11.5"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Chưa tham gia dự án nào" Foreground="#8A93A0" FontSize="12.5"
                                           Visibility="{Binding DataContext.ProjectHistory.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ZeroCountVisible}}"/>
                            </StackPanel>
                        </Border>

                        <!-- ===== Quyền riêng tư (mục 4.2) ===== -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Quyền riêng tư" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Phạm vi hiển thị hồ sơ" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Visibility, Converter={StaticResource VisibilityText}}" Style="{StaticResource FieldValueStyle}" Margin="0,0,0,14"
                                           Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseB2V}}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource ProfileVisibilityValues}}"
                                          SelectedItem="{Binding Visibility}" Height="40" Margin="0,0,0,14"
                                          Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource VisibilityText}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hiển thị thông tin liên hệ" Foreground="#C7CDD6" FontSize="13" VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowContactInfo}"
                                                      IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      OffContent="" OnContent=""/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hiển thị lịch sử dự án" Foreground="#C7CDD6" FontSize="13" VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowProjectHistory}"
                                                      IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      OffContent="" OnContent=""/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>
