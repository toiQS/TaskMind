<Application x:Class="TaskMind.WPFs.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

                <ResourceDictionary Source="/Styles/Button.xaml"/>
                <ResourceDictionary Source="/Styles/Image.xaml"/>
                <ResourceDictionary Source="/Styles/Page.xaml"/>
                <ResourceDictionary Source="/Styles/Text.xaml"/>
                <ResourceDictionary Source="/Utilities/DataTemplate.xaml"/>
                <ResourceDictionary Source="/Modules/Auths/Utilities/AuthDataTemplate.xaml"/>
                <ResourceDictionary Source="/Modules/Admins/Utilities/AdminDataTemplate.xaml"/>
                <ResourceDictionary Source="/Modules/Companies/Utilities/CompanyDataTemplate.xaml"/>
                <ResourceDictionary Source="/Modules/Staffs/Utilities/StaffDataTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
