<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Companies.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:ListingTypeToTextConverter x:Key="TypeText"/>
        <util:ListingStatusToTextConverter x:Key="StatusText"/>
        <util:ListingStatusToBrushConverter x:Key="StatusBrush"/>
        <util:PriceDisplayConverter x:Key="PriceDisplay"/>
        <util:StoreFilterActiveConverter x:Key="FilterActive"/>
        <util:StoreActionVisibilityConverter x:Key="ActionVisible"/>

        <Style x:Key="StatCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <!-- Badge màu theo loại: OpenSource = xanh lá nhạt, Project = tím -->
        <Style x:Key="TypeBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#3A2E52"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ListingType.OpenSource}">
                    <Setter Property="Background" Value="#1E3A2A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút pill cho thẻ System/Company: đổi màu khi đang được chọn -->
        <Style x:Key="ScopeTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Chợ dự án &amp; mã nguồn mở" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Nơi treo dự án cũ cần bán/trao đổi hoặc chia sẻ mã nguồn mở (mục 4.14)"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,10,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Secondary"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Làm mới"/>
                        <ui:Button Content="Đăng tin"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding CreateListingCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Thẻ: Toàn hệ thống / Dự án của công ty ===== -->
                <!-- NOTE: kiểm tra lại tên icon Globe24 / Building24 qua IntelliSense (Ctrl+Space sau Symbol=") trước khi build -->
                <Border Grid.Row="1" Background="#20242A" CornerRadius="10" Padding="4"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Style="{StaticResource ScopeTabButtonStyle}"
                                   Icon="{ui:SymbolIcon Globe24}"
                                   Command="{Binding SetScopeCommand}"
                                   CommandParameter="{x:Static models:StoreScope.System}">
                            <ui:Button.Content>
                                <TextBlock>
                                    <Run Text="Toàn hệ thống ("/><Run Text="{Binding SystemCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </ui:Button.Content>
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ScopeTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScope}" Value="{x:Static models:StoreScope.System}">
                                            <Setter Property="Background" Value="#4C9AFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <ui:Button Style="{StaticResource ScopeTabButtonStyle}"
                                   Icon="{ui:SymbolIcon Building24}"
                                   Margin="4,0,0,0"
                                   Command="{Binding SetScopeCommand}"
                                   CommandParameter="{x:Static models:StoreScope.Company}">
                            <ui:Button.Content>
                                <TextBlock>
                                    <Run Text="Dự án của công ty ("/><Run Text="{Binding CompanyCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </ui:Button.Content>
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ScopeTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScope}" Value="{x:Static models:StoreScope.Company}">
                                            <Setter Property="Background" Value="#4C9AFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- ===== Thẻ thống kê (theo phạm vi thẻ đang chọn) ===== -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Chờ duyệt" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding PendingCount, Mode=OneWay}" Foreground="#FFC14C" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Đang hiển thị" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding PublishedCount, Mode=OneWay}" Foreground="#3FD07A" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Đã trao đổi" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding SoldCount, Mode=OneWay}" Foreground="#9A7BFF" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                </WrapPanel>

                <!-- ===== Tìm kiếm ===== -->
                <ui:TextBox Grid.Row="3" Width="320" HorizontalAlignment="Left"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Tìm theo tên hoặc công nghệ..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Height="40" Margin="0,0,0,14"/>

                <!-- ===== Bộ lọc kép: loại + trạng thái ===== -->
                <StackPanel Grid.Row="4" Margin="0,0,0,20">

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả loại"
                                   Command="{Binding SetTypeFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Dự án trao đổi"
                                   Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:ListingType.Project}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Mã nguồn mở"
                                   Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:ListingType.OpenSource}"/>
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả trạng thái"
                                   Command="{Binding SetStatusFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Chờ duyệt"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:ListingStatus.PendingApproval}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đang hiển thị"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:ListingStatus.Published}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đang thương lượng"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:ListingStatus.Negotiating}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đã trao đổi"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:ListingStatus.Sold}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Bị từ chối"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:ListingStatus.Rejected}"/>
                        <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="36"
                                   Command="{Binding ClearFilterCommand}"/>
                    </WrapPanel>
                </StackPanel>

                <!-- ===== Lưới tin đăng dạng card ===== -->
                <ItemsControl Grid.Row="5" ItemsSource="{Binding FilteredListings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:StoreListingModel}">
                            <ui:Card Width="360" Margin="0,0,16,16" Padding="18" Cursor="Hand">
                                <ui:Card.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenDetailCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </ui:Card.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tên + badge loại + badge "của bạn" -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                                   FontSize="15.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Style="{StaticResource TypeBadgeStyle}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TypeText}}"
                                                       Foreground="#C7CDD6" FontSize="10.5"/>
                                        </Border>
                                    </Grid>

                                    <!-- Badge "Dự án của bạn" (chỉ hiện ở thẻ Toàn hệ thống) -->
                                    <Border Grid.Row="1" CornerRadius="10" Padding="8,3" Background="#1E3A2A"
                                            HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="MineBadge">
                                                <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                <Binding Path="IsMine"/>
                                                <Binding Path="Status"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <TextBlock Text="Dự án của bạn" Foreground="#3FD07A" FontSize="10.5" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Mô tả -->
                                    <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="#8A93A0"
                                               FontSize="12.5" TextWrapping="Wrap" MaxHeight="52"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                                    <!-- Tech stack -->
                                    <TextBlock Grid.Row="3" Text="{Binding TechStackDisplay}" Foreground="#4C9AFF"
                                               FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <!-- Giá -->
                                    <TextBlock Grid.Row="4" Text="{Binding Price, Converter={StaticResource PriceDisplay}}"
                                               Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <!-- Trạng thái + lượt xem + hành động theo thẻ -->
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border CornerRadius="10" Padding="8,3" Margin="0,0,8,0"
                                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                           Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <ui:SymbolIcon Symbol="Eye24" FontSize="13" Foreground="#8A93A0" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding ViewCount, Mode=OneWay}" Foreground="#8A93A0" FontSize="12"/>
                                        </StackPanel>

                                        <!-- Nút "Quan tâm" (thẻ Toàn hệ thống, tin không phải của mình) -->
                                        <ui:Button Grid.Column="1" Content="{Binding InterestCount, StringFormat='Quan tâm ({0})'}"
                                                   Icon="{ui:SymbolIcon Heart24}" Appearance="Secondary" Height="30" FontSize="11.5"
                                                   Command="{Binding DataContext.ExpressInterestCommand,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Visibility>
                                                <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="Interest">
                                                    <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    <Binding Path="IsMine"/>
                                                    <Binding Path="Status"/>
                                                </MultiBinding>
                                            </ui:Button.Visibility>
                                        </ui:Button>

                                        <!-- Nút "Gỡ tin" (thẻ Công ty, Published) -->
                                        <ui:Button Grid.Column="1" Content="Gỡ tin" Appearance="Secondary" Height="30" FontSize="11.5"
                                                   Command="{Binding DataContext.CloseListingCommand,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Visibility>
                                                <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="CloseListing">
                                                    <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    <Binding Path="IsMine"/>
                                                    <Binding Path="Status"/>
                                                </MultiBinding>
                                            </ui:Button.Visibility>
                                        </ui:Button>

                                        <!-- Nút "Đánh dấu đã trao đổi" (thẻ Công ty, Negotiating) -->
                                        <ui:Button Grid.Column="1" Content="Đã trao đổi" Appearance="Success" Height="30" FontSize="11.5"
                                                   Command="{Binding DataContext.MarkSoldCommand,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Visibility>
                                                <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="MarkSold">
                                                    <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    <Binding Path="IsMine"/>
                                                    <Binding Path="Status"/>
                                                </MultiBinding>
                                            </ui:Button.Visibility>
                                        </ui:Button>

                                        <!-- Nhãn "Đang chờ Admin duyệt" (thẻ Công ty, Pending) -->
                                        <TextBlock Grid.Column="1" Text="Đang chờ Admin duyệt" Foreground="#FFC14C"
                                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="PendingNote">
                                                    <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    <Binding Path="IsMine"/>
                                                    <Binding Path="Status"/>
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: chi tiết tin đăng ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding HasSelectedListing, Converter={StaticResource B2V}}">

            <Border Width="480" HorizontalAlignment="Right" Background="#282D33"
                    BorderBrush="#3A4149" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
                    <StackPanel DataContext="{Binding SelectedListing}">

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}"
                                       Appearance="Transparent"
                                       Command="{Binding DataContext.CloseDetailCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                            <Border CornerRadius="10" Padding="9,4" Margin="0,0,8,0"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border CornerRadius="10" Padding="9,4" Background="#3A4149">
                                <TextBlock Text="{Binding Type, Converter={StaticResource TypeText}}"
                                           Foreground="#C7CDD6" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Mô tả" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,0,0,22"/>

                        <TextBlock Text="Công nghệ sử dụng" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TechStackDisplay}" Foreground="#4C9AFF" FontSize="13.5"
                                   TextWrapping="Wrap" Margin="0,0,0,22"/>

                        <TextBlock Text="Giá trao đổi" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Price, Converter={StaticResource PriceDisplay}}"
                                   Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,22"/>

                        <TextBlock Text="Người đăng" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#DBDBDB" FontSize="13.5" Margin="0,0,0,22">
                            <Run Text="{Binding SellerName}"/>
                            <LineBreak/>
                            <Run Text="{Binding SellerCompany}" Foreground="#8A93A0" FontSize="12.5"/>
                        </TextBlock>

                        <StackPanel Visibility="{Binding RepoUrl, Converter={StaticResource B2V}}" Margin="0,0,0,10">
                            <TextBlock Text="Repository" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding RepoUrl}" Foreground="#4C9AFF" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Ghi chú Admin (chỉ có ý nghĩa khi đang ở thẻ Công ty, tin Rejected) -->
                        <StackPanel Margin="0,0,0,26">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="RejectedNote">
                                    <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="IsMine"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock Text="Ghi chú kiểm duyệt từ Admin" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding AdminNote}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Hành động: Gỡ tin (thẻ Công ty, Published) -->
                        <ui:Button Content="Gỡ tin đăng" Appearance="Secondary" Height="42" Margin="0,0,0,10"
                                   Command="{Binding DataContext.CloseListingCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <ui:Button.Visibility>
                                <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="CloseListing">
                                    <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="IsMine"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </ui:Button.Visibility>
                        </ui:Button>

                        <!-- Hành động: Đánh dấu đã trao đổi (thẻ Công ty, Negotiating) -->
                        <ui:Button Content="Đánh dấu đã trao đổi" Appearance="Success" Height="42" Margin="0,0,0,10"
                                   Command="{Binding DataContext.MarkSoldCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <ui:Button.Visibility>
                                <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="MarkSold">
                                    <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="IsMine"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </ui:Button.Visibility>
                        </ui:Button>

                        <!-- Hành động: Quan tâm (thẻ Toàn hệ thống, tin không phải của mình) -->
                        <ui:Button Content="{Binding InterestCount, StringFormat='Quan tâm ({0})'}"
                                   Icon="{ui:SymbolIcon Heart24}" Appearance="Primary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Height="46" FontSize="15" FontWeight="SemiBold"
                                   Command="{Binding DataContext.ExpressInterestCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <ui:Button.Visibility>
                                <MultiBinding Converter="{StaticResource ActionVisible}" ConverterParameter="Interest">
                                    <Binding Path="DataContext.CurrentScope" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="IsMine"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </ui:Button.Visibility>
                        </ui:Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>