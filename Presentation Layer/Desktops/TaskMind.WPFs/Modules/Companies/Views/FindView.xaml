<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.FindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Companies.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:TrendDirectionToTextConverter x:Key="TrendText"/>
        <util:TrendDirectionToBrushConverter x:Key="TrendBrush"/>
        <util:AvailabilityToTextConverter x:Key="AvailText"/>
        <util:AvailabilityToBrushConverter x:Key="AvailBrush"/>
        <util:FindMatchScoreToTextConverter x:Key="MatchText"/>
        <util:FindMatchScoreToBrushConverter x:Key="MatchBrush"/>
        <util:FindFilterActiveConverter x:Key="FilterActive"/>
        <util:FindScopeToVisibilityConverter x:Key="ScopeVisible"/>
        <util:CompanyLeadStatusToTextConverter x:Key="LeadStatusText"/>
        <util:CompanyLeadStatusToBrushConverter x:Key="LeadStatusBrush"/>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <!-- Card dự án: viền xanh khi đang được chọn -->
        <Style x:Key="ProjectChipStyle" TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#4C9AFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card công ty tiềm năng: viền xanh khi đang được chọn -->
        <Style x:Key="CompanyChipStyle" TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#4C9AFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút pill chuyển thẻ: đổi màu khi đang được chọn -->
        <Style x:Key="ScopeTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Grid gốc: chỉ chứa ScrollViewer (toàn trang) + overlay loading/chi tiết, để overlay luôn phủ kín
         toàn bộ vùng hiển thị bất kể đang cuộn tới đâu. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tìm kiếm &amp; gợi ý" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Tìm ứng viên tự do phù hợp cho dự án hoặc khách hàng tiềm năng (công ty) đang cần hợp tác (mục 5.6)"/>
                        </TextBlock>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary"
                               Command="{Binding RefreshCommand}" ToolTip="Làm mới"/>
                </Grid>

                <!-- ===== Thẻ: Ứng viên / Khách hàng tiềm năng ===== -->
                <Border Grid.Row="1" Background="#20242A" CornerRadius="10" Padding="4"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Icon="{ui:SymbolIcon PeopleStar24}"
                                   Content="Ứng viên tự do"
                                   Command="{Binding SetScopeCommand}"
                                   CommandParameter="{x:Static models:FindScope.Candidate}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ScopeTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScope}" Value="{x:Static models:FindScope.Candidate}">
                                            <Setter Property="Background" Value="#4C9AFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <ui:Button Icon="{ui:SymbolIcon Building24}"
                                   Content="Khách hàng tiềm năng"
                                   Margin="4,0,0,0"
                                   Command="{Binding SetScopeCommand}"
                                   CommandParameter="{x:Static models:FindScope.Company}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ScopeTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScope}" Value="{x:Static models:FindScope.Company}">
                                            <Setter Property="Background" Value="#4C9AFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- ================= THẺ 1: ỨNG VIÊN TỰ DO ================= -->
                <Grid Grid.Row="2" Visibility="{Binding CurrentScope, Converter={StaticResource ScopeVisible}, ConverterParameter=Candidate}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===== Xu hướng kỹ năng ===== -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Xu hướng nhu cầu kỹ năng" Foreground="#C7CDD6" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SkillTrends}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SkillTrendModel}">
                                        <ui:Card Width="190" Margin="0,0,14,0" Padding="16,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SkillName}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4">
                                                    <Run Text="{Binding DemandCount, Mode=OneWay}"/><Run Text=" lượt tìm/tuần"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Direction, Converter={StaticResource TrendText}}"
                                                               Foreground="{Binding Direction, Converter={StaticResource TrendBrush}}"
                                                               FontSize="12" Margin="0,0,4,0"/>
                                                    <TextBlock Foreground="{Binding Direction, Converter={StaticResource TrendBrush}}" FontSize="12" FontWeight="SemiBold">
                                                        <Run Text="{Binding ChangePercent, StringFormat='{}{0:0.#}%'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- ===== Chọn dự án cần tìm ứng viên ===== -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Chọn dự án cần tìm ứng viên" Foreground="#C7CDD6" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ProjectNeeds}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ProjectNeedModel}">
                                    <ui:Card Style="{StaticResource ProjectChipStyle}" Margin="0,0,12,12">
                                        <ui:Card.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectProjectCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </ui:Card.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProjectName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="#8A93A0" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="220">
                                                <Run Text="{Binding SkillsDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#4C9AFF" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0">
                                                <Run Text="Cần "/><Run Text="{Binding OpenSlots, Mode=OneWay}"/><Run Text=" người"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== Tìm kiếm ===== -->
                    <ui:TextBox Grid.Row="2" Width="320" HorizontalAlignment="Left"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm theo tên hoặc kỹ năng..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Height="40" Margin="0,0,0,14"/>

                    <!-- ===== Bộ lọc trạng thái sẵn sàng ===== -->
                    <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,20">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                                   Command="{Binding SetAvailabilityFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Sẵn sàng"
                                   Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="{x:Static models:FreelancerAvailability.Available}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đang bận"
                                   Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="{x:Static models:FreelancerAvailability.Busy}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Không nhận việc"
                                   Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="{x:Static models:FreelancerAvailability.Unavailable}"/>
                        <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="34" Command="{Binding ClearFilterCommand}"/>
                    </WrapPanel>

                    <!-- ===== Danh sách ứng viên, sắp theo mức độ khớp ===== -->
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding FilteredCandidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FreelanceCandidateModel}">
                                <ui:Card Margin="0,0,0,12" Padding="18" Cursor="Hand">
                                    <ui:Card.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenCandidateDetailCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </ui:Card.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                                Background="#3E434A" Margin="0,0,16,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FullName}" Foreground="White"
                                                           FontSize="15" FontWeight="SemiBold"/>
                                                <Border Grid.Column="1" CornerRadius="10" Padding="8,3"
                                                        Background="{Binding Availability, Converter={StaticResource AvailBrush}}">
                                                    <TextBlock Text="{Binding Availability, Converter={StaticResource AvailText}}"
                                                               Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Headline}" Foreground="#8A93A0" FontSize="12.5" Margin="0,4,0,10"/>

                                            <TextBlock Text="{Binding SkillsDisplay}" Foreground="#4C9AFF" FontSize="12" Margin="0,0,0,10"/>

                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <ui:SymbolIcon Symbol="Star24" FontSize="13" Foreground="#FFC14C" Margin="0,0,4,0"/>
                                                <TextBlock Foreground="#C7CDD6" FontSize="12" Margin="0,0,14,0">
                                                    <Run Text="{Binding Rating, StringFormat='{}{0:0.0}'}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,0,14,0">
                                                    <Run Text="{Binding CompletedProjects, Mode=OneWay}"/><Run Text=" dự án hoàn thành"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#8A93A0" FontSize="12">
                                                    <Run Text="{Binding ExperienceYears, Mode=OneWay}"/><Run Text=" năm kinh nghiệm · "/><Run Text="{Binding Location}"/>
                                                </TextBlock>
                                            </WrapPanel>

                                            <!-- Thanh mức độ khớp với dự án đang chọn -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Value="{Binding MatchScore, Mode=OneWay}"
                                                             Minimum="0" Maximum="100" Height="6"
                                                             Foreground="{Binding MatchScore, Converter={StaticResource MatchBrush}}"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding MatchScore, Converter={StaticResource MatchText}}"
                                                           Foreground="{Binding MatchScore, Converter={StaticResource MatchBrush}}"
                                                           FontSize="11.5" FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2" Content="Mời tham gia" Appearance="Primary" Height="34"
                                                   Foreground="White"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Command="{Binding DataContext.InviteCommand,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"/>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ================= THẺ 2: KHÁCH HÀNG TIỀM NĂNG (CÔNG TY) ================= -->
                <Grid Grid.Row="3" Visibility="{Binding CurrentScope, Converter={StaticResource ScopeVisible}, ConverterParameter=Company}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===== Thẻ thống kê pipeline khách hàng ===== -->
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <ui:Card Style="{StaticResource StatCardStyle}" Width="220">
                            <StackPanel>
                                <TextBlock Text="Gợi ý mới" Foreground="#8A93A0" FontSize="12"/>
                                <TextBlock Text="{Binding NewLeadCount, Mode=OneWay}" Foreground="#4C9AFF" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Style="{StaticResource StatCardStyle}" Width="220">
                            <StackPanel>
                                <TextBlock Text="Đang trao đổi" Foreground="#8A93A0" FontSize="12"/>
                                <TextBlock Text="{Binding InTalksCount, Mode=OneWay}" Foreground="#9A7BFF" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Style="{StaticResource StatCardStyle}" Width="220">
                            <StackPanel>
                                <TextBlock Text="Đã là khách hàng" Foreground="#8A93A0" FontSize="12"/>
                                <TextBlock Text="{Binding ConvertedCount, Mode=OneWay}" Foreground="#3FD07A" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </ui:Card>
                    </WrapPanel>

                    <!-- ===== Tìm kiếm ===== -->
                    <ui:TextBox Grid.Row="1" Width="320" HorizontalAlignment="Left"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm theo tên công ty, lĩnh vực hoặc công nghệ..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Height="40" Margin="0,0,0,14"/>

                    <!-- ===== Bộ lọc trạng thái pipeline ===== -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                                   Command="{Binding SetCompanyStatusFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Mới gợi ý"
                                   Command="{Binding SetCompanyStatusFilterCommand}" CommandParameter="{x:Static models:CompanyLeadStatus.New}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đã liên hệ"
                                   Command="{Binding SetCompanyStatusFilterCommand}" CommandParameter="{x:Static models:CompanyLeadStatus.Contacted}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đang trao đổi"
                                   Command="{Binding SetCompanyStatusFilterCommand}" CommandParameter="{x:Static models:CompanyLeadStatus.InTalks}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đã là khách hàng"
                                   Command="{Binding SetCompanyStatusFilterCommand}" CommandParameter="{x:Static models:CompanyLeadStatus.Converted}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Không quan tâm"
                                   Command="{Binding SetCompanyStatusFilterCommand}" CommandParameter="{x:Static models:CompanyLeadStatus.NotInterested}"/>
                        <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="34" Command="{Binding ClearFilterCommand}"/>
                    </WrapPanel>

                    <!-- ===== Lưới công ty tiềm năng dạng card ===== -->
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding FilteredCompanies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PotentialCompanyModel}">
                                <ui:Card Width="360" Style="{StaticResource CompanyChipStyle}">
                                    <ui:Card.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenCompanyDetailCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </ui:Card.InputBindings>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Tên + trạng thái -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                    Background="#3E434A" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CompanyName}" Foreground="White"
                                                           FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Industry}" Foreground="#8A93A0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Top"
                                                    Background="{Binding Status, Converter={StaticResource LeadStatusBrush}}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource LeadStatusText}}"
                                                           Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Mô tả -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#8A93A0"
                                                   FontSize="12.5" TextWrapping="Wrap" MaxHeight="52"
                                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,10"/>

                                        <!-- Công nghệ cần -->
                                        <TextBlock Grid.Row="2" Text="{Binding SkillsDisplay}" Foreground="#4C9AFF"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <!-- Ngân sách + số dự án -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                                            <ui:SymbolIcon Symbol="Board24" FontSize="13" Foreground="#8A93A0" Margin="0,0,4,0"/>
                                            <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,0,14,0">
                                                <Run Text="{Binding OpenProjectsCount, Mode=OneWay}"/><Run Text=" dự án cần hợp tác"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding BudgetDisplay}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Mức khớp năng lực -->
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Value="{Binding MatchScore, Mode=OneWay}"
                                                         Minimum="0" Maximum="100" Height="6"
                                                         Foreground="{Binding MatchScore, Converter={StaticResource MatchBrush}}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MatchScore, Converter={StaticResource MatchText}}"
                                                       Foreground="{Binding MatchScore, Converter={StaticResource MatchBrush}}"
                                                       FontSize="11.5" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: chi tiết ứng viên ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding HasSelectedCandidate, Converter={StaticResource B2V}}">
            <Border Width="440" HorizontalAlignment="Right" Background="#282D33"
                    BorderBrush="#3A4149" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
                    <StackPanel DataContext="{Binding SelectedCandidate}">

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FullName}" Foreground="White"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                       Command="{Binding DataContext.CloseCandidateDetailCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>

                        <TextBlock Text="{Binding Headline}" Foreground="#8A93A0" FontSize="13.5" Margin="0,4,0,20"/>

                        <Border CornerRadius="10" Padding="9,4" HorizontalAlignment="Left"
                                Background="{Binding Availability, Converter={StaticResource AvailBrush}}" Margin="0,0,0,20">
                            <TextBlock Text="{Binding Availability, Converter={StaticResource AvailText}}"
                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="Kỹ năng" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SkillsDisplay}" Foreground="#4C9AFF" FontSize="13.5"
                                   TextWrapping="Wrap" Margin="0,0,0,22"/>

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Đánh giá" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Rating, StringFormat='{}{0:0.0} ★'}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Kinh nghiệm" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold">
                                    <Run Text="{Binding ExperienceYears, Mode=OneWay}"/><Run Text=" năm"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dự án" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CompletedProjects, Mode=OneWay}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Khu vực" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Location}" Foreground="#DBDBDB" FontSize="13.5" Margin="0,0,0,22"/>

                        <StackPanel Visibility="{Binding PortfolioUrl, Converter={StaticResource B2V}}" Margin="0,0,0,26">
                            <TextBlock Text="Portfolio" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding PortfolioUrl}" Foreground="#4C9AFF" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ui:Button Content="Mời tham gia dự án" Appearance="Primary" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" Height="46" FontSize="15" FontWeight="SemiBold"
                                   Command="{Binding DataContext.InviteCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- ===== Overlay: chi tiết công ty tiềm năng ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding HasSelectedCompany, Converter={StaticResource B2V}}">
            <Border Width="460" HorizontalAlignment="Right" Background="#282D33"
                    BorderBrush="#3A4149" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
                    <StackPanel DataContext="{Binding SelectedCompany}">

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CompanyName}" Foreground="White"
                                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                       Command="{Binding DataContext.CloseCompanyDetailCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>

                        <TextBlock Text="{Binding Industry}" Foreground="#8A93A0" FontSize="13.5" Margin="0,4,0,20"/>

                        <Border CornerRadius="10" Padding="9,4" HorizontalAlignment="Left"
                                Background="{Binding Status, Converter={StaticResource LeadStatusBrush}}" Margin="0,0,0,20">
                            <TextBlock Text="{Binding Status, Converter={StaticResource LeadStatusText}}"
                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="Mô tả nhu cầu" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,0,0,22"/>

                        <TextBlock Text="Công nghệ đang cần" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SkillsDisplay}" Foreground="#4C9AFF" FontSize="13.5"
                                   TextWrapping="Wrap" Margin="0,0,0,22"/>

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dự án cần hợp tác" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding OpenProjectsCount, Mode=OneWay}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ngân sách ước tính" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding BudgetDisplay}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Quy mô &amp; khu vực" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#DBDBDB" FontSize="13.5" Margin="0,0,0,22">
                            <Run Text="{Binding CompanySize}"/>
                            <LineBreak/>
                            <Run Text="{Binding Location}"/>
                        </TextBlock>

                        <StackPanel Visibility="{Binding Website, Converter={StaticResource B2V}}" Margin="0,0,0,22">
                            <TextBlock Text="Website" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Website}" Foreground="#4C9AFF" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="Người liên hệ" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#DBDBDB" FontSize="13.5" Margin="0,0,0,22">
                            <Run Text="{Binding ContactName}"/>
                            <LineBreak/>
                            <Run Text="{Binding ContactEmail}" Foreground="#8A93A0" FontSize="12.5"/>
                        </TextBlock>

                        <StackPanel Visibility="{Binding Note, Converter={StaticResource B2V}}" Margin="0,0,0,26">
                            <TextBlock Text="Ghi chú tiếp cận" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Note}" Foreground="#DBDBDB" FontSize="13.5" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Hành động chính: gửi yêu cầu trao đổi (mục 4.14). Luôn hiển thị — kể cả khi đã là khách hàng
                             vẫn có thể gửi yêu cầu hợp tác cho dự án mới. -->
                        <ui:Button Content="Gửi yêu cầu muốn trao đổi" Icon="{ui:SymbolIcon ArrowSwap24}"
                                   Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Height="46" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20"
                                   Command="{Binding DataContext.SendExchangeRequestCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"/>

                        <!-- Hành động cập nhật trạng thái pipeline -->
                        <TextBlock Text="Cập nhật trạng thái" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button Content="Đánh dấu đã liên hệ" Appearance="Secondary" Height="40" Margin="0,0,8,10"
                                       Visibility="{Binding Status, Converter={StaticResource FilterActive}, ConverterParameter=New}"
                                       Command="{Binding DataContext.MarkContactedCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>
                            <ui:Button Content="Đánh dấu đang trao đổi" Appearance="Primary" Height="40" Margin="0,0,8,10"
                                       Visibility="{Binding Status, Converter={StaticResource FilterActive}, ConverterParameter=Contacted}"
                                       Command="{Binding DataContext.MarkInTalksCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>
                            <ui:Button Content="Đánh dấu đã là khách hàng" Appearance="Success" Height="40" Margin="0,0,8,10"
                                       Visibility="{Binding Status, Converter={StaticResource FilterActive}, ConverterParameter=InTalks}"
                                       Command="{Binding DataContext.MarkConvertedCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>
                            <ui:Button Content="Không quan tâm" Appearance="Danger" Height="40" Margin="0,0,0,10"
                                       Command="{Binding DataContext.MarkNotInterestedCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
