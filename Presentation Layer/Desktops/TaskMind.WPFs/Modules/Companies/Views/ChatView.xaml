<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Companies.Models"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:ConversationTypeToTextConverter x:Key="TypeText"/>
        <util:ConversationTypeToBrushConverter x:Key="TypeBrush"/>
        <util:IsMineToAlignmentConverter x:Key="MineAlign"/>
        <util:IsMineToBrushConverter x:Key="MineBrush"/>
        <util:IsMineToCornerRadiusConverter x:Key="MineCorner"/>
        <util:MessageStatusToTextConverter x:Key="StatusText"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ChatFilterActiveConverter x:Key="FilterActive"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <!-- Card hội thoại: nền nổi bật khi đang được chọn -->
        <Style x:Key="ConversationCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#2A2F36"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Bố cục "trò chuyện" giữ nguyên dạng bảng điều khiển cố định (danh sách hội thoại + khung chat) vì đây
         là màn hình dạng ứng dụng chat thực thụ: mỗi cột đã tự cuộn nội bộ (danh sách bên trái, tin nhắn bên
         phải) nên khi cửa sổ nhỏ hơn dự kiến, nội dung vẫn xem được đầy đủ qua thanh cuộn riêng của từng cột
         thay vì cuộn cả trang (giữ trải nghiệm chat quen thuộc). Chỉ bổ sung MinWidth/MinHeight hợp lý để
         layout không bị co bóp quá mức. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="360"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Trò chuyện" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                    <Run Text="Trao đổi với nhân sự, nhóm dự án, đối tác và Admin hệ thống"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Margin="0,0,10,0"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Appearance="Secondary"
                           Command="{Binding RefreshCommand}"
                           ToolTip="Làm mới"/>
                <ui:Button Content="Hội thoại mới"
                           Icon="{ui:SymbolIcon ChatAdd24}"
                           Appearance="Primary"
                           FontWeight="SemiBold"
                           Command="{Binding NewConversationCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Nội dung: danh sách (trái) + khung chat (phải) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT TRÁI: danh sách hội thoại ================= -->
            <Border Grid.Column="0" Background="#20242A" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ui:TextBox Grid.Row="0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm hội thoại..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Height="40" Margin="0,0,0,12"/>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                                   Command="{Binding SetTypeFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Cá nhân"
                                   Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:ConversationType.Direct}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Dự án"
                                   Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:ConversationType.Project}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đối tác"
                                   Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:ConversationType.Partner}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Admin"
                                   Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:ConversationType.Admin}"/>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredConversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ConversationModel}">
                                    <Border Style="{StaticResource ConversationCardStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenConversationCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar + chấm online -->
                                            <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                                                <Border Width="42" Height="42" CornerRadius="21" Background="#3E434A">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                               FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Ellipse Width="11" Height="11" Fill="#3FD07A" Stroke="#20242A" StrokeThickness="2"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource B2V}}"/>
                                            </Grid>

                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                                                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding LastMessageTime, StringFormat='HH:mm'}"
                                                               Foreground="#8A93A0" FontSize="11"/>
                                                </Grid>

                                                <TextBlock Text="{Binding Subtitle}" Foreground="#8A93A0" FontSize="11.5"
                                                           Margin="0,1,0,4" TextTrimming="CharacterEllipsis"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding LastMessage}" Foreground="#C7CDD6"
                                                               FontSize="12.5" TextTrimming="CharacterEllipsis"/>

                                                    <Border Grid.Column="1" CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                                            Background="#FF4C5C" Margin="8,0,0,0"
                                                            Visibility="{Binding UnreadCount, Converter={StaticResource CountVisible}}">
                                                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10.5"
                                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <Border CornerRadius="8" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                        Background="{Binding Type, Converter={StaticResource TypeBrush}}" Opacity="0.85">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource TypeText}}"
                                                               Foreground="White" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= CỘT PHẢI: khung chat ================= -->
            <Border Grid.Column="2" Background="#20242A" CornerRadius="10"
                    Visibility="{Binding HasSelectedConversation, Converter={StaticResource B2V}}">
                <Grid DataContext="{Binding SelectedConversation}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header khung chat -->
                    <Border Grid.Row="0" BorderBrush="#3A4149" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                    Background="#3E434A" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="#8A93A0" FontSize="12"/>
                            </StackPanel>

                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                       Command="{Binding DataContext.CloseConversationCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>
                    </Border>

                    <!-- Danh sách tin nhắn dạng bong bóng -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ChatMessageModel}">
                                    <StackPanel Margin="0,0,0,14"
                                                HorizontalAlignment="{Binding IsMine, Converter={StaticResource MineAlign}}">

                                        <TextBlock Text="{Binding SenderName}" Foreground="#8A93A0" FontSize="11"
                                                   Margin="4,0,4,4"
                                                   Visibility="{Binding IsMine, Converter={StaticResource InverseB2V}}"/>

                                        <Border MaxWidth="480" Padding="14,10"
                                                Background="{Binding IsMine, Converter={StaticResource MineBrush}}"
                                                CornerRadius="{Binding IsMine, Converter={StaticResource MineCorner}}">
                                            <TextBlock Text="{Binding Content}" Foreground="White" FontSize="13.5"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="4,4,4,0"
                                                    HorizontalAlignment="{Binding IsMine, Converter={StaticResource MineAlign}}">
                                            <TextBlock Text="{Binding SentTime, StringFormat='HH:mm'}"
                                                       Foreground="#8A93A0" FontSize="10.5"/>
                                            <TextBlock Text=" · " Foreground="#8A93A0" FontSize="10.5"
                                                       Visibility="{Binding IsMine, Converter={StaticResource B2V}}"/>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                       Foreground="#8A93A0" FontSize="10.5"
                                                       Visibility="{Binding IsMine, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Ô nhập tin nhắn -->
                    <Grid Grid.Row="2" Margin="20,0,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    PlaceholderText="Nhập tin nhắn..."
                                    Text="{Binding DataContext.MessageInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                    Height="46"/>

                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                   Height="46" Width="52"
                                   Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Trạng thái rỗng khi chưa chọn hội thoại -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoSelectedConversation, Converter={StaticResource B2V}}">
                <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                <TextBlock Text="Chọn một hội thoại để bắt đầu trò chuyện" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ===== Overlay: loading ===== -->
        <Border Grid.RowSpan="2" Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>
