<Page x:Class="TaskMind.WPFs.Modules.Companies.Views.CompanyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CompanyPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <!-- Logo + tên hệ thống -->
            <Grid DockPanel.Dock="Top" Height="76" Margin="16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Images/logo.png" Width="36" Height="36"/>
                    <TextBlock Text="TaskMind" FontSize="20" FontWeight="SemiBold"
                    VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                </StackPanel>
            </Grid>
            <!--thanh menu-->
        </StackPanel>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <!--nút thông báo-->
                <!--nút thoát-->
                
            </Grid>
            <ContentControl Grid.Row="1"
         Content="{Binding CompanyCurrentView}"
         x:Name="CompanyPages"/>
        </Grid>
        
    </Grid>
</Page>
