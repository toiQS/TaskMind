<UserControl x:Class="TaskMind.WPFs.Modules.Auths.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Auths.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>

    <Grid>

        <!-- Cột phải: Form đăng ký -->
        <Grid Grid.Column="1" Margin="60,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,24">

                    <TextBlock Text="Tạo tài khoản" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Miễn phí, chỉ mất chưa đến 1 phút" Foreground="#8A93A0" FontSize="14" Margin="0,4,0,24"/>

                    <!-- Thông báo lỗi -->
                    <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Họ và tên" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                    <ui:TextBox Icon="{ui:SymbolIcon Person24}"
                                PlaceholderText="Nguyễn Văn A"
                                Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                Height="44" Margin="0,0,0,16"/>

                    <TextBlock Text="Email" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                    <ui:TextBox Icon="{ui:SymbolIcon Mail24}"
                                PlaceholderText="you@example.com"
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                Height="44" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mật khẩu" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                            <ui:PasswordBox Icon="{ui:SymbolIcon LockClosed24}"
                                            PlaceholderText="Tối thiểu 8 ký tự"
                                            Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                            Height="44"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Xác nhận mật khẩu" Foreground="#C7CDD6" FontSize="13" Margin="0,0,0,6"/>
                            <ui:PasswordBox Icon="{ui:SymbolIcon LockClosed24}"
                                            PlaceholderText="Nhập lại mật khẩu"
                                            Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                            Height="44"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Margin="0,0,0,26"
                              IsChecked="{Binding AgreeTerms}"
                              Foreground="#C7CDD6">
                        <TextBlock TextWrapping="Wrap">
                            Tôi đồng ý với <Run Foreground="#4C9AFF">Điều khoản sử dụng</Run> và <Run Foreground="#4C9AFF">Chính sách bảo mật</Run>
                        </TextBlock>
                    </CheckBox>

                    <ui:Button Content="Đăng ký"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Height="46"
                               FontSize="15" FontWeight="SemiBold"
                               Command="{Binding RegisterCommand}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <TextBlock Text="Đã có tài khoản? " Foreground="#8A93A0"/>
                        <TextBlock Text="Đăng nhập ngay" Foreground="#4C9AFF" Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.LoginCommand,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Overlay loading -->
        <Border Grid.ColumnSpan="2" Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>