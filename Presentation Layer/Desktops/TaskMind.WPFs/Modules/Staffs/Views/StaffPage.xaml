<Page x:Class="TaskMind.WPFs.Modules.Staffs.Views.StaffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
      xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
      xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StaffPage">

    <Page.Resources>
        <util:ProjectFilterActiveConverter x:Key="MenuActive"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>
        <util:UnreadCountToBadgeTextConverter x:Key="UnreadBadge"/>
        <util:NotificationTypeToSymbolConverter x:Key="NotiSymbol"/>
        <util:NotificationTypeToBrushConverter x:Key="NotiBrush"/>
        <util:IsReadToCardBrushConverter x:Key="NotiCardBg"/>
        <util:IsReadToDotVisibilityConverter x:Key="UnreadDot"/>
        <util:IsReadToFontWeightConverter x:Key="ReadWeight"/>
        <util:TimeAgoConverter x:Key="TimeAgo"/>

        <!-- Item menu sidebar: dùng lại BtnStyle (RadioButton) đã có sẵn trong Styles/Button.xaml,
             chỉ set Content là icon + nhãn — đúng mục đích thiết kế ban đầu của style này. -->
        <Style x:Key="MenuBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#FF6B6B"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
    </Page.Resources>

    <Grid Background="#282D33">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ===================== CỘT TRÁI: SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="#20242A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo -->
                    <RowDefinition Height="*"/>
                    <!-- Menu: chiếm phần co giãn, tự cuộn khi tràn -->
                    <RowDefinition Height="Auto"/>
                    <!-- Đường phân cách -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nút thoát hệ thống -->
                </Grid.RowDefinitions>

                <!-- Logo + tên hệ thống -->
                <Grid Grid.Row="0" Height="76" Margin="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Images/logo.png" Width="36" Height="36"/>
                        <TextBlock Text="TaskMind" FontSize="20" FontWeight="SemiBold"
                            VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Thanh menu (cuộn được) ===== -->
                <ScrollViewer Grid.Row="1"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       Padding="0,0,10,0"
                       Margin="0,10,0,0">
                    <StackPanel>

                        <RadioButton Style="{StaticResource BtnStyle}" GroupName="StaffMenu"
                                     Command="{Binding ProfileCommand}"
                                     IsChecked="{Binding ActiveMenu, Converter={StaticResource MenuActive}, ConverterParameter=Profile, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <ui:SymbolIcon Symbol="Person24" FontSize="18" Foreground="#C7CDD6" Margin="0,0,14,0"/>
                                <TextBlock Text="Hồ sơ cá nhân" Foreground="#DBDBDB" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnStyle}" GroupName="StaffMenu"
                                     Command="{Binding ProjectCommand}"
                                     IsChecked="{Binding ActiveMenu, Converter={StaticResource MenuActive}, ConverterParameter=Project, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <ui:SymbolIcon Symbol="Board24" FontSize="18" Foreground="#C7CDD6" Margin="0,0,14,0"/>
                                <TextBlock Text="Dự án của tôi" Foreground="#DBDBDB" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnStyle}" GroupName="StaffMenu"
                                     Command="{Binding TodoCommand}"
                                     IsChecked="{Binding ActiveMenu, Converter={StaticResource MenuActive}, ConverterParameter=Todo, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="18" Foreground="#C7CDD6" Margin="0,0,14,0"/>
                                <TextBlock Text="Công việc" Foreground="#DBDBDB" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnStyle}" GroupName="StaffMenu"
                                     Command="{Binding ChatCommand}"
                                     IsChecked="{Binding ActiveMenu, Converter={StaticResource MenuActive}, ConverterParameter=Chat, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="18" Foreground="#C7CDD6" Margin="0,0,14,0"/>
                                <TextBlock Text="Trò chuyện" Foreground="#DBDBDB" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnStyle}" GroupName="StaffMenu"
                                     Command="{Binding SupportCommand}"
                                     IsChecked="{Binding ActiveMenu, Converter={StaticResource MenuActive}, ConverterParameter=Support, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <ui:SymbolIcon Symbol="ChatHelp24" FontSize="18" Foreground="#C7CDD6" Margin="0,0,14,0"/>
                                <TextBlock Text="Hỗ trợ" Foreground="#DBDBDB" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnStyle}" GroupName="StaffMenu"
                                     Command="{Binding SourceCommand}"
                                     IsChecked="{Binding ActiveMenu, Converter={StaticResource MenuActive}, ConverterParameter=Source, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <ui:SymbolIcon Symbol="Code24" FontSize="18" Foreground="#C7CDD6" Margin="0,0,14,0"/>
                                <TextBlock Text="Mã nguồn" Foreground="#DBDBDB" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnStyle}" GroupName="StaffMenu"
                                     Command="{Binding OpenNotificationsCommand}"
                                     IsChecked="{Binding ActiveMenu, Converter={StaticResource MenuActive}, ConverterParameter=Notifications, Mode=OneWay}">
                            <Grid Margin="24,0,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Alert24" FontSize="18" Foreground="#C7CDD6" Margin="0,0,14,0"/>
                                <TextBlock Grid.Column="1" Text="Thông báo" Foreground="#DBDBDB" FontSize="14" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Style="{StaticResource MenuBadgeStyle}"
                                        Visibility="{Binding NotificationsVM.UnreadCount, Converter={StaticResource CountVisible}}">
                                    <TextBlock Text="{Binding NotificationsVM.UnreadCount, Converter={StaticResource UnreadBadge}}"
                                               Foreground="White" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Đường phân cách ===== -->
                <Border Grid.Row="2" Height="1" Background="#3A4149" Margin="20,8,20,8"/>

                <!-- ===== Nút thoát khỏi hệ thống ===== -->
                <Button Grid.Row="3" Command="{Binding ExitCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Stretch" Padding="0" Margin="0,4,0,14">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ExitBorder" Background="Transparent" CornerRadius="8" Margin="12,0">
                                <Grid Height="44">
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowExit24" FontSize="18" Foreground="#FF6B6B" Margin="0,0,14,0"/>
                                        <TextBlock Text="Thoát khỏi hệ thống" Foreground="#FF6B6B" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="ExitBorder" Value="#3A2020"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Top bar: chuông thông báo ===== -->
            <Grid Grid.Row="0" Margin="0,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid x:Name="BellAnchor">
                        <ui:Button Icon="{ui:SymbolIcon Alert24}" Appearance="Transparent" Height="38" Width="38"
                                   Command="{Binding NotificationsVM.TogglePanelCommand}"
                                   ToolTip="Thông báo"/>
                        <Border Width="16" Height="16" CornerRadius="8" Background="#FF6B6B"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                IsHitTestVisible="False"
                                Visibility="{Binding NotificationsVM.UnreadCount, Converter={StaticResource CountVisible}}">
                            <TextBlock Text="{Binding NotificationsVM.UnreadCount, Converter={StaticResource UnreadBadge}}"
                                       Foreground="White" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- ===== Bảng thông báo nhanh (5 thông báo gần nhất) ===== -->
                    <Popup IsOpen="{Binding NotificationsVM.IsPanelOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=BellAnchor}"
                           Placement="Bottom" HorizontalOffset="-330" VerticalOffset="10"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="380" MaxHeight="480" Background="#20242A" BorderBrush="#3A4149"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="18,16,10,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Thông báo" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                    <ui:Button Grid.Column="1" Content="Đánh dấu đã đọc" Appearance="Transparent" FontSize="11.5"
                                               Height="28"
                                               Command="{Binding NotificationsVM.MarkAllAsReadCommand}"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                    <StackPanel Margin="10,0,10,6">
                                        <TextBlock Text="Không có thông báo nào" Foreground="#8A93A0" FontSize="12.5"
                                                   HorizontalAlignment="Center" Margin="0,30,0,30"
                                                   Visibility="{Binding NotificationsVM.RecentNotifications.Count, Converter={StaticResource ZeroCountVisible}}"/>

                                        <ItemsControl ItemsSource="{Binding NotificationsVM.RecentNotifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:NotificationItemModel}">
                                                    <Border Background="{Binding IsRead, Converter={StaticResource NotiCardBg}}"
                                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,8" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.NotificationsVM.MarkAsReadCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=Page}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                                    Background="{Binding Type, Converter={StaticResource NotiBrush}}"
                                                                    Margin="0,0,10,0">
                                                                <ui:SymbolIcon Symbol="{Binding Type, Converter={StaticResource NotiSymbol}}"
                                                                               FontSize="15" Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                                                               FontSize="13"
                                                                               FontWeight="{Binding IsRead, Converter={StaticResource ReadWeight}}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border Grid.Column="1" Width="7" Height="7" CornerRadius="4" Background="#4C9AFF"
                                                                            Margin="6,3,0,0"
                                                                            Visibility="{Binding IsRead, Converter={StaticResource UnreadDot}}"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Content}" Foreground="#8A93A0" FontSize="11.5"
                                                                           TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                                                           Margin="0,3,0,4"/>
                                                                <TextBlock Text="{Binding CreatedDate, Converter={StaticResource TimeAgo}}"
                                                                           Foreground="#5C6370" FontSize="10.5"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border Grid.Row="2" BorderBrush="#3A4149" BorderThickness="0,1,0,0">
                                    <ui:Button Content="Xem tất cả thông báo" Appearance="Transparent"
                                               HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                               Height="42" FontSize="12.5"
                                               Command="{Binding OpenNotificationsCommand}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <ContentControl Grid.Row="1"
                 Content="{Binding StaffCurrentView}"
                 x:Name="StaffPages"/>
        </Grid>
    </Grid>
</Page>