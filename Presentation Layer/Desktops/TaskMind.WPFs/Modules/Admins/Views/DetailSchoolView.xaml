<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.DetailSchoolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Admins.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Admins.Models"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:SchoolStatusToBrushConverter x:Key="StatusBrush"/>
        <util:SchoolStatusToTextConverter x:Key="StatusText"/>
        <util:RatingToStarsConverter x:Key="Stars"/>
        <util:ReportStatusToBrushConverter x:Key="ReportStatusBrush"/>
        <util:ReportStatusToTextConverter x:Key="ReportStatusText"/>
        <util:PriorityToBrushConverter x:Key="PriorityBrush"/>
        <util:ViolationTypeToTextConverter x:Key="ViolationText"/>
        <util:ReportedEntityTypeToTextConverter x:Key="EntityTypeText"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7CDD6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBDBDB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ReviewCard" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ReportRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PriorityBar" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{Binding Priority, Converter={StaticResource PriorityBrush}}"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header: Back + tên cơ sở + trạng thái + hành động ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowLeft24}"
                               Width="40" Height="40"
                               Margin="0,0,14,0"
                               Command="{Binding BackCommand}"/>

                    <Border Grid.Column="1" Width="52" Height="52" CornerRadius="26"
                            Background="#3A4149" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Detail.School.Name[0]}"
                                   Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Detail.School.Name}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                            <Border Style="{StaticResource StatusBadge}" Margin="12,0,0,0"
                                    Background="{Binding Detail.School.Status, Converter={StaticResource StatusBrush}}">
                                <TextBlock Text="{Binding Detail.School.Status, Converter={StaticResource StatusText}}"
                                           Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="{Binding Detail.School.Field, Mode=OneWay}"/>
                            <Run Text=" · Gói "/>
                            <Run Text="{Binding Detail.School.Package, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <ui:Button Grid.Column="3"
                               Content="Tạm ngưng / Kích hoạt"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon PauseCircle24}"
                               Command="{Binding ToggleSuspendCommand}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <ui:Button Grid.Column="4"
                               Content="Làm mới"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshCommand}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Stat cards ===== -->
                <ItemsControl Grid.Row="1" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>

                        <Border Style="{StaticResource StatCard}" Width="180">
                            <StackPanel>
                                <TextBlock Text="Giảng viên" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.School.TeacherCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="180">
                            <StackPanel>
                                <TextBlock Text="Khoá học" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.School.CourseCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="180">
                            <StackPanel>
                                <TextBlock Text="Học viên" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.School.StudentCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="220">
                            <StackPanel>
                                <TextBlock Text="Đánh giá trung bình" Style="{StaticResource StatLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Detail.AverageRating, StringFormat='{}{0:0.0}'}"
                                               Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Detail.TotalReviews, StringFormat=' ({0} đánh giá)'}"
                                               Foreground="#8A93A0" FontSize="12" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="260">
                            <StackPanel>
                                <TextBlock Text="Tỉ lệ có việc làm sau 2 năm tốt nghiệp" Style="{StaticResource StatLabel}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail.EmploymentRateAfter2Years, StringFormat='{}{0:0.#}%'}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                    </ItemsControl.Items>
                </ItemsControl>

                <!-- ===== Thông tin cơ sở + 2 biểu đồ tăng trưởng ===== -->
                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thông tin cơ sở đào tạo -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Thông tin cơ sở đào tạo" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Detail.School.Email}" Style="{StaticResource FieldValue}" Margin="0,2,0,12"/>

                            <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Detail.School.Phone}" Style="{StaticResource FieldValue}" Margin="0,2,0,12"/>

                            <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Detail.School.Address}" Style="{StaticResource FieldValue}" Margin="0,2,0,12"/>

                            <TextBlock Text="Ngày tham gia" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Detail.School.JoinedDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </Border>

                    <!-- Biểu đồ tăng trưởng -->
                    <StackPanel Grid.Column="2">

                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Tăng trưởng học viên" Style="{StaticResource SectionTitle}"/>
                                <Viewbox Grid.Row="1" Stretch="Fill" Height="120">
                                    <Canvas Width="560" Height="140">
                                        <Path Data="{Binding StudentChartGeometry}"
                                              Stroke="#4C9AFF" StrokeThickness="3"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Tăng trưởng khoá học" Style="{StaticResource SectionTitle}"/>
                                <Viewbox Grid.Row="1" Stretch="Fill" Height="120">
                                    <Canvas Width="560" Height="140">
                                        <Path Data="{Binding CourseChartGeometry}"
                                              Stroke="#3FD07A" StrokeThickness="3"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Grid>

                <!-- ===== Đánh giá cơ sở đào tạo ===== -->
                <Border Grid.Row="3" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Đánh giá từ học viên đã tham gia" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding Detail.Reviews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SchoolReviewModel}">
                                    <Border Style="{StaticResource ReviewCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ReviewerName}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Rating, Converter={StaticResource Stars}}"
                                                               Foreground="#F5A623" FontSize="13" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy'}"
                                                           Foreground="#8A93A0" FontSize="11"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Comment}" Foreground="#DBDBDB" FontSize="13"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Báo cáo vi phạm (cơ sở + nhân sự trực thuộc) ===== -->
                <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Báo cáo vi phạm liên quan (cơ sở &amp; nhân sự trực thuộc)" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding Detail.Reports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ReportModel}">
                                    <Border Style="{StaticResource ReportRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource PriorityBar}" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ReportedEntityName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="#8A93A0" FontSize="11" Margin="0,3,0,0">
                                                    <Run Text="{Binding ReportedEntityType, Converter={StaticResource EntityTypeText}, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding ViolationType, Converter={StaticResource ViolationText}, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy', Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource StatusBadge}" VerticalAlignment="Top"
                                                    Background="{Binding Status, Converter={StaticResource ReportStatusBrush}}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource ReportStatusText}}"
                                                           Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Overlay loading -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>