<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.DashbroadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Companies.Models"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Tái sử dụng converter đã có ở ProjectConverters.cs / FindConverters.cs -->
        <util:StatusToTextConverter x:Key="StatusText"/>
        <util:StatusToBrushConverter x:Key="StatusBrush"/>
        <util:ProgressToPercentTextConverter x:Key="ProgressPercent"/>
        <util:TrendDirectionToTextConverter x:Key="TrendText"/>
        <util:TrendDirectionToBrushConverter x:Key="TrendBrush"/>

        <!-- Converter riêng cho Dashboard -->
        <util:StringToSymbolConverter x:Key="SymbolFromString"/>
        <util:HexToBrushConverter x:Key="BrushFromHex"/>
        <util:RelativeTimeConverter x:Key="RelativeTime"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tổng quan" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                    <Run Text="Bức tranh tổng thể về dự án, nhân sự, tuyển dụng và hỗ trợ nội bộ"/>
                </TextBlock>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Appearance="Secondary"
                       Command="{Binding RefreshCommand}"
                       ToolTip="Làm mới"/>
        </Grid>

        <!-- ===== KPI Cards ===== -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding QuickStats}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:QuickStatModel}">
                    <ui:Card Margin="0,0,16,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="38" Height="38" CornerRadius="10"
                                    Background="{Binding AccentColor, Converter={StaticResource BrushFromHex}}"
                                    Opacity="0.18" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <ui:SymbolIcon Grid.Row="0" Symbol="{Binding Icon, Converter={StaticResource SymbolFromString}}"
                                           FontSize="20" Foreground="{Binding AccentColor, Converter={StaticResource BrushFromHex}}"
                                           HorizontalAlignment="Left" Margin="9,0,0,12"/>

                            <TextBlock Grid.Row="1" Text="{Binding Value}" Foreground="White"
                                       FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Text="{Binding Title}" Foreground="#C7CDD6"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>

                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <TextBlock Text="{Binding Trend, Converter={StaticResource TrendText}}"
                                           Foreground="{Binding Trend, Converter={StaticResource TrendBrush}}"
                                           FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Foreground="{Binding Trend, Converter={StaticResource TrendBrush}}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"
                                           Visibility="{Binding TrendPercent, Converter={StaticResource B2V}}">
                                    <Run Text="{Binding TrendPercent, StringFormat='{}{0:0.#}%'}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SubText}" Foreground="#8A93A0" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Thao tác nhanh ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <ui:Button Content="Quản lý dự án" Icon="{ui:SymbolIcon Board24}" Appearance="Secondary"
                       Height="38" Margin="0,0,10,0"
                       Command="{Binding DataContext.ProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
            <ui:Button Content="Đăng tin tuyển dụng" Icon="{ui:SymbolIcon PersonAdd24}" Appearance="Secondary"
                       Height="38" Margin="0,0,10,0"
                       Command="{Binding DataContext.RecruitmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
            <ui:Button Content="Thêm nhân sự" Icon="{ui:SymbolIcon People24}" Appearance="Secondary"
                       Height="38" Margin="0,0,10,0"
                       Command="{Binding DataContext.StaffCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
            <ui:Button Content="Xử lý yêu cầu hỗ trợ" Icon="{ui:SymbolIcon ChatMultiple24}" Appearance="Secondary"
                       Height="38"
                       Command="{Binding DataContext.SupportCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
        </StackPanel>

        <!-- ===== Nội dung chính: 2 cột ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Cột trái: Dự án đang triển khai ===== -->
            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dự án đang triển khai" Foreground="White"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <ui:Button Grid.Column="1" Content="Xem tất cả" Appearance="Transparent" Height="30"
                                   Command="{Binding DataContext.ProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TopProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ProjectProgressSummary}">
                                <Border Background="#282D33" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                                                       FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" CornerRadius="10" Padding="8,3"
                                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                           Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Value="{Binding Progress, Mode=OneWay}"
                                                         Minimum="0" Maximum="100" Height="6"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Progress, Converter={StaticResource ProgressPercent}}"
                                                       Foreground="#C7CDD6" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Foreground="#8A93A0" FontSize="12">
                                            <Run Text="{Binding TaskDone, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TaskTotal, Mode=OneWay}"/><Run Text=" công việc hoàn thành"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Cột phải: Hoạt động gần đây + Ứng viên tiềm năng ===== -->
            <StackPanel Grid.Column="2">

                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Hoạt động gần đây" Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:RecentActivityModel}">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                Background="{Binding AccentColor, Converter={StaticResource BrushFromHex}}"
                                                Opacity="0.2" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding IconSymbol, Converter={StaticResource SymbolFromString}}"
                                                       FontSize="14" Foreground="{Binding AccentColor, Converter={StaticResource BrushFromHex}}"
                                                       HorizontalAlignment="Left" Margin="9,9,0,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#8A93A0" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,4"/>
                                            <TextBlock Text="{Binding Time, Converter={StaticResource RelativeTime}}"
                                                       Foreground="#5C6370" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ứng viên tiềm năng" Foreground="White"
                                       FontSize="16" FontWeight="SemiBold"/>
                            <ui:Button Grid.Column="1" Content="Xem tất cả" Appearance="Transparent" Height="28"
                                       Command="{Binding DataContext.CandidateCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TopCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TopCandidateSummary}">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding JobTitle}" Foreground="#8A93A0" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="10" Padding="8,3" Background="#1E3A2A"
                                                VerticalAlignment="Center">
                                            <TextBlock Foreground="#3FD07A" FontSize="12" FontWeight="SemiBold">
                                                <Run Text="{Binding MatchScore, StringFormat='{}{0:0}%'}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ===== Overlay: loading ===== -->
        <Border Grid.RowSpan="4" Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>