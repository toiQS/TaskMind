<Page x:Class="TaskMind.WPFs.Modules.Auths.Views.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Auths.Views"
      xmlns:authVM="clr-namespace:TaskMind.WPFs.Modules.Auths.ViewModels"
      mc:Ignorable="d" 
      
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">
    <Page.DataContext>
        <authVM:AuthNavigationVM/>
    </Page.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Cột trái: Logo / Branding -->
        <Border Grid.Column="0" Background="#20242A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Images/logo.png" Height="180" Width="180" Margin="0,0,0,20"/>
                <TextBlock Text="TaskMind" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Quản lý công việc thông minh" Foreground="#8A93A0" FontSize="14"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <!-- Nút thoát hệ thống -->
                <Button Style="{StaticResource ExitApp}"
                        Margin="5"
                        Click="ExitApp_Click"
                        ToolTip="Thoát ứng dụng"/>
            </Grid>
            <ContentControl Grid.Row="1" x:Name="AuthPages" Content="{Binding AuthCurrentView}"/>
        </Grid>
    </Grid>
</Page>