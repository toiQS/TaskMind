<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.ProfitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Admins.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:FilterAppearanceConverter x:Key="FilterAppearance"/>
        <util:ProfitSourceToTextConverter x:Key="SourceText"/>
        <util:InvoiceStatusToBrushConverter x:Key="InvoiceBrush"/>
        <util:InvoiceStatusToTextConverter x:Key="InvoiceText"/>
        <util:CurrencyVndConverter x:Key="Vnd"/>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Width" Value="230"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FilterChip" TargetType="ui:Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TxRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SourceBadge" TargetType="Border">
            <Setter Property="Background" Value="#3A4149"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="InvoiceBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{Binding InvoiceStatus, Converter={StaticResource InvoiceBrush}}"/>
        </Style>

        <Style x:Key="IssueInvoiceBtnStyle" TargetType="ui:Button">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding InvoiceStatus}" Value="Pending">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quản lý lợi nhuận" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Doanh thu từ phí giao dịch và phí tham gia hệ thống" Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Content="Làm mới"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshCommand}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Stat cards -->
                <ItemsControl Grid.Row="1" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Tổng doanh thu" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Summary.TotalRevenue, Converter={StaticResource Vnd}}" Style="{StaticResource StatValue}"/>
                                <TextBlock Foreground="#3FD07A" FontSize="12" Margin="0,2,0,0">
                                    <Run Text="+"/><Run Text="{Binding Summary.GrowthPercent, Mode=OneWay}"/><Run Text="% so với kỳ trước"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Phí giao dịch trao đổi" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Summary.TransactionFeeRevenue, Converter={StaticResource Vnd}}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Nguồn thu 1 · mục 4.14" Foreground="#8A93A0" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Phí tham gia hệ thống" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Summary.MembershipFeeRevenue, Converter={StaticResource Vnd}}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Nguồn thu 2 · Company/School" Foreground="#8A93A0" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                    </ItemsControl.Items>
                </ItemsControl>

                <!-- Biểu đồ doanh thu theo tháng -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Doanh thu theo tháng" Style="{StaticResource SectionTitle}"/>

                        <Viewbox Grid.Row="1" Stretch="Fill">
                            <Canvas Width="600" Height="160">
                                <Path Data="{Binding ChartGeometry}"
                                      Stroke="#4C9AFF"
                                      StrokeThickness="3"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding RevenueChart}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Foreground="#8A93A0" FontSize="11" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Filter theo nguồn thu -->
                <Grid Grid.Row="3" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource FilterChip}" Content="Tất cả"
                                   Command="{Binding FilterSourceCommand}" CommandParameter="All"
                                   Appearance="{Binding SourceFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=All}"/>
                        <ui:Button Style="{StaticResource FilterChip}" Content="Phí giao dịch"
                                   Command="{Binding FilterSourceCommand}" CommandParameter="TransactionFee"
                                   Appearance="{Binding SourceFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=TransactionFee}"/>
                        <ui:Button Style="{StaticResource FilterChip}" Content="Phí thành viên"
                                   Command="{Binding FilterSourceCommand}" CommandParameter="MembershipFee"
                                   Appearance="{Binding SourceFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=MembershipFee}"/>
                    </StackPanel>

                    <ui:TextBox Grid.Column="1"
                                Width="240"
                                HorizontalAlignment="Right"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm theo đối tác..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- Danh sách giao dịch -->
                <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Giao dịch gần đây" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding TransactionsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TxRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PartnerName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Date, StringFormat='dd/MM/yyyy'}" Foreground="#8A93A0" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Style="{StaticResource SourceBadge}" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Source, Converter={StaticResource SourceText}}"
                                                           Foreground="#DBDBDB" FontSize="11"/>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding Amount, Converter={StaticResource Vnd}}"
                                                       Foreground="#3FD07A" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <Border Grid.Column="3" Style="{StaticResource InvoiceBadge}" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding InvoiceStatus, Converter={StaticResource InvoiceText}}"
                                                           Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>

                                            <ui:Button Grid.Column="4" Style="{StaticResource IssueInvoiceBtnStyle}"
                                                       Content="Xuất hoá đơn" Appearance="Primary" Height="32" Margin="0,0,8,0"
                                                       Command="{Binding DataContext.IssueInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>

                                            <ui:Button Grid.Column="5" Appearance="Secondary" Height="32" Width="32"
                                                       Icon="{ui:SymbolIcon Document24}"
                                                       ToolTip="Xem chi tiết hoá đơn"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Overlay loading -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>