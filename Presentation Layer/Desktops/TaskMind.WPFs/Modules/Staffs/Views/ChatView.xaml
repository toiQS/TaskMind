<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             xmlns:sharedUtil="clr-namespace:TaskMind.WPFs.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <util:ConversationTypeToTextConverter x:Key="TypeText"/>
        <util:ConversationTypeToBrushConverter x:Key="TypeBrush"/>
        <util:ConversationTypeToIconConverter x:Key="TypeIcon"/>
        <util:IsMineToAlignmentConverter x:Key="MineAlign"/>
        <util:IsMineToBrushConverter x:Key="MineBrush"/>
        <util:IsMineToCornerRadiusConverter x:Key="MineCorner"/>
        <util:MessageStatusToTextConverter x:Key="StatusText"/>
        <util:MessageStatusToIconConverter x:Key="StatusIcon"/>
        <util:ChatTimeToTextConverter x:Key="ChatTime"/>
        <util:OnlineToVisibilityConverter x:Key="OnlineVisible"/>

        <!-- Dùng lại converter so khớp enum hiện có của dự án (giống ProfileView.xaml) để hiện/ẩn theo ConversationType -->
        <sharedUtil:EnumToVisibilityConverter x:Key="TypeEquals"/>

        <Style x:Key="StatCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <!-- Avatar tròn dùng chung cho hội thoại/thành viên/liên hệ -->
        <Style x:Key="AvatarStyle" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="#3E434A"/>
        </Style>

        <!-- Card hội thoại trong danh sách bên trái: viền xanh + nền sáng hơn khi đang được chọn -->
        <Style x:Key="ConversationCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1E2A3A"/>
                    <Setter Property="BorderBrush" Value="#2A3A52"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dòng liên hệ trong picker "Bắt đầu hội thoại mới": nền xanh khi đã chọn -->
        <Style x:Key="ContactRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#282D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1E2A3A"/>
                    <Setter Property="BorderBrush" Value="#4C9AFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="600"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Trò chuyện nội bộ" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Hội thoại riêng và nhóm với đồng nghiệp cùng công ty"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,10,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Secondary"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Làm mới"/>
                        <ui:Button Content="Cuộc trò chuyện mới"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding OpenNewConversationCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Thẻ thống kê nhanh ===== -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Chưa đọc" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding TotalUnreadCount, Mode=OneWay}" Foreground="#FF6B6B" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Hội thoại cá nhân" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding DirectCount, Mode=OneWay}" Foreground="#4C9AFF" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Hội thoại nhóm" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding GroupCount, Mode=OneWay}" Foreground="#9A7BFF" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                </WrapPanel>

                <!-- ===== Tìm kiếm + bộ lọc loại ===== -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBox Grid.Row="0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm theo tên hoặc nội dung tin nhắn..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Width="340" HorizontalAlignment="Left"
                                Height="40" Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                                   Command="{Binding SetTypeFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Cá nhân"
                                   Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:ConversationType.Direct}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Nhóm"
                                   Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:ConversationType.Group}"/>
                        <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="36"
                                   Command="{Binding ClearFilterCommand}"/>
                    </WrapPanel>
                </Grid>

                <!-- ===== Danh sách hội thoại (trái) + khung chat (phải) ===== -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" MinWidth="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== Cột trái: danh sách hội thoại ===== -->
                    <Border Grid.Column="0" Background="#20242A" CornerRadius="10" Padding="12">
                        <Grid>
                            <!-- Trạng thái rỗng -->
                            <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center"
                                        Visibility="{Binding FilteredConversations.Count, Converter={StaticResource ZeroCountVisible}}">
                                <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="40" Foreground="#3A4149" HorizontalAlignment="Center"/>
                                <TextBlock Text="Không có hội thoại phù hợp" Foreground="#8A93A0" FontSize="13" Margin="0,12,0,0"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredConversations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ConversationModel}">
                                            <Border Style="{StaticResource ConversationCardStyle}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenConversationCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Avatar + chấm trực tuyến -->
                                                    <Grid Grid.Column="0" Margin="0,0,12,0">
                                                        <Border Style="{StaticResource AvatarStyle}">
                                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Width="12" Height="12" CornerRadius="6" Background="#3FD07A"
                                                                BorderBrush="#20242A" BorderThickness="2"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Visibility="{Binding IsOnline, Converter={StaticResource OnlineVisible}}"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                                                                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding LastMessageTime, Converter={StaticResource ChatTime}}"
                                                                       Foreground="#8A93A0" FontSize="11" Margin="8,0,0,0"/>
                                                        </Grid>

                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding LastMessage}" Foreground="#8A93A0"
                                                                       FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="1" CornerRadius="9" Background="#4C9AFF"
                                                                    MinWidth="18" Height="18" Margin="8,0,0,0"
                                                                    Visibility="{Binding HasUnread, Converter={StaticResource B2V}}">
                                                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10.5"
                                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Margin="5,0"/>
                                                            </Border>
                                                        </Grid>

                                                        <Border CornerRadius="8" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                                Background="{Binding Type, Converter={StaticResource TypeBrush}}"
                                                                Visibility="{Binding Type, Converter={StaticResource TypeEquals}, ConverterParameter=Group}">
                                                            <TextBlock Text="{Binding MembersDisplay}" Foreground="White" FontSize="10"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ===== Cột phải: khung chat ===== -->
                    <Border Grid.Column="2" Background="#20242A" CornerRadius="10"
                            Visibility="{Binding HasSelectedConversation, Converter={StaticResource B2V}}">
                        <Grid DataContext="{Binding SelectedConversation}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header hội thoại -->
                            <Border Grid.Row="0" BorderBrush="#3A4149" BorderThickness="0,0,0,1" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="0,0,12,0">
                                        <Border Style="{StaticResource AvatarStyle}">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="12" Height="12" CornerRadius="6" Background="#3FD07A"
                                                BorderBrush="#20242A" BorderThickness="2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Visibility="{Binding IsOnline, Converter={StaticResource OnlineVisible}}"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MembersDisplay}" Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Border CornerRadius="10" Padding="9,4" Margin="0,0,10,0"
                                                Background="{Binding Type, Converter={StaticResource TypeBrush}}">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TypeText}}"
                                                       Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Height="32" Width="32"
                                                   Command="{Binding DataContext.CloseConversationCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Danh sách tin nhắn -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ChatMessageModel}">
                                            <Grid Margin="0,0,0,14" HorizontalAlignment="{Binding IsMine, Converter={StaticResource MineAlign}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar cho tin của người khác -->
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                                        Background="#3E434A" Margin="0,0,8,0" VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsMine, Converter={StaticResource InverseB2V}}">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" MaxWidth="420">
                                                    <TextBlock Text="{Binding SenderName}" Foreground="#8A93A0" FontSize="11"
                                                               Margin="4,0,4,4"
                                                               Visibility="{Binding IsMine, Converter={StaticResource InverseB2V}}"/>

                                                    <Border Padding="14,10"
                                                            Background="{Binding IsMine, Converter={StaticResource MineBrush}}"
                                                            CornerRadius="{Binding IsMine, Converter={StaticResource MineCorner}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Content}" Foreground="White" FontSize="13.5"
                                                                       TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding SentTime, Converter={StaticResource ChatTime}}"
                                                                           Foreground="#D8E3F0" FontSize="10" Opacity="0.85"/>
                                                                <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusIcon}}"
                                                                               FontSize="11" Foreground="#D8E3F0" Margin="5,0,0,0" Opacity="0.85"
                                                                               ToolTip="{Binding Status, Converter={StaticResource StatusText}}"
                                                                               Visibility="{Binding IsMine, Converter={StaticResource B2V}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Ô nhập tin nhắn -->
                            <Grid Grid.Row="2" Margin="20,0,20,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:TextBox Grid.Column="0"
                                            PlaceholderText="Nhập tin nhắn..."
                                            Text="{Binding DataContext.MessageInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                            Height="46">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Return"
                                                    Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>

                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                           Height="46" Width="54"
                                           Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Trạng thái rỗng khi chưa chọn hội thoại -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoSelectedConversation, Converter={StaticResource B2V}}">
                        <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="46" Foreground="#3A4149" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một hội thoại để bắt đầu trò chuyện" Foreground="#8A93A0" FontSize="14" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: bắt đầu hội thoại mới ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding IsStartingNew, Converter={StaticResource B2V}}">
            <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="1" CornerRadius="12"
                    Width="480" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="24,22,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonAdd24" FontSize="20" Foreground="#4C9AFF" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Cuộc trò chuyện mới" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Chọn 1 người để trò chuyện riêng, hoặc nhiều người để tạo nhóm"
                                           Foreground="#8A93A0" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                   Command="{Binding CloseNewConversationCommand}"/>
                    </Grid>

                    <!-- Nội dung: tìm kiếm + danh sách liên hệ -->
                    <StackPanel Grid.Row="1" Margin="24,0,24,0">

                        <!-- Thông báo lỗi -->
                        <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                                Visibility="{Binding NewConversationError, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding NewConversationError}" Foreground="#FF8A8A" FontSize="12.5" TextWrapping="Wrap"/>
                        </Border>

                        <ui:TextBox Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Tìm đồng nghiệp theo tên hoặc chức danh..."
                                    Text="{Binding ContactSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Height="42" Margin="0,0,0,14"/>

                        <!-- Tên nhóm: chỉ hiện khi chọn từ 2 người trở lên -->
                        <StackPanel Margin="0,0,0,14"
                                    Visibility="{Binding RequiresGroupName, Converter={StaticResource B2V}}">
                            <TextBlock Text="Tên nhóm *" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                            <ui:TextBox Icon="{ui:SymbolIcon PeopleTeam24}"
                                        PlaceholderText="VD: Team ERP nội bộ"
                                        Text="{Binding GroupNameInput, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Danh bạ đồng nghiệp" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Foreground="#4C9AFF" FontSize="12.5" FontWeight="SemiBold">
                                <Run Text="Đã chọn "/><Run Text="{Binding SelectedContactCount, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Danh sách liên hệ (cuộn) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,90,24,0"
                                  Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Không tìm thấy đồng nghiệp phù hợp" Foreground="#8A93A0" FontSize="12.5"
                                       HorizontalAlignment="Center" Margin="0,30,0,0"
                                       Visibility="{Binding FilteredContacts.Count, Converter={StaticResource ZeroCountVisible}}"/>

                            <ItemsControl ItemsSource="{Binding FilteredContacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ContactOption}">
                                        <Border Style="{StaticResource ContactRowStyle}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ToggleContactCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                                    <Border Width="38" Height="38" CornerRadius="19" Background="#3E434A">
                                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Width="11" Height="11" CornerRadius="6" Background="#3FD07A"
                                                            BorderBrush="#282D33" BorderThickness="2"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Visibility="{Binding IsOnline, Converter={StaticResource OnlineVisible}}"/>
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                                                    <TextBlock Foreground="#8A93A0" FontSize="11.5" Margin="0,2,0,0">
                                                        <Run Text="{Binding Position, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Department, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <ui:SymbolIcon Grid.Column="2" Symbol="CheckmarkCircle24" FontSize="20"
                                                               Foreground="#4C9AFF" VerticalAlignment="Center"
                                                               Visibility="{Binding IsSelected, Converter={StaticResource B2V}}"/>
                                                <ui:SymbolIcon Grid.Column="2" Symbol="Circle24" FontSize="20"
                                                               Foreground="#5C6370" VerticalAlignment="Center"
                                                               Visibility="{Binding IsSelected, Converter={StaticResource InverseB2V}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="24,16,24,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="Huỷ" Appearance="Transparent" Height="42"
                                   Command="{Binding CloseNewConversationCommand}"/>

                        <ui:Button Grid.Column="2" Content="Bắt đầu trò chuyện" Icon="{ui:SymbolIcon Send24}"
                                   Appearance="Primary" Height="42" Width="180" FontWeight="SemiBold"
                                   Command="{Binding StartConversationCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
