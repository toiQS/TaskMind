<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.SkillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Admins.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Admins.Models"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:FilterAppearanceConverter x:Key="FilterAppearance"/>
        <util:SkillCategoryToTextConverter x:Key="CategoryText"/>
        <util:SkillLevelToTextConverter x:Key="LevelText"/>
        <util:SkillLevelToBrushConverter x:Key="LevelBrush"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FilterChip" TargetType="ui:Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Chip hiển thị 1 kỹ năng trong danh mục chính thức -->
        <Style x:Key="SkillChip" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="LevelDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Fill" Value="{Binding Level, Converter={StaticResource LevelBrush}}"/>
        </Style>

        <!-- Thẻ đề xuất chờ duyệt -->
        <Style x:Key="PendingRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Group header cho từng Category -->
        <Style x:Key="GroupHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4C9AFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        
        <!-- Icon-only action button (dùng thay ui:Button để tránh lỗi PressedForeground khi Content rỗng trong DataTemplate) -->
        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A4149"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4C525A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quản lý kỹ năng" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Danh mục kỹ năng chuẩn hoá toàn hệ thống" Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ui:TextBox Grid.Column="1"
                                Width="240"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm kỹ năng..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>

                    <ui:Button Grid.Column="2"
                               Content="Thêm kỹ năng"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Add24}"
                               Command="{Binding ToggleAddPanelCommand}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Panel thêm kỹ năng mới -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}"
                        Visibility="{Binding IsAddPanelOpen, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="Thêm kỹ năng mới" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        PlaceholderText="Tên kỹ năng (vd: TypeScript)"
                                        Height="42"
                                        Text="{Binding NewSkillName, UpdateSourceTrigger=PropertyChanged}"/>

                            <ComboBox Grid.Column="2" Height="42"
                                      ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding NewSkillCategory}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource CategoryText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox Grid.Column="4" Height="42"
                                      ItemsSource="{Binding LevelOptions}"
                                      SelectedItem="{Binding NewSkillLevel}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LevelText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ui:Button Grid.Column="6" Content="Lưu" Appearance="Primary"
                                       Height="42" Width="90"
                                       Command="{Binding AddSkillCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Đề xuất chờ duyệt -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}"
                        Visibility="{Binding PendingSkillsView.Count, Converter={StaticResource B2V}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Đề xuất chờ duyệt"/>
                            <Run Text="(" Foreground="#8A93A0"/><Run Text="{Binding PendingSkillsView.Count, Mode=OneWay}" Foreground="#8A93A0"/><Run Text=")" Foreground="#8A93A0"/>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding PendingSkillsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SkillModel}">
                                    <Border Style="{StaticResource PendingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource LevelDot}"/>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Category, Converter={StaticResource CategoryText}}"
                                                           Foreground="#8A93A0" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SuggestedBy, StringFormat='· Đề xuất bởi {0}'}"
                                                           Foreground="#8A93A0" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ui:Button Content="Chi tiết" Appearance="Secondary" Height="30" Margin="0,0,8,0"
                                                           Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="Duyệt" Appearance="Primary" Height="30" Margin="0,0,8,0"
                                                           Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="Từ chối" Appearance="Danger" Height="30"
                                                           Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Filter chips theo nhóm kỹ năng -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
                    <ui:Button Style="{StaticResource FilterChip}" Content="Tất cả"
                               Command="{Binding FilterCommand}" CommandParameter="All"
                               Appearance="{Binding CategoryFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=All}"/>
                    <ui:Button Style="{StaticResource FilterChip}" Content="Ngôn ngữ lập trình"
                               Command="{Binding FilterCommand}" CommandParameter="ProgrammingLanguage"
                               Appearance="{Binding CategoryFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=ProgrammingLanguage}"/>
                    <ui:Button Style="{StaticResource FilterChip}" Content="Framework"
                               Command="{Binding FilterCommand}" CommandParameter="Framework"
                               Appearance="{Binding CategoryFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Framework}"/>
                    <ui:Button Style="{StaticResource FilterChip}" Content="Kỹ năng mềm"
                               Command="{Binding FilterCommand}" CommandParameter="SoftSkill"
                               Appearance="{Binding CategoryFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=SoftSkill}"/>
                    <ui:Button Style="{StaticResource FilterChip}" Content="Công cụ"
                               Command="{Binding FilterCommand}" CommandParameter="Tool"
                               Appearance="{Binding CategoryFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Tool}"/>
                </StackPanel>

                <!-- Danh mục kỹ năng chính thức, nhóm theo Category -->
                <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Danh mục kỹ năng" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding SkillsView}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource GroupHeaderText}"
                                                       Text="{Binding Name, Converter={StaticResource CategoryText}}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SkillModel}">
                                    <Border Style="{StaticResource SkillChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource LevelDot}"/>
                                            <TextBlock Text="{Binding Name}" Foreground="#DBDBDB" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Level, Converter={StaticResource LevelText}}"
                                                       Foreground="#8A93A0" FontSize="11" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource IconActionButton}" Margin="0,0,4,0"
                                                    ToolTip="Xem chi tiết"
                                                    Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="#8A93A0"/>
                                            </Button>
                                            <Button Style="{StaticResource IconActionButton}"
                                                    ToolTip="Xoá"
                                                    Command="{Binding DataContext.DeleteSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#8A93A0"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Overlay loading -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>