            <Grid>
                <!--button đăng xuât hệ thông--> 
                <!--button thoát và đăng xuất hệ thống-->
            </Grid>
            
        </StackPanel>
        
          
        <ContentControl Grid.Column="1" Content="{Binding AdminCurrentView}" x:Name="AdminPages"/>
        
