<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.AddSupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="560">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <util:SupportCategoryToTextConverter x:Key="CategoryText"/>
        <util:TodoPriorityToTextConverter x:Key="PriorityText"/>

        <ObjectDataProvider x:Key="SupportCategoryValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SupportCategory"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="TodoPriorityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TodoPriority"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="1" CornerRadius="12"
            Width="560" MaxHeight="700">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="28,24,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ChatHelp24" FontSize="20" Foreground="#4C9AFF" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Tạo yêu cầu hỗ trợ" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Gửi yêu cầu hỗ trợ đến Admin công ty" Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                           Command="{Binding CancelCommand}"/>
            </Grid>

            <!-- ===== Form ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,8">
                <StackPanel>

                    <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Tiêu đề *" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox Icon="{ui:SymbolIcon TextBulletListSquare24}"
                                PlaceholderText="VD: Không đăng nhập được sau khi đổi mật khẩu"
                                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                Height="42" Margin="0,0,0,16"/>

                    <TextBlock Text="Mô tả chi tiết *" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                PlaceholderText="Mô tả vấn đề bạn đang gặp phải..."
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nhóm yêu cầu" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Height="42"
                                      ItemsSource="{Binding Source={StaticResource SupportCategoryValues}}"
                                      SelectedItem="{Binding Category}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource CategoryText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mức độ ưu tiên" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Height="42"
                                      ItemsSource="{Binding Source={StaticResource TodoPriorityValues}}"
                                      SelectedItem="{Binding Priority}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PriorityText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== Footer ===== -->
            <Grid Grid.Row="2" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Huỷ" Appearance="Transparent" Height="42"
                           Command="{Binding CancelCommand}"/>

                <ui:Button Grid.Column="2" Content="Gửi yêu cầu" Icon="{ui:SymbolIcon Send24}"
                           Appearance="Primary" Height="42" Width="160" FontWeight="SemiBold"
                           Command="{Binding SaveCommand}"/>
            </Grid>

            <!-- ===== Overlay: đang gửi ===== -->
            <Border Grid.RowSpan="3" Background="#902B3036" CornerRadius="12"
                    Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                <ui:ProgressRing IsIndeterminate="True" Width="38" Height="38"/>
            </Border>
        </Grid>
    </Border>
</UserControl>