<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:ChatPartnerTypeToTextConverter x:Key="PartnerTypeText"/>
        <util:BoolToAlignmentConverter x:Key="BubbleAlign"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="AvatarCircle" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="Background" Value="#3A4149"/>
        </Style>

        <Style x:Key="OnlineDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#3FD07A"/>
            <Setter Property="Stroke" Value="#2B3036"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <Style x:Key="UnreadBadge" TargetType="Border">
            <Setter Property="Background" Value="#4C9AFF"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>

        <!-- Item hội thoại trong ListBox -->
        <Style x:Key="ConversationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#20242A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33445566"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bong bóng chat -->
        <Style x:Key="BubbleStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="Background" Value="#20242A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter Property="Background" Value="#4C9AFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BubbleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBDBDB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Danh sách hội thoại ===== -->
        <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Hỗ trợ &amp; Tin nhắn" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

                <ui:TextBox Grid.Row="1"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Tìm hội thoại..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Height="40" Margin="0,0,0,12"/>

                <ListBox Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ConversationItemStyle}"
                         ItemsSource="{Binding ConversationsView}"
                         SelectedItem="{Binding SelectedConversation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Border Style="{StaticResource AvatarCircle}">
                                        <TextBlock Text="{Binding PartnerName[0]}"
                                                   Foreground="White" FontWeight="Bold" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Style="{StaticResource OnlineDot}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Visibility="{Binding IsOnline, Converter={StaticResource B2V}}"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PartnerName}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding LastMessage}" Foreground="#8A93A0" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource UnreadBadge}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding UnreadCount, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== Khung chat ===== -->
        <Border Grid.Column="2" Style="{StaticResource SectionCard}"
                Visibility="{Binding HasSelectedConversation, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header đối phương -->
                <Border Grid.Row="0" Padding="20,16" BorderBrush="#20242A" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource AvatarCircle}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SelectedConversation.PartnerName[0]}"
                                       Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedConversation.PartnerName}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedConversation.PartnerType, Converter={StaticResource PartnerTypeText}}"
                                       Foreground="#8A93A0" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tin nhắn -->
                <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <ItemsControl ItemsSource="{Binding SelectedConversation.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="{Binding IsMine, Converter={StaticResource BubbleAlign}}">
                                    <Border Style="{StaticResource BubbleStyle}">
                                        <TextBlock Style="{StaticResource BubbleText}" Text="{Binding Content}"/>
                                    </Border>
                                    <TextBlock Text="{Binding SentAt, StringFormat='HH:mm'}"
                                               Foreground="#8A93A0" FontSize="10"
                                               HorizontalAlignment="{Binding IsMine, Converter={StaticResource BubbleAlign}}"
                                               Margin="4,0,4,10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Ô nhập -->
                <Grid Grid.Row="2" Margin="20,12,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                Height="44"
                                PlaceholderText="Nhập tin nhắn..."
                                Text="{Binding NewMessageText, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <ui:Button Grid.Column="2"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Send24}"
                               Width="44" Height="44"
                               Command="{Binding SendMessageCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Chưa chọn hội thoại -->
        <Border Grid.Column="2" Style="{StaticResource SectionCard}"
                Visibility="{Binding HasSelectedConversation, Converter={StaticResource B2V}, ConverterParameter=Invert}">
            <TextBlock Text="Chọn một hội thoại để bắt đầu" Foreground="#8A93A0" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>