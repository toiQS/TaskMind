<Window x:Class="TaskMind.WPFs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskMind.WPFs"
        xmlns:vm="clr-namespace:TaskMind.WPFs.Modules.Auths.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        MinHeight="400"
        MinWidth="600"
        Height="700" Width="1350">

    <Window.DataContext>
        <vm:NavigationVM />
    </Window.DataContext>
    <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="5" CornerRadius="8,8,0,8">
        <Grid Margin="5">
            <ContentControl x:Name="Pages" Margin="10" 
                                Content="{Binding CurrentView}"/>
        </Grid>
    </Border>
</Window>
