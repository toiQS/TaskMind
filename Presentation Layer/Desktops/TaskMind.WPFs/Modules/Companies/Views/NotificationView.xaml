<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Companies.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>

        <util:NotificationTypeToTextConverter x:Key="TypeText"/>
        <util:NotificationTypeToIconConverter x:Key="TypeIcon"/>
        <util:NotificationTypeToBrushConverter x:Key="TypeBrush"/>
        <util:UnreadToFontWeightConverter x:Key="UnreadWeight"/>
        <util:UnreadToVisibilityConverter x:Key="UnreadDot"/>
        <util:NotificationFilterActiveConverter x:Key="FilterActive"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <!-- Tái sử dụng converter chung đã có ở DashbroadConverters -->
        <util:StringToSymbolConverter x:Key="SymbolFromString"/>
        <util:RelativeTimeConverter x:Key="RelativeTime"/>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <!-- Card thông báo: nền nổi bật hơn khi chưa đọc -->
        <Style x:Key="NotificationCardStyle" TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter Property="BorderBrush" Value="#2A3A52"/>
                    <Setter Property="Background" Value="#20242E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT CHÍNH: danh sách thông báo ================= -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Thông báo" Foreground="White" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border CornerRadius="10" Padding="9,3" Margin="12,0,0,0" Background="#FF4C5C" VerticalAlignment="Center"
                            Visibility="{Binding HasUnread, Converter={StaticResource B2V}}">
                        <TextBlock Foreground="White" FontSize="12" FontWeight="Bold">
                            <Run Text="{Binding UnreadCount, Mode=OneWay}"/><Run Text=" chưa đọc"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Đánh dấu tất cả đã đọc" Appearance="Secondary" Height="38" Margin="0,0,10,0"
                               Visibility="{Binding HasUnread, Converter={StaticResource B2V}}"
                               Command="{Binding MarkAllAsReadCommand}"/>
                    <ui:Button Icon="{ui:SymbolIcon Settings24}" Appearance="Secondary" Height="38" Width="38" Margin="0,0,10,0"
                               ToolTip="Tuỳ chọn nhận thông báo"
                               Command="{Binding ToggleSettingsCommand}"/>
                    <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary" Height="38" Width="38"
                               ToolTip="Làm mới"
                               Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ===== Tìm kiếm ===== -->
            <ui:TextBox Grid.Row="1" Width="340" HorizontalAlignment="Left"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="Tìm theo tiêu đề hoặc nội dung..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Height="40" Margin="0,0,0,14"/>

            <!-- ===== Bộ lọc: trạng thái đọc + loại thông báo ===== -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                               Command="{Binding SetUnreadOnlyCommand}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Chưa đọc"
                               Command="{Binding SetUnreadOnlyCommand}" CommandParameter="{x:Static sys:Boolean.TrueString}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đã đọc"
                               Command="{Binding SetUnreadOnlyCommand}" CommandParameter="{x:Static sys:Boolean.FalseString}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả loại"
                               Command="{Binding SetTypeFilterCommand}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Mời dự án"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.ProjectInvitation}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Mời công ty"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.CompanyInvitation}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Kết quả kiểm tra"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.TestResult}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Phê duyệt hồ sơ"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.ProfileApproval}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tuyển dụng"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.Recruitment}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Hỗ trợ"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.Support}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Hệ thống"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.System}"/>
                    <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="34"
                               Command="{Binding ClearFilterCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== Danh sách thông báo ===== -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Trạng thái rỗng -->
                    <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding FilteredNotifications.Count, Converter={StaticResource ZeroCountVisible}}">
                        <ui:SymbolIcon Symbol="Alert24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                        <TextBlock Text="Không có thông báo phù hợp" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding FilteredNotifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NotificationModel}">
                                <ui:Card Style="{StaticResource NotificationCardStyle}">
                                    <ui:Card.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenNotificationCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </ui:Card.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon loại thông báo -->
                                        <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Top">
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    Background="{Binding Type, Converter={StaticResource TypeBrush}}" Opacity="0.18"/>
                                            <ui:SymbolIcon Symbol="{Binding Type, Converter={StaticResource TypeIcon}}"
                                                           FontSize="18" Foreground="{Binding Type, Converter={StaticResource TypeBrush}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Nội dung -->
                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#4C9AFF" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsRead, Converter={StaticResource UnreadDot}}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White"
                                                           FontSize="14.5" FontWeight="{Binding IsRead, Converter={StaticResource UnreadWeight}}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                            <TextBlock Text="{Binding Message}" Foreground="#C7CDD6" FontSize="13"
                                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="10" Padding="8,3" Margin="0,0,8,0"
                                                        Background="{Binding Type, Converter={StaticResource TypeBrush}}" Opacity="0.9">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource TypeText}}"
                                                               Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding CreatedDate, Converter={StaticResource RelativeTime}}"
                                                           Foreground="#8A93A0" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ui:SymbolIcon Symbol="Mail24" FontSize="12" Foreground="#5C6370" VerticalAlignment="Center"
                                                               Visibility="{Binding SentByEmail, Converter={StaticResource B2V}}"
                                                               ToolTip="Đã gửi qua email"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Hành động nhanh -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <ui:Button Icon="{ui:SymbolIcon Checkmark24}" Appearance="Transparent" Height="30" Width="30"
                                                       ToolTip="Đánh dấu đã đọc" Margin="0,0,4,0"
                                                       Visibility="{Binding IsRead, Converter={StaticResource InverseB2V}}"
                                                       Command="{Binding DataContext.MarkAsReadCommand,
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Height="30" Width="30"
                                                       ToolTip="Xoá thông báo"
                                                       Command="{Binding DataContext.DeleteCommand,
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= PANEL CÀI ĐẶT: tuỳ chọn kênh nhận theo loại (mục 5.3) ================= -->
        <Border Grid.Column="1" Width="360" Background="#20242A" CornerRadius="10" Padding="22"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tuỳ chọn thông báo" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                               Command="{Binding ToggleSettingsCommand}"/>
                </Grid>


                <TextBlock Grid.Row="1" Text="Chọn kênh nhận cho từng loại thông báo (mục 5.3)."
                           Foreground="#8A93A0" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,18"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Preferences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NotificationPreferenceModel}">
                                <Border Background="#282D33" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#8A93A0" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <ui:ToggleSwitch IsChecked="{Binding InAppEnabled}" OffContent="" OnContent=""/>
                                                <TextBlock Text="Trong ứng dụng" Foreground="#C7CDD6" FontSize="12"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ui:ToggleSwitch IsChecked="{Binding EmailEnabled}" OffContent="" OnContent=""/>
                                                <TextBlock Text="Email" Foreground="#C7CDD6" FontSize="12"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ui:Button Grid.Row="3" Content="Lưu tuỳ chọn" Appearance="Primary"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Height="44" FontWeight="SemiBold" Margin="0,16,0,0"
                           Command="{Binding SavePreferencesCommand}"/>
            </Grid>
        </Border>

        <!-- ===== Overlay: loading ===== -->
        <Border Grid.ColumnSpan="2" Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>
