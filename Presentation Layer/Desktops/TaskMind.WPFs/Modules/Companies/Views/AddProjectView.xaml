<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.AddProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Companies.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="680">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Tái sử dụng converter đã có -->
        <util:RoleToTextConverter x:Key="RoleText"/>
        <util:KindToExchangeVisibilityConverter x:Key="ExchangeVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <!-- Converter riêng cho AddProjectView -->
        <util:RoleToBrushConverter x:Key="RoleBrush"/>

        <ObjectDataProvider x:Key="ProjectRoleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ProjectRole"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Tab chọn Loại dự án: Nội bộ / Trao đổi -->
        <Style x:Key="KindTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <!-- Card chọn nhân sự: viền + nền nổi bật khi đã được thêm vào dự án -->
        <Style x:Key="StaffPickCardStyle" TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                    <Setter Property="BorderBrush" Value="#4C9AFF"/>
                    <Setter Property="Background" Value="#1E2A3A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chip thành viên đã chọn -->
        <Style x:Key="MemberChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#282D33"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <!-- Panel modal trung tâm: header cố định + form cuộn được + footer hành động cố định -->
    <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="1" CornerRadius="12"
            Width="680" MaxHeight="820">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="28,24,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Board24" FontSize="20" Foreground="#4C9AFF" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Tạo dự án mới" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Khởi tạo dự án và gán nhân sự công ty vào vai trò dự án (mục 4.7, mục 3, mục 4.5)"
                                   Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                           Command="{Binding CancelCommand}"/>
            </Grid>

            <!-- ===== Form (cuộn được) ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,8">
                <StackPanel>

                    <!-- Thông báo lỗi -->
                    <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Tên dự án *" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox Icon="{ui:SymbolIcon Board24}"
                                PlaceholderText="VD: Hệ thống quản lý kho v2"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                Height="42" Margin="0,0,0,16"/>

                    <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                PlaceholderText="Mục tiêu, phạm vi công việc của dự án..."
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,18"/>

                    <!-- ===== Loại dự án ===== -->
                    <TextBlock Text="Loại dự án" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Background="#20242A" CornerRadius="10" Padding="4"
                            HorizontalAlignment="Left" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon Home24}" Content="Nội bộ"
                                       Command="{Binding SetKindCommand}"
                                       CommandParameter="{x:Static models:ProjectKind.Internal}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource KindTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ProjectKind.Internal}">
                                                <Setter Property="Background" Value="#4C9AFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button Icon="{ui:SymbolIcon ArrowSwap24}" Content="Trao đổi" Margin="4,0,0,0"
                                       Command="{Binding SetKindCommand}"
                                       CommandParameter="{x:Static models:ProjectKind.Exchange}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource KindTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ProjectKind.Exchange}">
                                                <Setter Property="Background" Value="#4C9AFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- ===== Thông tin đối tác (chỉ hiện khi Kind = Exchange, liên kết mục 4.14) ===== -->
                    <Grid Margin="0,0,0,18" Visibility="{Binding Kind, Converter={StaticResource ExchangeVisible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tên đối tác *" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox Icon="{ui:SymbolIcon Building24}"
                                        PlaceholderText="VD: ABC Corp"
                                        Text="{Binding PartnerName, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Giá trị hợp đồng" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox Icon="{ui:SymbolIcon Money24}"
                                        PlaceholderText="VD: 350000000"
                                        Text="{Binding ContractValue, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Thời gian ===== -->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ngày bắt đầu" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding StartDate}" Height="42"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ngày kết thúc dự kiến" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding EndDate}" Height="42"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Chọn nhân sự công ty làm thành viên (mục 4.5 + mục 3 + mục 4.7) ===== -->
                    <TextBlock Text="Thêm thành viên từ nhân sự công ty" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Text="Chỉ nhân sự đang hoạt động của công ty mới có thể được gán vào dự án."
                               Foreground="#5C6370" FontSize="11.5" Margin="0,-4,0,10" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Tìm theo tên, chức danh hoặc kỹ năng..."
                                    Text="{Binding StaffSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Height="42"/>

                        <ComboBox Grid.Column="2" Height="42"
                                  ItemsSource="{Binding Source={StaticResource ProjectRoleValues}}"
                                  SelectedItem="{Binding MemberRoleInput}"
                                  ToolTip="Vai trò sẽ gán khi bấm chọn nhân sự bên dưới">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource RoleText}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Danh sách nhân sự để chọn -->
                    <Border Background="#20242A" CornerRadius="10" Padding="12" Margin="0,0,0,18" MinHeight="60">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding FilteredAvailableStaff}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectStaffOption}">
                                        <ui:Card Style="{StaticResource StaffPickCardStyle}">
                                            <ui:Card.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ToggleStaffMemberCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </ui:Card.InputBindings>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                        Background="#3E434A" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,2,0,4">
                                                        <Run Text="{Binding Position, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Department, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SkillsDisplay}" Foreground="#4C9AFF" FontSize="11.5"/>
                                                </StackPanel>

                                                <ui:SymbolIcon Grid.Column="2" Symbol="CheckmarkCircle24" FontSize="20"
                                                               Foreground="#4C9AFF" VerticalAlignment="Center"
                                                               Visibility="{Binding IsAdded, Converter={StaticResource B2V}}"/>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Không tìm thấy nhân sự phù hợp" Foreground="#8A93A0" FontSize="12.5"
                                       HorizontalAlignment="Center" Margin="0,10,0,10"
                                       Visibility="{Binding FilteredAvailableStaff.Count, Converter={StaticResource ZeroCountVisible}}"/>
                        </Grid>
                    </Border>

                    <!-- ===== Thành viên đã chọn ===== -->
                    <TextBlock Text="Thành viên dự án đã chọn" Style="{StaticResource FieldLabelStyle}"/>
                    <ItemsControl ItemsSource="{Binding Members}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ProjectMemberModel}">
                                <Border Style="{StaticResource MemberChipStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                                Background="#3E434A" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="White"
                                                   FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,3" Margin="8,0,8,0"
                                                Background="{Binding Role, Converter={StaticResource RoleBrush}}">
                                            <TextBlock Text="{Binding Role, Converter={StaticResource RoleText}}"
                                                       Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>

                                        <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                   Height="28" Width="28"
                                                   Command="{Binding DataContext.RemoveMemberCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Chưa có thành viên nào — bấm chọn nhân sự ở trên để thêm" Foreground="#8A93A0" FontSize="12.5"
                               Visibility="{Binding Members.Count, Converter={StaticResource ZeroCountVisible}}"
                               Margin="0,0,0,4"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== Footer ===== -->
            <Grid Grid.Row="2" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Huỷ" Appearance="Transparent" Height="42"
                           Command="{Binding CancelCommand}"/>

                <ui:Button Grid.Column="2" Content="Tạo dự án" Icon="{ui:SymbolIcon Add24}"
                           Appearance="Primary" Height="42" Width="150" FontWeight="SemiBold"
                           Command="{Binding CreateCommand}"/>
            </Grid>

            <!-- ===== Overlay: đang lưu ===== -->
            <Border Grid.RowSpan="3" Background="#902B3036" CornerRadius="12"
                    Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                <ui:ProgressRing IsIndeterminate="True" Width="38" Height="38"/>
            </Border>
        </Grid>
    </Border>
</UserControl>