<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <util:StatusToTextConverter x:Key="StatusText"/>
        <util:StatusToBrushConverter x:Key="StatusBrush"/>
        <util:KindToTextConverter x:Key="KindText"/>
        <util:KindToExchangeVisibilityConverter x:Key="ExchangeVisible"/>
        <util:RoleToTextConverter x:Key="RoleText"/>
        <util:RoleToBrushConverter x:Key="RoleBrush"/>
        <util:ProgressToPercentTextConverter x:Key="ProgressPercent"/>
        <util:TaskProgressToBrushConverter x:Key="TaskProgressBrush"/>
        <util:ProjectFilterActiveConverter x:Key="FilterActive"/>

        <Style x:Key="StatCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <!-- Badge loại dự án: đổi màu theo Kind -->
        <Style x:Key="KindBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#3A4149"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ProjectKind.Exchange}">
                    <Setter Property="Background" Value="#3A2E52"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card dự án: viền xanh khi đang tham gia (Ongoing), mờ hơn khi đã kết thúc -->
        <Style x:Key="ProjectCardStyle" TargetType="ui:Card">
            <Setter Property="Width" Value="340"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOngoing}" Value="True">
                    <Setter Property="BorderBrush" Value="#2A3A52"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ProjectStatus.Cancelled}">
                    <Setter Property="Opacity" Value="0.7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card thành viên: viền xanh khi IsMe = true để tự nhận ra mình trong danh sách -->
        <Style x:Key="MemberRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter Property="Background" Value="#1E2A3A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Grid gốc: ScrollViewer toàn trang + overlay (loading / chi tiết) nằm ngoài để luôn phủ kín
         màn hình dù đang cuộn tới đâu — theo đúng bố cục các màn danh sách dự án khác trong hệ thống. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dự án của tôi" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Các dự án trực thuộc công ty mà bạn đã hoặc đang tham gia (mục 3, 4.7)"/>
                        </TextBlock>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Làm mới"/>
                </Grid>

                <!-- ===== Thẻ thống kê nhanh ===== -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Đang tham gia" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding OngoingCount, Mode=OneWay}" Foreground="#4C9AFF" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Đã hoàn thành" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding CompletedCount, Mode=OneWay}" Foreground="#3FD07A" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Tổng số dự án" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding TotalCount, Mode=OneWay}" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                </WrapPanel>

                <!-- ===== Tìm kiếm + bộ lọc trạng thái ===== -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBox Grid.Row="0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm theo tên dự án..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Width="320" HorizontalAlignment="Left"
                                Height="40" Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                                   Command="{Binding SetStatusFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đang thực hiện"
                                   Command="{Binding SetStatusFilterCommand}"
                                   CommandParameter="{x:Static models:ProjectStatus.InProgress}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tạm dừng"
                                   Command="{Binding SetStatusFilterCommand}"
                                   CommandParameter="{x:Static models:ProjectStatus.Paused}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Hoàn thành"
                                   Command="{Binding SetStatusFilterCommand}"
                                   CommandParameter="{x:Static models:ProjectStatus.Completed}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đã huỷ"
                                   Command="{Binding SetStatusFilterCommand}"
                                   CommandParameter="{x:Static models:ProjectStatus.Cancelled}"/>
                        <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="36"
                                   Command="{Binding ClearFilterCommand}"/>
                    </WrapPanel>
                </Grid>

                <!-- ===== Trạng thái rỗng ===== -->
                <StackPanel Grid.Row="3" Margin="0,60,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding FilteredProjects.Count, Converter={StaticResource ZeroCountVisible}}">
                    <ui:SymbolIcon Symbol="Board24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                    <TextBlock Text="Không tìm thấy dự án phù hợp" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- ===== Danh sách dự án dạng card ===== -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding FilteredProjects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ProjectModel}">
                            <ui:Card Style="{StaticResource ProjectCardStyle}">
                                <ui:Card.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenDetailCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </ui:Card.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tên dự án + badge loại -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Style="{StaticResource KindBadgeStyle}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource KindText}}"
                                                       Foreground="#C7CDD6" FontSize="11"/>
                                        </Border>
                                    </Grid>

                                    <!-- Vai trò của tôi trong dự án -->
                                    <Border Grid.Row="1" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                            Background="{Binding MyRole, Converter={StaticResource RoleBrush}}" Margin="0,0,0,12">
                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                            <Run Text="Vai trò của bạn: "/><Run Text="{Binding MyRole, Converter={StaticResource RoleText}}"/>
                                        </TextBlock>
                                    </Border>

                                    <!-- Mô tả -->
                                    <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="#8A93A0"
                                               FontSize="12.5" TextWrapping="Wrap" MaxHeight="34"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

                                    <!-- Tiến độ tổng thể dự án -->
                                    <Grid Grid.Row="3" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tiến độ dự án" Foreground="#8A93A0" FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Progress, Converter={StaticResource ProgressPercent}}"
                                                   Foreground="#C7CDD6" FontSize="11.5" FontWeight="SemiBold"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="3" VerticalAlignment="Bottom" Value="{Binding Progress, Mode=OneWay}"
                                                 Minimum="0" Maximum="100" Height="6" Margin="0,18,0,10"/>

                                    <!-- Tiến độ công việc của riêng tôi -->
                                    <Grid Grid.Row="4" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="#8A93A0" FontSize="11.5" VerticalAlignment="Center">
                                            <Run Text="Việc của bạn: "/><Run Text="{Binding MyTaskDone, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding MyTaskTotal, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding MyProgress, Converter={StaticResource ProgressPercent}}"
                                                   Foreground="{Binding MyProgress, Converter={StaticResource TaskProgressBrush}}"
                                                   FontSize="11.5" FontWeight="SemiBold"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="4" VerticalAlignment="Bottom" Value="{Binding MyProgress, Mode=OneWay}"
                                                 Minimum="0" Maximum="100" Height="6" Margin="0,18,0,14"
                                                 Foreground="{Binding MyProgress, Converter={StaticResource TaskProgressBrush}}"/>

                                    <!-- Trạng thái dự án + số thành viên -->
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" HorizontalAlignment="Left" CornerRadius="10" Padding="8,3"
                                                Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                       Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="People24" FontSize="14" Foreground="#8A93A0" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Members.Count, Mode=OneWay}" Foreground="#8A93A0" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: chi tiết dự án ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding HasSelectedProject, Converter={StaticResource B2V}}">

            <Border Width="460" HorizontalAlignment="Right" Background="#282D33"
                    BorderBrush="#3A4149" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
                    <StackPanel DataContext="{Binding SelectedProject}">

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                                       FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}"
                                       Appearance="Transparent"
                                       Command="{Binding DataContext.CloseDetailCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                            <Border CornerRadius="10" Padding="9,4" Margin="0,0,8,0"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border CornerRadius="10" Padding="9,4" Margin="0,0,8,0" Background="#3A4149">
                                <TextBlock Text="{Binding Kind, Converter={StaticResource KindText}}"
                                           Foreground="#C7CDD6" FontSize="12"/>
                            </Border>
                            <Border CornerRadius="10" Padding="9,4"
                                    Background="{Binding MyRole, Converter={StaticResource RoleBrush}}">
                                <TextBlock Text="{Binding MyRole, Converter={StaticResource RoleText}}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Mô tả" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,0,0,22"/>

                        <TextBlock Text="Tiến độ tổng thể dự án" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Value="{Binding Progress, Mode=OneWay}"
                                         Minimum="0" Maximum="100" Height="8"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Progress, Converter={StaticResource ProgressPercent}}"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,4,0,22">
                            <Run Text="{Binding TaskDone, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TaskTotal, Mode=OneWay}"/><Run Text=" công việc hoàn thành (toàn dự án)"/>
                        </TextBlock>

                        <TextBlock Text="Công việc của bạn" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Value="{Binding MyProgress, Mode=OneWay}"
                                         Minimum="0" Maximum="100" Height="8"
                                         Foreground="{Binding MyProgress, Converter={StaticResource TaskProgressBrush}}"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding MyProgress, Converter={StaticResource ProgressPercent}}"
                                       Foreground="{Binding MyProgress, Converter={StaticResource TaskProgressBrush}}"
                                       FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,4,0,22">
                            <Run Text="{Binding MyTaskDone, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding MyTaskTotal, Mode=OneWay}"/><Run Text=" công việc được giao cho bạn"/>
                        </TextBlock>

                        <TextBlock Text="Thời gian" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#DBDBDB" FontSize="13" Margin="0,0,0,22">
                            <Run Text="Dự án bắt đầu: "/><Run Text="{Binding StartDate, StringFormat='dd/MM/yyyy'}"/>
                            <LineBreak/>
                            <Run Text="Dự án kết thúc: "/><Run Text="{Binding EndDate, StringFormat='dd/MM/yyyy', TargetNullValue='Chưa xác định'}"/>
                            <LineBreak/>
                            <Run Text="Bạn tham gia từ: "/><Run Text="{Binding MyJoinedDate, StringFormat='dd/MM/yyyy'}"/>
                        </TextBlock>

                        <!-- Thông tin đối tác (chỉ hiện với dự án trao đổi) -->
                        <StackPanel Visibility="{Binding Kind, Converter={StaticResource ExchangeVisible}}" Margin="0,0,0,22">
                            <TextBlock Text="Thông tin đối tác" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Foreground="#DBDBDB" FontSize="13">
                                <Run Text="Đối tác: "/><Run Text="{Binding PartnerName}"/>
                                <LineBreak/>
                                <Run Text="Giá trị hợp đồng: "/><Run Text="{Binding ContractValue, StringFormat='{}{0:N0} đ'}"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12">
                            <Run Text="Thành viên dự án ("/><Run Text="{Binding Members.Count, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ProjectMemberModel}">
                                    <Border Style="{StaticResource MemberRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34" Height="34" CornerRadius="17" Background="#3E434A"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FullName[0]}" Foreground="White"
                                                           FontWeight="Bold" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" (Bạn)" Foreground="#4C9AFF" FontSize="12" FontWeight="SemiBold"
                                                               Visibility="{Binding IsMe, Converter={StaticResource B2V}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Role, Converter={StaticResource RoleText}}"
                                                           Foreground="#8A93A0" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
