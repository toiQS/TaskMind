<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <util:NotificationTypeToTextConverter x:Key="TypeText"/>
        <util:NotificationTypeToSymbolConverter x:Key="TypeSymbol"/>
        <util:NotificationTypeToBrushConverter x:Key="TypeBrush"/>
        <util:IsReadToCardBrushConverter x:Key="CardBg"/>
        <util:IsReadToDotVisibilityConverter x:Key="UnreadDot"/>
        <util:IsReadToFontWeightConverter x:Key="ReadWeight"/>
        <util:TimeAgoConverter x:Key="TimeAgo"/>

        <Style x:Key="StatCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <Style x:Key="NotificationCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="480"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Thông báo" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Toàn bộ thông báo hệ thống gửi đến bạn (mục 5.3)"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,10,0" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary"
                                   Command="{Binding RefreshCommand}" ToolTip="Làm mới"/>
                        <ui:Button Content="Đánh dấu tất cả đã đọc" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                   Appearance="Secondary" Margin="0,0,10,0"
                                   Command="{Binding MarkAllAsReadCommand}"/>
                        <ui:Button Content="Xoá tất cả" Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary"
                                   Command="{Binding DeleteAllCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Thẻ thống kê nhanh ===== -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Tổng cộng" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding TotalCount, Mode=OneWay}" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Chưa đọc" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding UnreadCount, Mode=OneWay}" Foreground="#FF6B6B" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                </WrapPanel>

                <!-- ===== Bộ lọc ===== -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                               Command="{Binding ClearFilterCommand}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Chưa đọc"
                               Command="{Binding ToggleUnreadOnlyCommand}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Mời dự án"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.ProjectInvite}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Công việc"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.TaskAssigned}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Kiểm tra"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.TestResult}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Phê duyệt"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.ProfileApproval}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Hỗ trợ"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.Support}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tin nhắn"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.Chat}"/>
                    <ui:Button Style="{StaticResource FilterChipStyle}" Content="Hệ thống"
                               Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static models:NotificationType.System}"/>
                </WrapPanel>

                <!-- ===== Danh sách thông báo ===== -->
                <Grid Grid.Row="3">
                    <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding FilteredNotifications.Count, Converter={StaticResource ZeroCountVisible}}">
                        <ui:SymbolIcon Symbol="Alert24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                        <TextBlock Text="Không có thông báo nào phù hợp" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding FilteredNotifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NotificationItemModel}">
                                <Border Style="{StaticResource NotificationCardStyle}"
                                        Background="{Binding IsRead, Converter={StaticResource CardBg}}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.MarkAsReadCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                                Background="{Binding Type, Converter={StaticResource TypeBrush}}"
                                                Margin="0,0,14,0" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="{Binding Type, Converter={StaticResource TypeSymbol}}"
                                                           FontSize="18" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                                           FontSize="14.5"
                                                           FontWeight="{Binding IsRead, Converter={StaticResource ReadWeight}}"
                                                           TextWrapping="Wrap"/>
                                                <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                        Background="#4C9AFF" Margin="8,5,0,0"
                                                        Visibility="{Binding IsRead, Converter={StaticResource UnreadDot}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Content}" Foreground="#C7CDD6" FontSize="13"
                                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="8" Padding="7,2" Margin="0,0,10,0" Background="#3A4149">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource TypeText}}"
                                                               Foreground="#C7CDD6" FontSize="10.5"/>
                                                </Border>
                                                <TextBlock Text="{Binding CreatedDate, Converter={StaticResource TimeAgo}}"
                                                           Foreground="#5C6370" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                   Height="30" Width="30" VerticalAlignment="Top"
                                                   ToolTip="Xoá thông báo"
                                                   Command="{Binding DataContext.DeleteCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>