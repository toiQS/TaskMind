<Page x:Class="TaskMind.WPFs.Modules.Auths.Views.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Auths.Views"
      xmlns:authVM="clr-namespace:TaskMind.WPFs.Modules.Auths.ViewModels"
      mc:Ignorable="d" 
      
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">
    <Page.DataContext>
        <authVM:AuthNavigationVM/>
    </Page.DataContext>
    <Grid>
        <ContentControl x:Name="AuthPages" Content="{Binding AuthCurrentView}"/>
    </Grid>
</Page>
