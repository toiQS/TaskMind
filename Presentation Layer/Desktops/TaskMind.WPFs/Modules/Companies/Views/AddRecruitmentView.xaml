<UserControl x:Class="TaskMind.WPFs.Modules.Companies.Views.AddRecruitmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Companies.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Companies.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Companies.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="640">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>

        <!-- Tái sử dụng converter đã có ở RecruitmentConverters.cs -->
        <util:JobLevelToTextConverter x:Key="LevelText"/>
        <util:EmploymentTypeToTextConverter x:Key="TypeText"/>

        <util:DeadlineToRemainingTextConverter x:Key="DeadlineRemaining"/>

        <ObjectDataProvider x:Key="JobLevelValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:JobLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="EmploymentTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:EmploymentType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Chip kỹ năng: nền xanh nhạt + nút xoá nhỏ bên phải -->
        <Style x:Key="SkillChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E2A3A"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <!-- Panel modal trung tâm: header cố định + form cuộn được + footer hành động cố định -->
    <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="1" CornerRadius="12"
            Width="640" MaxHeight="760">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="28,24,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PersonAdd24" FontSize="20" Foreground="#4C9AFF" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Đăng tin tuyển dụng mới" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Gắn kỹ năng yêu cầu để hệ thống gợi ý ứng viên phù hợp (mục 5.1)"
                                   Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                           Command="{Binding CancelCommand}"/>
            </Grid>

            <!-- ===== Form (cuộn được) ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,8">
                <StackPanel>

                    <!-- Thông báo lỗi -->
                    <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Tên vị trí *" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox Icon="{ui:SymbolIcon Person24}"
                                PlaceholderText="VD: Backend Developer (.NET)"
                                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                Height="42" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phòng ban *" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox PlaceholderText="VD: Phòng Kỹ thuật"
                                        Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Địa điểm" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox PlaceholderText="VD: TP. Hồ Chí Minh / Remote"
                                        Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cấp bậc" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource JobLevelValues}}"
                                      SelectedItem="{Binding Level}" Height="42">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LevelText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hình thức làm việc" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource EmploymentTypeValues}}"
                                      SelectedItem="{Binding EmploymentType}" Height="42">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource TypeText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Mô tả công việc" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                PlaceholderText="Trách nhiệm chính, yêu cầu, quyền lợi..."
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,18"/>

                    <!-- ===== Kỹ năng yêu cầu (tag input) ===== -->
                    <TextBlock Text="Kỹ năng yêu cầu *" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Icon="{ui:SymbolIcon Tag24}"
                                    PlaceholderText="Nhập kỹ năng rồi nhấn Enter, VD: ASP.NET Core"
                                    Text="{Binding SkillInput, UpdateSourceTrigger=PropertyChanged}"
                                    Height="42">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddSkillCommand}"/>
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>

                        <ui:Button Grid.Column="2" Content="Thêm" Appearance="Secondary" Height="42"
                                   Command="{Binding AddSkillCommand}"/>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <ItemsControl ItemsSource="{Binding RequiredSkills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <Border Style="{StaticResource SkillChipStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Foreground="#4C9AFF" FontSize="12.5" VerticalAlignment="Center"/>
                                            <ui:Button Content="✕" Appearance="Transparent" Height="18" Width="18"
                                                       Padding="0" FontSize="10" Margin="8,0,0,0"
                                                       Foreground="#8A93A0"
                                                       Command="{Binding DataContext.RemoveSkillCommand,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- ===== Mức lương ===== -->
                    <TextBlock Text="Mức lương" Style="{StaticResource FieldLabelStyle}"/>
                    <CheckBox Content="Thoả thuận lương" Foreground="#C7CDD6"
                              IsChecked="{Binding SalaryNegotiable}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,18"
                          Visibility="{Binding SalaryNegotiable, Converter={StaticResource InverseB2V}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ui:TextBox Icon="{ui:SymbolIcon Money24}"
                                        PlaceholderText="Lương tối thiểu"
                                        Text="{Binding SalaryMin, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <ui:TextBox Icon="{ui:SymbolIcon Money24}"
                                        PlaceholderText="Lương tối đa"
                                        Text="{Binding SalaryMax, UpdateSourceTrigger=PropertyChanged}"
                                        Height="42"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Hạn nộp ===== -->
                    <TextBlock Text="Hạn nộp hồ sơ" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" SelectedDate="{Binding Deadline}" Height="42"/>
                        <TextBlock Grid.Column="2" Text="{Binding Deadline, Converter={StaticResource DeadlineRemaining}}"
                                   Foreground="#8A93A0" FontSize="12.5" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== Footer ===== -->
            <Grid Grid.Row="2" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Huỷ" Appearance="Transparent" Height="42"
                           Command="{Binding CancelCommand}"/>

                <ui:Button Grid.Column="2" Content="Lưu nháp" Icon="{ui:SymbolIcon Save24}"
                           Appearance="Secondary" Height="42" Width="130"
                           Command="{Binding SaveDraftCommand}"/>

                <ui:Button Grid.Column="4" Content="Đăng tin" Icon="{ui:SymbolIcon Send24}"
                           Appearance="Primary" Height="42" Width="140" FontWeight="SemiBold"
                           Command="{Binding PublishCommand}"/>
            </Grid>

            <!-- ===== Overlay: đang lưu ===== -->
            <Border Grid.RowSpan="3" Background="#902B3036" CornerRadius="12"
                    Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                <ui:ProgressRing IsIndeterminate="True" Width="38" Height="38"/>
            </Border>
        </Grid>
    </Border>
</UserControl>