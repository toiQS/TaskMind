<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1300"
             Style="{StaticResource Page_Style}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseB2V"/>
        <util:CountToVisibilityConverter x:Key="CountVisible"/>
        <util:ZeroCountToVisibilityConverter x:Key="ZeroCountVisible"/>

        <util:TodoStatusToTextConverter x:Key="StatusText"/>
        <util:TodoStatusToBrushConverter x:Key="StatusBrush"/>
        <util:TodoPriorityToTextConverter x:Key="PriorityText"/>
        <util:TodoPriorityToBrushConverter x:Key="PriorityBrush"/>
        <util:OverdueToBrushConverter x:Key="OverdueBrush"/>
        <util:DueDateToRemainingTextConverter x:Key="DueRemaining"/>

        <!-- Converter so khớp enum/filter dùng chung, đã có sẵn trong namespace (định nghĩa ở ProjectConverters.cs) -->
        <util:ProjectFilterActiveConverter x:Key="FilterActive"/>

        <Style x:Key="StatCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>

        <!-- Nút pill cho 2 thẻ: Việc của tôi / Tôi đã giao -->
        <Style x:Key="ScopeTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <!-- Card công việc: viền xanh khi đang được chọn, gạch ngang tiêu đề khi đã hoàn thành -->
        <Style x:Key="TodoCardStyle" TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TodoStatus.Completed}">
                    <Setter Property="Opacity" Value="0.75"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TodoTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TodoStatus.Completed}">
                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                    <Setter Property="Foreground" Value="#8A93A0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="480"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Công việc" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Danh sách công việc theo dự án, sắp xếp theo hạn hoàn thành (mục 4.7)"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,10,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Secondary"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Làm mới"/>
                        <ui:Button Content="Tạo công việc mới"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding CreateTodoCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Thẻ: Việc của tôi / Tôi đã giao ===== -->
                <Border Grid.Row="1" Background="#20242A" CornerRadius="10" Padding="4"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Icon="{ui:SymbolIcon PersonBoard24}"
                                   Command="{Binding SetScopeCommand}"
                                   CommandParameter="{x:Static models:TodoScope.AssignedToMe}">
                            <ui:Button.Content>
                                <TextBlock>
                                    <Run Text="Việc của tôi ("/><Run Text="{Binding AssignedToMeCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </ui:Button.Content>
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ScopeTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScope}" Value="{x:Static models:TodoScope.AssignedToMe}">
                                            <Setter Property="Background" Value="#4C9AFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <ui:Button Icon="{ui:SymbolIcon Send24}"
                                   Margin="4,0,0,0"
                                   Command="{Binding SetScopeCommand}"
                                   CommandParameter="{x:Static models:TodoScope.CreatedByMe}">
                            <ui:Button.Content>
                                <TextBlock>
                                    <Run Text="Tôi đã giao ("/><Run Text="{Binding CreatedByMeCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </ui:Button.Content>
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ScopeTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScope}" Value="{x:Static models:TodoScope.CreatedByMe}">
                                            <Setter Property="Background" Value="#4C9AFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- ===== Thẻ thống kê nhanh ===== -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Tổng cộng" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding TotalCount, Mode=OneWay}" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Đang thực hiện" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding InProgressCount, Mode=OneWay}" Foreground="#4C9AFF" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Hoàn thành" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding CompletedCount, Mode=OneWay}" Foreground="#3FD07A" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource StatCardStyle}" Width="190">
                        <StackPanel>
                            <TextBlock Text="Quá hạn" Foreground="#8A93A0" FontSize="12"/>
                            <TextBlock Text="{Binding OverdueCount, Mode=OneWay}" Foreground="#FF6B6B" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Card>
                </WrapPanel>

                <!-- ===== Tìm kiếm + bộ lọc trạng thái ===== -->
                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBox Grid.Row="0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Tìm theo tên công việc hoặc dự án..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Width="340" HorizontalAlignment="Left"
                                Height="40" Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Tất cả"
                                   Command="{Binding SetStatusFilterCommand}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Chưa bắt đầu"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:TodoStatus.NotStarted}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Đang thực hiện"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:TodoStatus.InProgress}"/>
                        <ui:Button Style="{StaticResource FilterChipStyle}" Content="Hoàn thành"
                                   Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static models:TodoStatus.Completed}"/>
                        <ui:Button Content="Xoá lọc" Appearance="Transparent" Height="34"
                                   Command="{Binding ClearFilterCommand}"/>
                    </WrapPanel>
                </Grid>

                <!-- ===== Master-detail: danh sách công việc (trái) + chi tiết (phải) ===== -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="320"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- Danh sách công việc -->
                    <Grid Grid.Column="0">
                        <!-- Trạng thái rỗng -->
                        <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding FilteredTodos.Count, Converter={StaticResource ZeroCountVisible}}">
                            <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                            <TextBlock Text="Không có công việc phù hợp" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredTodos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TodoItemModel}">
                                        <ui:Card Style="{StaticResource TodoCardStyle}">
                                            <ui:Card.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenDetailCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </ui:Card.InputBindings>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Nút đánh dấu hoàn thành nhanh -->
                                                <ui:Button Grid.Column="0" Appearance="Transparent" Height="30" Width="30"
                                                           Padding="0" Margin="0,0,10,0" VerticalAlignment="Top"
                                                           ToolTip="Đánh dấu hoàn thành"
                                                           Command="{Binding DataContext.MarkCompleteCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:SymbolIcon FontSize="20">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Circle24"/>
                                                                <Setter Property="Foreground" Value="#5C6370"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TodoStatus.Completed}">
                                                                        <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                                                                        <Setter Property="Foreground" Value="#3FD07A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </ui:Button>

                                                <StackPanel Grid.Column="1">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource TodoTitleStyle}"/>
                                                        <Border Grid.Column="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0"
                                                                Background="{Binding Priority, Converter={StaticResource PriorityBrush}}">
                                                            <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                                                       Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Text="{Binding ProjectName}" Foreground="#8A93A0" FontSize="12"
                                                               Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Border CornerRadius="8" Padding="7,2" Margin="0,0,8,0"
                                                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                                           Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Foreground="{Binding IsOverdue, Converter={StaticResource OverdueBrush}}"
                                                                       FontSize="11.5" VerticalAlignment="Center">
                                                                <Run Text="{Binding DueDate, Converter={StaticResource DueRemaining}}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Comment24" FontSize="12" Foreground="#8A93A0" Margin="0,0,4,0"
                                                                           Visibility="{Binding CommentCount, Converter={StaticResource CountVisible}}"/>
                                                            <TextBlock Text="{Binding CommentCount, Mode=OneWay}" Foreground="#8A93A0" FontSize="11.5"
                                                                       Visibility="{Binding CommentCount, Converter={StaticResource CountVisible}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Chi tiết công việc -->
                    <Border Grid.Column="2" Background="#20242A" CornerRadius="10" Padding="24"
                            Visibility="{Binding HasSelectedTodo, Converter={StaticResource B2V}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedTodo}">

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White"
                                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" Height="32" Width="32" Margin="0,0,4,0"
                                                   ToolTip="Chỉnh sửa công việc"
                                                   Visibility="{Binding CanEdit, Converter={StaticResource B2V}}"
                                                   Command="{Binding DataContext.EditTodoCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Height="32" Width="32"
                                                   Command="{Binding DataContext.CloseDetailCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                                    <Border CornerRadius="10" Padding="9,4" Margin="0,0,8,0"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border CornerRadius="10" Padding="9,4"
                                            Background="{Binding Priority, Converter={StaticResource PriorityBrush}}">
                                        <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Mô tả" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="14"
                                           TextWrapping="Wrap" Margin="0,0,0,22"/>

                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Dự án" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ProjectName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Được gán cho" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding AssigneeName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Người giao việc" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding AssignedByName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Hạn hoàn thành" Foreground="#8A93A0" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Foreground="{Binding IsOverdue, Converter={StaticResource OverdueBrush}}" FontSize="13.5" FontWeight="SemiBold">
                                            <Run Text="{Binding DueDate, StringFormat='dd/MM/yyyy', TargetNullValue='Không có hạn'}"/>
                                            <Run Text=" ("/><Run Text="{Binding DueDate, Converter={StaticResource DueRemaining}}"/><Run Text=")"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,0,0,22">
                                    <Run Text="Tạo lúc: "/><Run Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy'}"/>
                                    <Run Text=" · Hoàn thành lúc: "/><Run Text="{Binding CompletedDate, StringFormat='dd/MM/yyyy', TargetNullValue='Chưa hoàn thành'}"/>
                                </TextBlock>

                                <ui:Button Content="Đánh dấu hoàn thành" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Success"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                           Height="42" FontWeight="SemiBold" Margin="0,0,0,26"
                                           Visibility="{Binding CanEdit, Converter={StaticResource B2V}}"
                                           Command="{Binding DataContext.MarkCompleteCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"/>

                                <!-- Lịch sử chỉnh sửa -->
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12">
                                    <Run Text="Lịch sử chỉnh sửa ("/><Run Text="{Binding LogCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Logs}" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:TodoLogModel}">
                                            <Border Background="#282D33" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ChangedBy}" Foreground="#4C9AFF"
                                                                   FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ChangedDate, StringFormat='dd/MM HH:mm'}"
                                                                   Foreground="#8A93A0" FontSize="11"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="13"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Chưa có lịch sử chỉnh sửa" Foreground="#8A93A0" FontSize="12.5" Margin="0,0,0,20"
                                           Visibility="{Binding LogCount, Converter={StaticResource ZeroCountVisible}}"/>

                                <!-- Bình luận -->
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12">
                                    <Run Text="Bình luận ("/><Run Text="{Binding CommentCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Comments}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:TodoCommentModel}">
                                            <Border Background="#282D33" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Author}" Foreground="#4C9AFF"
                                                                   FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CreatedDate, StringFormat='dd/MM HH:mm'}"
                                                                   Foreground="#8A93A0" FontSize="11"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Content}" Foreground="#DBDBDB" FontSize="13"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Ô nhập bình luận -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0"
                                                PlaceholderText="Nhập bình luận..."
                                                Text="{Binding DataContext.CommentInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                Height="44"/>

                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                               Height="44" Width="50"
                                               Command="{Binding DataContext.AddCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Trạng thái rỗng khi chưa chọn công việc -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedTodo, Converter={StaticResource InverseB2V}}">
                        <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="42" Foreground="#3A4149" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một công việc để xem chi tiết" Foreground="#8A93A0" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== Overlay: loading ===== -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>

        <!-- ===== Overlay: tạo/chỉnh sửa công việc ===== -->
        <Border Background="#B0181B20"
                Visibility="{Binding IsAddingTodo, Converter={StaticResource B2V}}">
