<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:FilterAppearanceConverter x:Key="FilterAppearance"/>
        <util:UserStatusToBrushConverter x:Key="StatusBrush"/>
        <util:UserStatusToTextConverter x:Key="StatusText"/>
        <util:UserTypeToTextConverter x:Key="TypeText"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="FilterChip" TargetType="ui:Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="UserRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="AvatarCircle" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="Background" Value="#3A4149"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="TypeBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#3A4149"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusBrush}}"/>
        </Style>

        <!-- Nút Khoá/Mở khoá đổi nhãn theo trạng thái, ẩn khi đã Banned -->
        <Style x:Key="LockBtnStyle" TargetType="ui:Button">
            <Setter Property="Content" Value="Khoá"/>
            <Setter Property="Appearance" Value="Secondary"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Locked">
                    <Setter Property="Content" Value="Mở khoá"/>
                    <Setter Property="Appearance" Value="Primary"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Banned">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BanBtnStyle" TargetType="ui:Button">
            <Setter Property="Content" Value="Cấm"/>
            <Setter Property="Appearance" Value="Danger"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Banned">
                    <Setter Property="Content" Value="Gỡ cấm"/>
                    <Setter Property="Appearance" Value="Secondary"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quản lý người dùng" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Sinh viên, người tìm việc, người đóng góp mã nguồn mở" Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <ui:TextBox Grid.Column="1"
                            Width="260"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Tìm theo tên hoặc email..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"/>

                <ui:Button Grid.Column="2"
                           Content="Làm mới"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshCommand}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Filter theo trạng thái -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <ui:Button Style="{StaticResource FilterChip}" Content="Tất cả"
                           Command="{Binding FilterStatusCommand}" CommandParameter="All"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=All}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Hoạt động"
                           Command="{Binding FilterStatusCommand}" CommandParameter="Active"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Active}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Tạm khoá"
                           Command="{Binding FilterStatusCommand}" CommandParameter="Locked"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Locked}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Bị cấm"
                           Command="{Binding FilterStatusCommand}" CommandParameter="Banned"
                           Appearance="{Binding StatusFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Banned}"/>
            </StackPanel>

            <!-- Filter theo loại người dùng -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button Style="{StaticResource FilterChip}" Content="Tất cả loại"
                           Command="{Binding FilterTypeCommand}" CommandParameter="All"
                           Appearance="{Binding TypeFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=All}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Sinh viên"
                           Command="{Binding FilterTypeCommand}" CommandParameter="Student"
                           Appearance="{Binding TypeFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Student}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="Người tìm việc"
                           Command="{Binding FilterTypeCommand}" CommandParameter="JobSeeker"
                           Appearance="{Binding TypeFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=JobSeeker}"/>
                <ui:Button Style="{StaticResource FilterChip}" Content="OSS Contributor"
                           Command="{Binding FilterTypeCommand}" CommandParameter="OssContributor"
                           Appearance="{Binding TypeFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=OssContributor}"/>
            </StackPanel>

            <!-- Danh sách người dùng -->
            <Border Grid.Row="3" Style="{StaticResource SectionCard}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding UsersView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UserRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar chữ cái đầu -->
                                        <Border Grid.Column="0" Style="{StaticResource AvatarCircle}">
                                            <TextBlock Text="{Binding FullName[0]}"
                                                       Foreground="White" FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Thông tin -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Email}" Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Loại người dùng -->
                                        <Border Grid.Column="2" Style="{StaticResource TypeBadge}" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TypeText}}"
                                                       Foreground="#DBDBDB" FontSize="11"/>
                                        </Border>

                                        <!-- Thống kê nhanh -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SkillCount}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Kỹ năng" Foreground="#8A93A0" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectCount}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Dự án" Foreground="#8A93A0" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Badge trạng thái -->
                                        <Border Grid.Column="4" Style="{StaticResource StatusBadge}" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                       Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Hành động -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Style="{StaticResource LockBtnStyle}" Height="32" Width="88" Margin="0,0,8,0"
                                                       Command="{Binding DataContext.ToggleLockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Style="{StaticResource BanBtnStyle}" Height="32" Width="88"
                                                       Command="{Binding DataContext.ToggleBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Overlay loading -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>