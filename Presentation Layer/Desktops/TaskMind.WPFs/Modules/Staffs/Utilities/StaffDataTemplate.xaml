<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:staffVM="clr-namespace:TaskMind.WPFs.Modules.Staffs.ViewModels"
                    xmlns:staffView="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views">
    
    <DataTemplate DataType="{x:Type staffVM:StaffNavigationVM}">
        <staffView:StaffPage/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type staffVM:ProfileVM}">
        <staffView:ProfileView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type staffVM:ProjectVM}">
        <staffView:ProjectView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type staffVM:TodoVM}">
        <staffView:TodoView/>
    </DataTemplate>
    
    
</ResourceDictionary>