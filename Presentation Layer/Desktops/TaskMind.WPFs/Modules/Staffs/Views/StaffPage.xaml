<Page x:Class="TaskMind.WPFs.Modules.Staffs.Views.StaffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="StaffPage">

    <Grid Background="#282D33">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ===================== CỘT TRÁI: SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="#20242A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo -->
                    <RowDefinition Height="*"/>
                    <!-- Menu: chiếm phần co giãn, tự cuộn khi tràn -->
                    <RowDefinition Height="Auto"/>
                    <!-- Đường phân cách -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nút thoát hệ thống -->
                </Grid.RowDefinitions>

                <!-- Logo + tên hệ thống -->
                <Grid Grid.Row="0" Height="76" Margin="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Images/logo.png" Width="36" Height="36"/>
                        <TextBlock Text="TaskMind" FontSize="20" FontWeight="SemiBold"
                            VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Thanh menu (cuộn được) ===== -->
                <ScrollViewer Grid.Row="1"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       Padding="0,0,10,0"
                       Margin="0,10,0,0">
                    <StackPanel>

                        <!--thanh menu-->
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Đường phân cách ===== -->
                <Border Grid.Row="2" Height="1" Background="#3A4149" Margin="20,8,20,8"/>

                <!-- ===== Nút thoát khỏi hệ thống ===== -->
                

            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <!--Nút thông báo-->
            </Grid>
            <ContentControl Grid.Row="1"
                 Content="{Binding StaffCurrentView}"
                 x:Name="StaffPages"/>
        </Grid>
    </Grid>
</Page>
