<UserControl x:Class="TaskMind.WPFs.Modules.Staffs.Views.AddTodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Staffs.Views"
             xmlns:util="clr-namespace:TaskMind.WPFs.Modules.Staffs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Staffs.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="620">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Tái sử dụng converter đã có ở TodoConverters.cs -->
        <util:TodoPriorityToTextConverter x:Key="PriorityText"/>

        <ObjectDataProvider x:Key="TodoPriorityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TodoPriority"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <!-- Panel modal trung tâm: header cố định + form cuộn được + footer hành động cố định -->
    <Border Background="#282D33" BorderBrush="#3A4149" BorderThickness="1" CornerRadius="12"
            Width="620" MaxHeight="760">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="28,24,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="20" Foreground="#4C9AFF" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Foreground="White" FontSize="19" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Tạo công việc mới"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="Chỉnh sửa công việc"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Gán công việc cho thành viên trong dự án (mục 4.7)"
                                   Foreground="#8A93A0" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                           Command="{Binding CancelCommand}"/>
            </Grid>

            <!-- ===== Form (cuộn được) ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,8">
                <StackPanel>

                    <!-- Thông báo lỗi -->
                    <Border Background="#3A2020" CornerRadius="8" Padding="12,10" Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Tên công việc *" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox Icon="{ui:SymbolIcon TaskListSquareLtr24}"
                                PlaceholderText="VD: Thiết kế API chấm công"
                                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                Height="42" Margin="0,0,0,16"/>

                    <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}"/>
                    <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                PlaceholderText="Chi tiết công việc cần thực hiện..."
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,18"/>

                    <TextBlock Text="Dự án *" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Height="42" Margin="0,0,0,16"
                              ItemsSource="{Binding ProjectOptions}"
                              SelectedItem="{Binding SelectedProject}"
                              DisplayMemberPath="ProjectName"/>

                    <TextBlock Text="Giao cho thành viên *" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Height="42" Margin="0,0,0,16"
                              ItemsSource="{Binding AvailableAssignees}"
                              SelectedItem="{Binding AssigneeName}"/>
                    <TextBlock Text="Chỉ hiển thị thành viên thuộc dự án đã chọn ở trên."
                               Foreground="#5C6370" FontSize="11.5" Margin="0,-10,0,18" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mức độ ưu tiên" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Height="42"
                                      ItemsSource="{Binding Source={StaticResource TodoPriorityValues}}"
                                      SelectedItem="{Binding Priority}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PriorityText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hạn hoàn thành" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding DueDate}" Height="42"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== Footer ===== -->
            <Grid Grid.Row="2" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Huỷ" Appearance="Transparent" Height="42"
                           Command="{Binding CancelCommand}"/>

                <ui:Button Grid.Column="2" Content="Lưu công việc" Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary" Height="42" Width="160" FontWeight="SemiBold"
                           Command="{Binding SaveCommand}"/>
            </Grid>

            <!-- ===== Overlay: đang lưu ===== -->
            <Border Grid.RowSpan="3" Background="#902B3036" CornerRadius="12"
                    Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                <ui:ProgressRing IsIndeterminate="True" Width="38" Height="38"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
