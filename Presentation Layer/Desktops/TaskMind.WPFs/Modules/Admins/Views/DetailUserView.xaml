<UserControl x:Class="TaskMind.WPFs.Modules.Admins.Views.DetailUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskMind.WPFs.Modules.Admins.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:util="clr-namespace:TaskMind.WPFs.Utilities"
             xmlns:models="clr-namespace:TaskMind.WPFs.Modules.Admins.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <util:UserStatusToBrushConverter x:Key="StatusBrush"/>
        <util:UserStatusToTextConverter x:Key="StatusText"/>
        <util:UserTypeToTextConverter x:Key="TypeText"/>
        <util:SkillCategoryToTextConverter x:Key="CategoryText"/>
        <util:SkillLevelToTextConverter x:Key="LevelText"/>
        <util:SkillLevelToBrushConverter x:Key="LevelBrush"/>
        <util:ProjectSourceToTextConverter x:Key="SourceText"/>
        <util:IsOngoingToTextConverter x:Key="OngoingText"/>
        <util:IsOngoingToBrushConverter x:Key="OngoingBrush"/>
        <util:ReportStatusToBrushConverter x:Key="ReportStatusBrush"/>
        <util:ReportStatusToTextConverter x:Key="ReportStatusText"/>
        <util:PriorityToBrushConverter x:Key="PriorityBrush"/>
        <util:ViolationTypeToTextConverter x:Key="ViolationText"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2B3036"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background" Value="#20242A"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7CDD6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBDBDB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Chip kỹ năng -->
        <Style x:Key="SkillChip" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="LevelDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Fill" Value="{Binding Level, Converter={StaticResource LevelBrush}}"/>
        </Style>

        <!-- Dòng lịch sử dự án -->
        <Style x:Key="ProjectRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ReportRow" TargetType="Border">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PriorityBar" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{Binding Priority, Converter={StaticResource PriorityBrush}}"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- Timeline dot cho audit log -->
        <Style x:Key="TimelineDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#4C9AFF"/>
            <Setter Property="Margin" Value="0,4,12,0"/>
        </Style>

        <!-- Nút Khoá/Mở khoá + Cấm/Gỡ cấm, tái sử dụng logic giống UserView -->
        <Style x:Key="LockBtnStyle" TargetType="ui:Button">
            <Setter Property="Content" Value="Khoá"/>
            <Setter Property="Appearance" Value="Secondary"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Detail.User.Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Locked">
                    <Setter Property="Content" Value="Mở khoá"/>
                    <Setter Property="Appearance" Value="Primary"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.Detail.User.Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Banned">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BanBtnStyle" TargetType="ui:Button">
            <Setter Property="Content" Value="Cấm"/>
            <Setter Property="Appearance" Value="Danger"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Detail.User.Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Banned">
                    <Setter Property="Content" Value="Gỡ cấm"/>
                    <Setter Property="Appearance" Value="Secondary"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header: Back + tên user + trạng thái + hành động ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowLeft24}"
                               Width="40" Height="40"
                               Margin="0,0,14,0"
                               Command="{Binding BackCommand}"/>

                    <Border Grid.Column="1" Width="52" Height="52" CornerRadius="26"
                            Background="#3A4149" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Detail.User.FullName[0]}"
                                   Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Detail.User.FullName}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                            <Border Style="{StaticResource StatusBadge}" Margin="12,0,0,0"
                                    Background="{Binding Detail.User.Status, Converter={StaticResource StatusBrush}}">
                                <TextBlock Text="{Binding Detail.User.Status, Converter={StaticResource StatusText}}"
                                           Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0">
                            <Run Text="{Binding Detail.User.Email, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Detail.User.Type, Converter={StaticResource TypeText}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <ui:Button Grid.Column="3" Style="{StaticResource LockBtnStyle}" Height="38" Width="100" Margin="0,0,10,0"
                               Command="{Binding ToggleLockCommand}"/>

                    <ui:Button Grid.Column="4" Style="{StaticResource BanBtnStyle}" Height="38" Width="100" Margin="0,0,12,0"
                               Command="{Binding ToggleBanCommand}"/>

                    <ui:Button Grid.Column="5"
                               Content="Làm mới"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshCommand}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Stat cards ===== -->
                <ItemsControl Grid.Row="1" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>

                        <Border Style="{StaticResource StatCard}" Width="180">
                            <StackPanel>
                                <TextBlock Text="Kỹ năng" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.User.SkillCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="180">
                            <StackPanel>
                                <TextBlock Text="Dự án đã tham gia" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.User.ProjectCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="220">
                            <StackPanel>
                                <TextBlock Text="Ngày tham gia hệ thống" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.User.JoinedDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource StatValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Width="220">
                            <StackPanel>
                                <TextBlock Text="Hoạt động gần nhất" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Detail.User.LastActiveDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource StatValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>

                    </ItemsControl.Items>
                </ItemsControl>

                <!-- ===== Hồ sơ kỹ năng cá nhân ===== -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Hồ sơ kỹ năng cá nhân" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding Detail.Skills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:UserSkillItem}">
                                    <Border Style="{StaticResource SkillChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource LevelDot}"/>
                                            <TextBlock Text="{Binding SkillName}" Foreground="#DBDBDB" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Level, Converter={StaticResource LevelText}}"
                                                       Foreground="#8A93A0" FontSize="11" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                            <Border Background="#3A4149" CornerRadius="8" Padding="6,2">
                                                <TextBlock Text="{Binding EndorsementCount, StringFormat='{}{0} xác nhận'}"
                                                           Foreground="#8A93A0" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Lịch sử tham gia dự án ===== -->
                <Border Grid.Row="3" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Lịch sử tham gia dự án" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding Detail.ProjectHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:UserProjectHistoryItem}">
                                    <Border Style="{StaticResource ProjectRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ProjectName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="#8A93A0" FontSize="12" Margin="0,3,0,0">
                                                    <Run Text="{Binding ProjectRole, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding ProjectSource, Converter={StaticResource SourceText}, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding StartDate, StringFormat='dd/MM/yyyy', Mode=OneWay}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding EndDate, StringFormat='dd/MM/yyyy', Mode=OneWay, TargetNullValue=Hiện tại}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="1" Style="{StaticResource StatusBadge}" VerticalAlignment="Top"
                                                    Background="{Binding IsOngoing, Converter={StaticResource OngoingBrush}}">
                                                <TextBlock Text="{Binding IsOngoing, Converter={StaticResource OngoingText}}"
                                                           Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Báo cáo vi phạm liên quan ===== -->
                <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Báo cáo vi phạm liên quan" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding Detail.Reports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ReportModel}">
                                    <Border Style="{StaticResource ReportRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource PriorityBar}" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Foreground="#8A93A0" FontSize="11">
                                                    <Run Text="{Binding ViolationType, Converter={StaticResource ViolationText}, Mode=OneWay}"/>
                                                    <Run Text=" · Người báo cáo: "/>
                                                    <Run Text="{Binding ReporterName, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy', Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" Foreground="#DBDBDB" FontSize="13"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource StatusBadge}" VerticalAlignment="Top"
                                                    Background="{Binding Status, Converter={StaticResource ReportStatusBrush}}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource ReportStatusText}}"
                                                           Foreground="#20242A" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Chưa có báo cáo vi phạm nào liên quan đến người dùng này."
                                   Foreground="#8A93A0" FontSize="13" Margin="0,4,0,0"
                                   Visibility="{Binding Detail.Reports.Count, Converter={StaticResource B2V}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>

                <!-- ===== Nhật ký hoạt động tài khoản (Audit Log) ===== -->
                <Border Grid.Row="4" Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Nhật ký hoạt động tài khoản" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding Detail.AuditLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AuditLogEntryModel}">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Style="{StaticResource TimelineDot}"/>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Action}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#8A93A0" FontSize="11"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Foreground="#8A93A0" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Foreground="#8A93A0" FontSize="10" Margin="0,2,0,0">
                                                <Run Text="Thực hiện bởi: "/><Run Text="{Binding PerformedBy}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Overlay loading -->
        <Border Background="#902B3036"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
        </Border>
    </Grid>
</UserControl>